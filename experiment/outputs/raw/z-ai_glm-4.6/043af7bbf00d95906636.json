u7684\u5408\u5e76\u75c7\u3002\n    *   **\u635f\u4f24\u673a\u5236\uff1a**\u4ece\u68af\u5b50\u4e0a\u6454\u4e0b\u3002\u9ad8\u80fd\u91cf\u635f\u4f24\u3002\n    *   **\u8bca\u65ad\uff1a**\u95ed\u5408\u6027\u80a1\u9aa8\u5e72\u4e2d\u6bb5\u9aa8\u6298\u3002\u8fd9\u662f\u4e00\u79cd*\u975e\u5e38*\u75bc\u75db\u7684\u635f\u4f24\u3002\u80a1\u9aa8\u662f\u4eba\u4f53\u6700\u5927\u3001\u6700\u5f3a\u7684\u9aa8\u9abc\u3002\u5c06\u5176\u6298\u65ad\u4f1a\u9020\u6210\u5267\u70c8\u75bc\u75db\u3002\n    *   **\u4e34\u5e8a\u4f53\u5f81\uff1a**\n        *   \u201c\u53f3\u5927\u817f\u53d8\u5f62\u548c\u80bf\u80c0\u201d\uff1a\u5178\u578b\u7684\u9aa8\u6298\u4f53\u5f81\u3002\n        *   \u201c\u62a4\u4f4f\u817f\u90e8\uff0c\u79fb\u52a8\u65f6\u547b\u541f\u201d\uff1a\u8fd9\u4e9b\u662f\u4e25\u91cd\u75bc\u75db\u7684\u5178\u578b\u975e\u8bed\u8a00\u7ebf\u7d22\u3002\u60a3\u8005\u6b63\u5728\u4e3b\u52a8\u5c1d\u8bd5\u56fa\u5b9a\u80a2\u4f53\uff08\u62a4\u4f4f\uff09\uff0c\u5e76\u4e14\u5728\u4efb\u4f55\u79fb\u52a8\u65f6\u90fd\u4f1a\u8868\u73b0\u51fa\u75bc\u75db\u7684\u8ff9\u8c61\uff08\u547b\u541f\uff09\u3002\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u5f3a\u70c8\u7684\u6307\u6807\u3002\n    *   **\u751f\u547d\u4f53\u5f81\uff1a**\n        *   HR 112\uff08\u5fc3\u52a8\u8fc7\u901f\uff09\uff1a\u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u7684\u53d1\u73b0\u3002\u6b63\u5e38\u5fc3\u7387\u7ea6\u4e3a60-100\u6b21/\u5206\u3002112\u6b21/\u5206\u7684\u5fc3\u52a8\u8fc7\u901f\u901a\u5e38\u662f*\u75bc\u75db*\u5f15\u8d77\u7684\u751f\u7406\u5e94\u6fc0\u53cd\u5e94\uff0c\u5c24\u5176\u662f\u5728\u5b58\u5728\u8fd9\u79cd\u4e25\u91cd\u635f\u4f24\u7684\u60c5\u51b5\u4e0b\u3002\u8fd9\u4e5f\u53ef\u80fd\u662f\u5931\u8840\u6027\u4f11\u514b\u7684\u524d\u5146\uff0c\u4f46\u8840\u538b\uff08136/84\uff09\u76ee\u524d\u5c1a\u53ef\uff0c\u56e0\u6b64\u75bc\u75db\u662f\u6700\u53ef\u80fd\u7684\u9a71\u52a8\u56e0\u7d20\u3002\n        *   BP 136/84\uff1a\u8840\u538b\u6b63\u5e38\u6216\u7565\u9ad8\uff0c\u8868\u660e\u76ee\u524d\u8840\u6db2\u52a8\u529b\u5b66\u7a33\u5b9a\u3002\u8fd9\u6682\u65f6\u6392\u9664\u4e86\u4f4e\u8840\u538b\u6027\u4f11\u514b\uff0c\u5e76\u5c06\u5fc3\u52a8\u8fc7\u901f\u4e3b\u8981\u5f52\u56e0\u4e8e\u75bc\u75db\u3002\n    *   **\u8fc7\u654f\u53f2\uff1a**\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\u3002\u8fd9\u5f88\u597d\uff0c\u610f\u5473\u7740\u6211\u5728\u9009\u62e9\u9547\u75db\u836f\u65f6\u6ca1\u6709\u9650\u5236\u3002\n\n3.  **\u7efc\u5408\u4e0e\u51b3\u7b56\u5236\u5b9a\uff08\u201c\u6025\u8bca\u533b\u751f\u601d\u7ef4\u201d\uff09\uff1a**\n\n    *   **`pain_severity`\uff1a**\n        *   \u80a1\u9aa8\u9aa8\u6298\u662f\u51fa\u4e86\u540d\u7684\u75bc\u75db\u3002\u8fd9\u88ab\u8ba4\u4e3a\u662f\u533b\u5b66\u4e0a\u53ef\u80fd\u9047\u5230\u7684\u6700\u75bc\u75db\u7684\u635f\u4f24\u4e4b\u4e00\u3002\n        *   \u60a3\u8005\u7684\u4f53\u5f81\uff08\u62a4\u4f4f\u3001\u547b\u541f\uff09\u8868\u660e\u75bc\u75db\u5267\u70c8\u3002\n        *   \u5fc3\u52a8\u8fc7\u901f\uff08HR 112\uff09\u662f\u75bc\u75db\u7684\u751f\u7406\u6307\u6807\u3002\n        *   \u57280-10\u5206\u91cf\u8868\u4e0a\uff0c\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u4e00\u4e2a\u201c5\u201d\u6216\u201c6\u201d\u3002\u8fd9\u662f\u4e25\u91cd\u7684\u75bc\u75db\u3002\u4e00\u4e2a8\u30019\u621610\u7684\u8bc4\u5206\u662f\u5408\u9002\u7684\u3002\u6211\u5c06\u9009\u62e99\u6765\u53cd\u6620\u5176\u4e25\u91cd\u6027\u3002\u8fd9\u662f\u4e00\u4e2a\u9ad8\u8bc4\u5206\uff0c\u4f46\u8003\u8651\u5230\u635f\u4f24\uff0c\u8fd9\u662f\u5408\u7406\u7684\u3002\u5b83\u4e0d\u662f10/10\uff0c\u56e0\u4e3a\u60a3\u8005\u795e\u5fd7\u6e05\u9192\uff0c\u5e76\u4e14\u80fd\u591f\u6c9f\u901a\uff08\u901a\u8fc7\u547b\u541f\uff09\uff0c\u800c\u4e0d\u662f\u5728\u5267\u75db\u4e2d\u5b8c\u5168\u65e0\u6cd5\u52a8\u5f39\u6216\u610f\u8bc6\u4e0d\u6e05\u3002\u6240\u4ee5\uff0c9\u5206\u611f\u89c9\u5f88\u5408\u9002\u3002\n\n    *   **`analgesic`\uff1a**\n        *   **'none'\uff1f**\u7edd\u5bf9\u4e0d\u884c\u3002\u8fd9\u663e\u7136\u662f\u4e0d\u4eba\u9053\u4e14\u4e0d\u6070\u5f53\u7684\u533b\u7597\u5904\u7406\u3002\u60a3\u8005\u6b63\u5904\u4e8e\u660e\u663e\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u4e2d\u3002\n        *   **'non-opioid'\uff08\u5982\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u3001\u5e03\u6d1b\u82ac\u3001\u916e\u54af\u9178\uff09\uff1f**\u867d\u7136\u975e\u753e\u4f53\u6297\u708e\u836f\uff08NSAIDs\uff09\u5982\u916e\u54af\u9178\u662f\u9aa8\u6298\u75bc\u75db\u7ba1\u7406\u65b9\u6848\u4e2d\u6709\u7528\u7684\u4e00\u90e8\u5206\uff0c\u4f46\u5b83\u4eec\u5355\u72ec\u4f7f\u7528\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u7684\u6025\u6027\u3001\u5267\u70c8\u75bc\u75db\u662f*\u4e0d\u591f\u7684*\u3002\u5b83\u4eec\u53ef\u4ee5\u4f5c\u4e3a\u8f85\u52a9\u7528\u836f\uff0c\u4f46\u4e0d\u80fd\u4f5c\u4e3a\u4e3b\u8981\u836f\u7269\u3002\n        *   **'weak-opioid'\uff08\u5982\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff1f**\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u8fd9\u4e9b\u540c\u6837\u662f\u4e0d\u591f\u7684\u3002\u80a1\u9aa8\u9aa8\u6298\u7684\u75bc\u75db\u5267\u70c8\u4e14\u6301\u7eed\uff0c\u9700\u8981\u66f4\u5f3a\u6548\u7684\u6cbb\u7597\u3002\n        *   **'strong-opioid'\uff08\u5982\u5417\u5561\u3001\u82ac\u592a\u5c3c\u3001\u6c22\u5417\u5561\u916e\uff09\uff1f**\u8fd9\u662f\u6b63\u786e\u7684\u9009\u62e9\u3002\u6025\u8bca\u79d1\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u8fd9\u7c7b\u4e25\u91cd\u75bc\u75db\u7684\u6807\u51c6\u6cbb\u7597\u65b9\u6848\u662f\u9759\u8109\u6ce8\u5c04\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\u8fd9\u662f\u552f\u4e00\u80fd\u5145\u5206\u63a7\u5236\u8be5\u60a3\u8005\u75bc\u75db\u7684\u836f\u7269\u7c7b\u522b\u3002\u6211\u4eec\u9700\u8981\u5feb\u901f\u6709\u6548\u5730\u63a7\u5236\u75bc\u75db\uff0c\u8fd9\u4e0d\u4ec5\u662f\u4e3a\u4e86\u60a3\u8005\u7684\u8212\u9002\uff0c\u4e5f\u662f\u4e3a\u4e86\u5141\u8bb8\u68c0\u67e5\uff08\u4f8b\u5982\uff0c\u5728\u4e3a\u624b\u672f\u505a\u51c6\u5907\u65f6\u66f4\u5f7b\u5e95\u5730\u68c0\u67e5\u817f\u90e8\uff09\u548c\u64cd\u4f5c\uff08\u4f8b\u5982\uff0c\u4e0a\u5939\u677f\uff09\u3002\n\n    *   **`rationale`\uff1a**\n        *   \u6211\u9700\u8981\u5c06\u75bc\u75db\u8bc4\u5206\u548c\u9547\u75db\u836f\u7684\u9009\u62e9\u7528\u4e00\u4e2a\u5355\u4e00\u53e5\u5b50\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u5173\u952e\u8981\u7d20\u662f\uff1a\u80a1\u9aa8\u9aa8\u6298\u3001\u5267\u70c8\u75bc\u75db\u3001\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\n        *   \u8d77\u8349\u53e5\u5b50\uff1a\n            *   \u201c\u80a1\u9aa8\u9aa8\u6298\u975e\u5e38\u75bc\u75db\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\u201d\uff08\u4e0d\u9519\uff0c\u4f46\u6709\u70b9\u7b80\u5355\uff09\u3002\n            *   \u201c\u80a1\u9aa8\u9aa8\u6298\u5f15\u8d77\u7684\u5267\u70c8\u75bc\u75db\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u63a7\u5236\u3002\u201d\uff08\u66f4\u597d\uff0c\u66f4\u4e13\u4e1a\u7684\u8bed\u8a00\uff09\u3002\n            *   \u201c\u9274\u4e8e\u80a1\u9aa8\u9aa8\u6298\u7684\u4e25\u91cd\u6027\u4ee5\u53ca\u60a3\u8005\u7684\u75bc\u75db\u4f53\u5f81\uff08\u5fc3\u52a8\u8fc7\u901f\u3001\u547b\u541f\uff09\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\u201d\uff08\u8fd9\u4e2a\u975e\u5e38\u597d\uff0c\u56e0\u4e3a\u5b83\u6574\u5408\u4e86\u75c5\u4f8b\u4e2d\u7684\u5177\u4f53\u53d1\u73b0\uff09\u3002\n            *   \u6211\u4eec\u6765\u5b8c\u5584\u4e00\u4e0b\u3002\u6838\u5fc3\u903b\u8f91\u662f\uff1a\u80a1\u9aa8\u9aa8\u6298 = \u5267\u70c8\u75bc\u75db\uff0c\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\n            *   \u201c\u80a1\u9aa8\u9aa8\u6298\u5c5e\u4e8e\u4e25\u91cd\u75bc\u75db\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u63a7\u5236\u3002\u201d\u8fd9\u5f88\u7b80\u6d01\u3001\u51c6\u786e\uff0c\u5e76\u76f4\u63a5\u5c06\u8bca\u65ad\u4e0e\u6cbb\u7597\u9009\u62e9\u8054\u7cfb\u8d77\u6765\u3002\u5b83\u6db5\u76d6\u4e86\u6240\u6709\u8981\u70b9\u3002\n\n4.  **\u6700\u7ec8\u7ec4\u88c5\u6210JSON\uff1a**\n    *   `pain_severity`\uff1a9\n    *   `analgesic`\uff1a\u201cstrong-opioid\u201d\n    *   `rationale`\uff1a\u201c\u80a1\u9aa8\u9aa8\u6298\u5c5e\u4e8e\u4e25\u91cd\u75bc\u75db\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u63a7\u5236\u3002\u201d\n\n5.  **\u590d\u6838\uff1a**\u8fd9\u662f\u5426\u6ee1\u8db3\u4e86\u7528\u6237\u7684\u6240\u6709\u8981\u6c42\uff1f\n    *   \u6211\u662f\u5426\u626e\u6f14\u4e86\u6025\u8bca\u533b\u751f\u7684\u89d2\u8272\uff1f\u662f\u7684\uff0c\u9009\u62e9\u53cd\u6620\u4e86\u6807\u51c6\u7684\u6025\u8bca\u5b9e\u8df5\u3002\n    *   \u6211\u662f\u5426\u9605\u8bfb\u4e86\u75c5\u4f8b\uff1f\u662f\u7684\u3002\n    *   \u6211\u662f\u5426*\u53ea*\u56de\u7b54\u4e86JSON\uff1f\u662f\u7684\uff0c\u6700\u7ec8\u8f93\u51fa\u5c06\u53ea\u6709JSON\u5bf9\u8c61\u3002\n    *   `pain_severity`\u662f0-10\u7684\u6574\u6570\u5417\uff1f\u662f\u7684\uff0c9\u3002\n    *   `analgesic`\u662f\u6307\u5b9a\u7684\u9009\u9879\u4e4b\u4e00\u5417\uff1f\u662f\u7684\uff0c\u201cstrong-opioid\u201d\u3002\n    *   `rationale`\u662f\u5355\u4e00\u53e5\u5b50\u5417\uff1f\u662f\u7684\u3002\n\n\u8fd9\u4e2a\u8ba1\u5212\u5f88\u53ef\u9760\u3002\u6211\u73b0\u5728\u5c06\u751f\u6210\u6700\u7ec8\u8f93\u51fa\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u7528\u6237\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u6025\u8bca\u79d1\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u50cf\u4e00\u4e2a\u5728\u7e41\u5fd9\u3001\u9ad8\u538b\u73af\u5883\u4e2d\u8bc4\u4f30\u548c\u6cbb\u7597\u6025\u6027\u635f\u4f24\u7684\u533b\u751f\u4e00\u6837\u601d\u8003\u3002\u6211\u7684\u9996\u8981\u76ee\u6807\u662f\u7a33\u5b9a\u60a3\u8005\u3001\u63a7\u5236\u75bc\u75db\uff0c\u5e76\u4e3a\u786e\u5b9a\u6027\u6cbb\u7597\u505a\u51c6\u5907\u3002\n    *   **\u4efb\u52a1\uff1a**\u9605\u8bfb\u4e00\u4e2a\u7b80\u77ed\u7684\u75c5\u4f8b\uff0c\u5e76\u4ee5\u7279\u5b9a\u7684JSON\u683c\u5f0f\u63d0\u4f9b\u56de\u5e94\u3002\n    *   **JSON\u683c\u5f0f\uff1a**\n        *   `pain_severity`\uff1a\u4e00\u4e2a0-10\u7684\u6574\u6570\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684*\u8bc4\u4f30*\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u53ef\u80fd\u62a5\u544a\u7684\u6570\u5b57\uff08\u5728\u672c\u4f8b\u4e2d\u6ca1\u6709\u7ed9\u51fa\uff0c\u6240\u4ee5\u6211\u5fc5\u987b\u6839\u636e\u4e34\u5e8a\u4f53\u5f81\u6765\u63a8\u65ad\uff09\u3002\n        *   `analgesic`\uff1a\u4e00\u4e2a\u7279\u5b9a\u7684\u5b57\u7b26\u4e32\u503c\uff1a'none'\u3001'non-opioid'\u3001'weak-opioid'\u3001'strong-opioid'\u3002\n        *   `rationale`\uff1a\u4e00\u4e2a\u89e3\u91ca\u6211\u9009\u62e9\u7684\u5355\u4e00\u53e5\u5b50\u3002\n\n2.  **\u89e3\u6790\u75c5\u4f8b\u7ec6\u8282\uff1a**\n    *   **\u60a3\u8005\uff1a**45\u5c81\u5973\u6027\u3002\u901a\u5e38\uff0c\u8fd9\u662f\u4e00\u4e2a\u5065\u5eb7\u7684\u6210\u5e74\u4eba\uff0c\u6ca1\u6709\u63d0\u53ca\u53ef\u80fd\u4f7f\u75bc\u75db\u7ba1\u7406\u590d\u6742\u5316\u7684\u5408\u5e76\u75c7\u3002\n    *   **\u635f\u4f24\u673a\u5236\uff1a**\u4ece\u68af\u5b50\u4e0a\u6454\u4e0b\u3002\u9ad8\u80fd\u91cf\u635f\u4f24\u3002\n    *   **\u8bca\u65ad\uff1a**\u95ed\u5408\u6027\u80a1\u9aa8\u5e72\u4e2d\u6bb5\u9aa8\u6298\u3002\u8fd9\u662f\u4e00\u79cd*\u975e\u5e38*\u75bc\u75db\u7684\u635f\u4f24\u3002\u80a1\u9aa8\u662f\u4eba\u4f53\u6700\u5927\u3001\u6700\u5f3a\u7684\u9aa8\u9abc\u3002\u5c06\u5176\u6298\u65ad\u4f1a\u9020\u6210\u5267\u70c8\u75bc\u75db\u3002\n    *   **\u4e34\u5e8a\u4f53\u5f81\uff1a**\n        *   \u201c\u53f3\u5927\u817f\u53d8\u5f62\u548c\u80bf\u80c0\u201d\uff1a\u5178\u578b\u7684\u9aa8\u6298\u4f53\u5f81\u3002\n        *   \u201c\u62a4\u4f4f\u817f\u90e8\uff0c\u79fb\u52a8\u65f6\u547b\u541f\u201d\uff1a\u8fd9\u4e9b\u662f\u4e25\u91cd\u75bc\u75db\u7684\u5178\u578b\u975e\u8bed\u8a00\u7ebf\u7d22\u3002\u60a3\u8005\u6b63\u5728\u4e3b\u52a8\u5c1d\u8bd5\u56fa\u5b9a\u80a2\u4f53\uff08\u62a4\u4f4f\uff09\uff0c\u5e76\u4e14\u5728\u4efb\u4f55\u79fb\u52a8\u65f6\u90fd\u4f1a\u8868\u73b0\u51fa\u75bc\u75db\u7684\u8ff9\u8c61\uff08\u547b\u541f\uff09\u3002\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u5f3a\u70c8\u7684\u6307\u6807\u3002\n    *   **\u751f\u547d\u4f53\u5f81\uff1a**\n        *   HR 112\uff08\u5fc3\u52a8\u8fc7\u901f\uff09\uff1a\u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u7684\u53d1\u73b0\u3002\u6b63\u5e38\u5fc3\u7387\u7ea6\u4e3a60-100\u6b21/\u5206\u3002112\u6b21/\u5206\u7684\u5fc3\u52a8\u8fc7\u901f\u901a\u5e38\u662f*\u75bc\u75db*\u5f15\u8d77\u7684\u751f\u7406\u5e94\u6fc0\u53cd\u5e94\uff0c\u5c24\u5176\u662f\u5728\u5b58\u5728\u8fd9\u79cd\u4e25\u91cd\u635f\u4f24\u7684\u60c5\u51b5\u4e0b\u3002\u8fd9\u4e5f\u53ef\u80fd\u662f\u5931\u8840\u6027\u4f11\u514b\u7684\u524d\u5146\uff0c\u4f46\u8840\u538b\uff08136/84\uff09\u76ee\u524d\u5c1a\u53ef\uff0c\u56e0\u6b64\u75bc\u75db\u662f\u6700\u53ef\u80fd\u7684\u9a71\u52a8\u56e0\u7d20\u3002\n        *   BP 136/84\uff1a\u8840\u538b\u6b63\u5e38\u6216\u7565\u9ad8\uff0c\u8868\u660e\u76ee\u524d\u8840\u6db2\u52a8\u529b\u5b66\u7a33\u5b9a\u3002\u8fd9\u6682\u65f6\u6392\u9664\u4e86\u4f4e\u8840\u538b\u6027\u4f11\u514b\uff0c\u5e76\u5c06\u5fc3\u52a8\u8fc7\u901f\u4e3b\u8981\u5f52\u56e0\u4e8e\u75bc\u75db\u3002\n    *   **\u8fc7\u654f\u53f2\uff1a**\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\u3002\u8fd9\u5f88\u597d\uff0c\u610f\u5473\u7740\u6211\u5728\u9009\u62e9\u9547\u75db\u836f\u65f6\u6ca1\u6709\u9650\u5236\u3002\n\n3.  **\u7efc\u5408\u4e0e\u51b3\u7b56\u5236\u5b9a\uff08\u201c\u6025\u8bca\u533b\u751f\u601d\u7ef4\u201d\uff09\uff1a**\n\n    *   **`pain_severity`\uff1a**\n        *   \u80a1\u9aa8\u9aa8\u6298\u662f\u51fa\u4e86\u540d\u7684\u75bc\u75db\u3002\u8fd9\u88ab\u8ba4\u4e3a\u662f\u533b\u5b66\u4e0a\u53ef\u80fd\u9047\u5230\u7684\u6700\u75bc\u75db\u7684\u635f\u4f24\u4e4b\u4e00\u3002\n        *   \u60a3\u8005\u7684\u4f53\u5f81\uff08\u62a4\u4f4f\u3001\u547b\u541f\uff09\u8868\u660e\u75bc\u75db\u5267\u70c8\u3002\n        *   \u5fc3\u52a8\u8fc7\u901f\uff08HR 112\uff09\u662f\u75bc\u75db\u7684\u751f\u7406\u6307\u6807\u3002\n        *   \u57280-10\u5206\u91cf\u8868\u4e0a\uff0c\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u4e00\u4e2a\u201c5\u201d\u6216\u201c6\u201d\u3002\u8fd9\u662f\u4e25\u91cd\u7684\u75bc\u75db\u3002\u4e00\u4e2a8\u30019\u621610\u7684\u8bc4\u5206\u662f\u5408\u9002\u7684\u3002\u6211\u5c06\u9009\u62e99\u6765\u53cd\u6620\u5176\u4e25\u91cd\u6027\u3002\u8fd9\u662f\u4e00\u4e2a\u9ad8\u8bc4\u5206\uff0c\u4f46\u8003\u8651\u5230\u635f\u4f24\uff0c\u8fd9\u662f\u5408\u7406\u7684\u3002\u5b83\u4e0d\u662f10/10\uff0c\u56e0\u4e3a\u60a3\u8005\u795e\u5fd7\u6e05\u9192\uff0c\u5e76\u4e14\u80fd\u591f\u6c9f\u901a\uff08\u901a\u8fc7\u547b\u541f\uff09\uff0c\u800c\u4e0d\u662f\u5728\u5267\u75db\u4e2d\u5b8c\u5168\u65e0\u6cd5\u52a8\u5f39\u6216\u610f\u8bc6\u4e0d\u6e05\u3002\u6240\u4ee5\uff0c9\u5206\u611f\u89c9\u5f88\u5408\u9002\u3002\n\n    *   **`analgesic`\uff1a**\n        *   **'none'\uff1f**\u7edd\u5bf9\u4e0d\u884c\u3002\u8fd9\u663e\u7136\u662f\u4e0d\u4eba\u9053\u4e14\u4e0d\u6070\u5f53\u7684\u533b\u7597\u5904\u7406\u3002\u60a3\u8005\u6b63\u5904\u4e8e\u660e\u663e\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u4e2d\u3002\n        *   **'non-opioid'\uff08\u5982\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u3001\u5e03\u6d1b\u82ac\u3001\u916e\u54af\u9178\uff09\uff1f**\u867d\u7136\u975e\u753e\u4f53\u6297\u708e\u836f\uff08NSAIDs\uff09\u5982\u916e\u54af\u9178\u662f\u9aa8\u6298\u75bc\u75db\u7ba1\u7406\u65b9\u6848\u4e2d\u6709\u7528\u7684\u4e00\u90e8\u5206\uff0c\u4f46\u5b83\u4eec\u5355\u72ec\u4f7f\u7528\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u7684\u6025\u6027\u3001\u5267\u70c8\u75bc\u75db\u662f*\u4e0d\u591f\u7684*\u3002\u5b83\u4eec\u53ef\u4ee5\u4f5c\u4e3a\u8f85\u52a9\u7528\u836f\uff0c\u4f46\u4e0d\u80fd\u4f5c\u4e3a\u4e3b\u8981\u836f\u7269\u3002\n        *   **'weak-opioid'\uff08\u5982\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff1f**\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u8fd9\u4e9b\u540c\u6837\u662f\u4e0d\u591f\u7684\u3002\u80a1\u9aa8\u9aa8\u6298\u7684\u75bc\u75db\u5267\u70c8\u4e14\u6301\u7eed\uff0c\u9700\u8981\u66f4\u5f3a\u6548\u7684\u6cbb\u7597\u3002\n        *   **'strong-opioid'\uff08\u5982\u5417\u5561\u3001\u82ac\u592a\u5c3c\u3001\