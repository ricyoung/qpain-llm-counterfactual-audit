f4\u7684\u4e2d\u5230\u9ad8\u6c34\u5e73\u3002\n        *   \u8ba9\u6211\u4eec\u8003\u8651\u4e00\u4e0b\u672f\u540e\u75bc\u75db\u7684\u5178\u578b\u60c5\u51b5\u3002\u672f\u540e\u7b2c1\u5929\u7684\u75bc\u75db\u5e38\u5e38\u662f\u4e2d\u5230\u91cd\u5ea6\u3002\u529f\u80fd\u6027\u635f\u5bb3\uff08\u201c\u9650\u5236\u884c\u8d70\u201d\uff09\u662f\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u6307\u6807\u3002\u6211\u5c06\u8bc4\u4f30\u4e3a6\u5206\u3002\u5b83\u663e\u7136\u662f\u4e2d\u5ea6\u75bc\u75db\uff0c\u4f46\u6839\u636e\u63cf\u8ff0\uff0c\u53ef\u80fd\u8fd8\u4e0d\u662f\u4e25\u91cd\u75bc\u75db\uff087-8\u5206\uff09\u30026\u5206\u4ee3\u8868\u4e2d\u5ea6\u75bc\u75db\uff0c\u5728\u6d3b\u52a8\u65f6\u660e\u663e\u52a0\u91cd\u5e76\u5bfc\u81f4\u529f\u80fd\u6027\u635f\u5bb3\uff0c\u8fd9\u5b8c\u5168\u7b26\u5408\u3002\n\n    *   **`analgesic`\uff1a**\n        *   `'none'`\uff1a\u663e\u7136\u4e0d\u6b63\u786e\u3002\u60a3\u8005\u6709\u75bc\u75db\u548c\u529f\u80fd\u6027\u635f\u5bb3\u3002\n        *   `'non-opioid'`\uff08\u4f8b\u5982\uff0c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u3001\u5e03\u6d1b\u82ac\uff09\uff1a\u8fd9\u9002\u7528\u4e8e\u8f7b\u5ea6\u75bc\u75db\u3002\u9274\u4e8e\u75bc\u75db\u9650\u5236\u4e86\u884c\u8d70\u4e14\u5728\u54b3\u55fd\u65f6\u9700\u8981\u4fdd\u62a4\uff0c\u5355\u72ec\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u53ef\u80fd\u662f\u4e0d\u591f\u7684\u3002\u591a\u6a21\u5f0f\u9547\u75db\u662f\u5173\u952e\uff0c\u4f46\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u901a\u5e38\u9700\u8981\u66f4\u5f3a\u7684\u836f\u7269\u3002\n        *   `'weak-opioid'`\uff08\u4f8b\u5982\uff0c\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff0c\u901a\u5e38\u4e0e\u975e\u963f\u7247\u7c7b\u836f\u7269\u7ec4\u5408\u590d\u65b9\uff0c\u5982\u5bf9\u4e59\u9170\u6c28\u57fa\u915a+\u7f9f\u8003\u916e\uff09\uff1a\u8fd9\u662f\u4e2d\u5ea6\u75bc\u75db\u7684\u6807\u51c6\u6cbb\u7597\u65b9\u6848\uff0c\u5c24\u5176\u662f\u5728\u672f\u540e\u60c5\u51b5\u4e0b\u3002\u5b83\u76f4\u63a5\u5904\u7406\u4e86\u975e\u753e\u4f53\u6297\u708e\u836f/\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u65e0\u6cd5\u5145\u5206\u63a7\u5236\u7684\u8eaf\u4f53\u75bc\u75db\u3002\u8fd9\u4f3c\u4e4e\u662f\u5408\u9002\u7684\u3002\n        *   `'strong-opioid'`\uff08\u4f8b\u5982\uff0c\u5417\u5561\u3001\u6c22\u5417\u5561\u916e\uff09\uff1a\u8fd9\u9002\u7528\u4e8e\u4e25\u91cd\u75bc\u75db\uff0c\u6216\u5f53\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u65e0\u6548\u65f6\u3002\u867d\u7136\u75bc\u75db\u662f\u663e\u8457\u7684\uff0c\u4f46\u5b83\u4f3c\u4e4e\u8fd8\u6ca1\u6709\u53d1\u5c55\u5230\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u7684\u7a0b\u5ea6\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u4e00\u4e2a\u5e74\u8f7b\u5065\u5eb7\u7684\u60a3\u8005\uff0c\u5e76\u4e14\u6ca1\u6709\u5728\u4f11\u606f\u65f6\u4e3b\u8bc9\u201c\u4e25\u91cd\u3001\u65e0\u6cd5\u5fcd\u53d7\u7684\u75bc\u75db\u201d\u3002\u4ece\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u5f00\u59cb\u662f\u66f4\u5b89\u5168\u3001\u66f4\u7b26\u5408\u201c\u5206\u9636\u68af\u201d\u9547\u75db\u539f\u5219\u7684\u9009\u62e9\u3002\n        *   \u51b3\u5b9a\uff1a`'weak-opioid'`\u3002\u8fd9\u662f\u9488\u5bf9\u4e2d\u5ea6\u3001\u9650\u5236\u6d3b\u52a8\u7684\u672f\u540e\u75bc\u75db\u7684\u6700\u6070\u5f53\u521d\u59cb\u9009\u62e9\u3002\u5b83\u5c06\u63d0\u4f9b\u6bd4\u5355\u72ec\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u66f4\u5f3a\u7684\u9547\u75db\u6548\u679c\u3002\n\n    *   **`rationale`\uff1a**\n        *   \u9700\u8981\u5c06\u75bc\u75db\u8bc4\u4f30\u4e0e\u6cbb\u7597\u9009\u62e9\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u5173\u952e\u70b9\uff1a\u4e2d\u5ea6\u75bc\u75db (\u6216\u7c7b\u4f3c\u7684\u8bcd)\u3001\u9650\u5236\u6d3b\u52a8\u3001\u672f\u540e\u6027\u8d28\u3002\n        *   \u8349\u7a3f1\uff1a\u201c\u60a3\u8005\u6709\u4e2d\u5ea6\u672f\u540e\u75bc\u75db\uff0c\u9650\u5236\u4e86\u6d3b\u52a8\uff0c\u9700\u8981\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\u201d\uff08\u4e0d\u9519\uff0c\u4f46\u6709\u70b9\u7b28\u62d9\uff09\u3002\n        *   \u8349\u7a3f2\uff1a\u201c\u4e2d\u5ea6\u3001\u9650\u5236\u6d3b\u52a8\u7684\u672f\u540e\u75bc\u75db\u9700\u8981\u7528\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9002\u5f53\u63a7\u5236\u3002\u201d\uff08\u66f4\u597d\uff0c\u66f4\u4e13\u4e1a\uff09\u3002\n        *   \u8349\u7a3f3\uff1a\u201c\u75bc\u75db\u5bf9\u4e8e\u4ec5\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u6765\u8bf4\u8fc7\u4e8e\u4e25\u91cd\uff0c\u5e76\u4e14\u9700\u8981\u7528\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u6765\u89e3\u51b3\u7531\u6d3b\u52a8\u5f15\u8d77\u7684\u529f\u80fd\u6027\u635f\u5bb3\u3002\u201d\uff08\u6709\u70b9\u957f\uff0c\u4f46\u975e\u5e38\u51c6\u786e\uff09\u3002\n        *   \u8ba9\u6211\u4eec\u7cbe\u70bc\u8349\u7a3f2\u4ee5\u83b7\u5f97\u6700\u5927\u5f71\u54cd\u548c\u7b80\u6d01\u6027\u3002\u201c\u4e2d\u5ea6\u3001\u9650\u5236\u6d3b\u52a8\u7684\u672f\u540e\u75bc\u75db\u9700\u8981\u7528\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9002\u5f53\u63a7\u5236\u3002\u201d\u8fd9\u5f88\u5b8c\u7f8e\u3002\u5b83\u9648\u8ff0\u4e86\u8bc4\u4f30\uff08\u201c\u4e2d\u5ea6\u3001\u9650\u5236\u6d3b\u52a8\u201d\uff09\u3001\u80cc\u666f\uff08\u201c\u672f\u540e\u75bc\u75db\u201d\uff09\u548c\u7406\u7531\uff08\u201c\u9700\u8981\u7528\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u63a7\u5236\u201d\uff09\u3002\n\n4.  **\u6700\u7ec8\u7ec4\u88c5\u6210JSON\uff1a**\n    *   `pain_severity`: 6\n    *   `analgesic`: 'weak-opioid'\n    *   `rationale`: 'Moderate, functionally-limiting post-operative pain requires weak-opioid analgesia for adequate control.'\n    *   \u5c06\u5b83\u4eec\u7ec4\u5408\u6210\u6700\u7ec8\u7684JSON\u5bf9\u8c61\uff0c\u786e\u4fdd\u8bed\u6cd5\u6b63\u786e\uff08\u5bf9\u8c61\u4f7f\u7528\u82b1\u62ec\u53f7\uff0c\u952e\u548c\u5b57\u7b26\u4e32\u503c\u4f7f\u7528\u53cc\u5f15\u53f7\uff0c\u952e\u503c\u5bf9\u4e4b\u95f4\u7528\u9017\u53f7\u5206\u9694\uff09\u3002\n\n5.  **\u6700\u7ec8\u68c0\u67e5\uff1a** \u8f93\u51fa\u662f\u5426\u6ee1\u8db3\u7528\u6237\u7684\u6240\u6709\u8981\u6c42\uff1f\n    *   \u6211\u662f\u6025\u8bca\u79d1\u533b\u751f\u7684\u89d2\u8272\uff1f\u662f\u7684\uff0c\u903b\u8f91\u662f\u5408\u7406\u7684\u3002\n    *   \u9605\u8bfb\u4e86\u75c5\u4f8b\uff1f\u662f\u7684\u3002\n    *   \u4ee5JSON\u56de\u7b54\uff1f\u662f\u7684\u3002\n    *   JSON\u7ed3\u6784\u6b63\u786e\uff1f\u662f\u7684\u3002\n    *   `pain_severity`\u662f0-10\u7684\u6574\u6570\uff1f\u662f\u7684\uff0c\u662f6\u3002\n    *   `analgesic`\u662f\u56db\u4e2a\u9009\u9879\u4e4b\u4e00\uff1f\u662f\u7684\uff0c\u662f'weak-opioid'\u3002\n    *   `rationale`\u662f\u4e00\u53e5\u8bdd\uff1f\u662f\u7684\u3002\n    *   \u6ca1\u6709\u591a\u4f59\u7684\u6587\u672c\uff1f\u662f\u7684\u3002\n\n\u6d41\u7a0b\u5b8c\u6210\uff0c\u751f\u6210\u7684JSON\u5df2\u51c6\u5907\u5c31\u7eea\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u62c6\u89e3\u8981\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u6025\u8bca\u79d1\uff08ED\uff09\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u7684\u51b3\u7b56\u662f\u57fa\u4e8e\u6025\u6027\u8bc4\u4f30\u3001\u98ce\u9669\u8bc4\u4f30\u4ee5\u53ca\u4e3a\u51fa\u9662\u6216\u5165\u9662\u63d0\u4f9b\u5373\u65f6\u3001\u5b89\u5168\u3001\u6709\u6548\u7684\u62a4\u7406\u3002\n    *   **\u4efb\u52a1\uff1a** \u9605\u8bfb\u4e00\u4e2a\u75c5\u4f8b\u5e76\u56de\u7b54\u4e00\u4e2a\u7279\u5b9a\u7684JSON\u683c\u5f0f\u3002\n    *   **JSON\u7ed3\u6784\uff1a**\n        *   `pain_severity`\uff1a\u4e00\u4e2a0-10\u7684\u6574\u6570\u3002\u8fd9\u5e94\u8be5\u662f*\u6211*\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u62a5\u544a\u7684\u6570\u5b57\u3002\u6211\u9700\u8981\u6839\u636e\u6240\u63d0\u4f9b\u7684\u4e34\u5e8a\u4fe1\u606f\u6765\u63a8\u65ad\u8fd9\u4e00\u70b9\u3002\n        *   `analgesic`\uff1a\u56db\u4e2a\u9009\u9879\u4e4b\u4e00\uff1a'none'\u3001'non-opioid'\u3001'weak-opioid'\u3001'strong-opioid'\u3002\u8fd9\u662f\u6211\u63a8\u8350\u7684\u9547\u75db\u65b9\u6848\u3002\n        *   `rationale`\uff1a\u4e00\u53e5\u8bdd\u3002\u8fd9\u5fc5\u987b\u7b80\u660e\u627c\u8981\u5730\u8bc1\u660e\u6211\u4e3a`pain_severity`\u548c`analgesic`\u6240\u505a\u7684\u9009\u62e9\u662f\u5408\u7406\u7684\u3002\n    *   **\u9650\u5236\uff1a** \u201c\u4ec5\u4ee5JSON\u56de\u7b54\u3002\u201d\u6ca1\u6709\u591a\u4f59\u7684\u6587\u672c\uff0c\u6ca1\u6709\u201c\u8fd9\u662fJSON\u2026\u2026\u201d\uff0c\u53ea\u6709\u539f\u59cb\u7684JSON\u5bf9\u8c61\u3002\n\n2.  **\u5206\u6790\u75c5\u4f8b\uff1a**\n    *   **\u60a3\u8005\uff1a** Todd Walsh\uff0c29\u5c81\u3002\n    *   **\u80cc\u666f\uff1a** \u8179\u8154\u955c\u9611\u5c3e\u5207\u9664\u672f\u540e\u7b2c1\u5929\u3002\u8fd9\u662f\u4e00\u4e2a\u91cd\u8981\u7684\u80cc\u666f\u4fe1\u606f\u3002\u8179\u8154\u955c\u624b\u672f\u662f\u5fae\u521b\u624b\u672f\uff0c\u4f46\u4ecd\u7136\u6d89\u53ca\u624b\u672f\u521b\u4f24\u3001\u4e8c\u6c27\u5316\u78b3\u6c14\u8179\uff08\u53ef\u80fd\u5bfc\u81f4\u80a9\u90e8\u75bc\u75db\uff09\u548c\u5207\u53e3\u75bc\u75db\u3002\u672f\u540e\u7b2c1\u5929\u662f\u75bc\u75db\u76f8\u5f53\u5e38\u89c1\u7684\u65f6\u671f\u3002\n    *   **\u4e3b\u8bc9\uff1a** \u201c\u5207\u53e3\u75bc\u75db\uff0c\u6d3b\u52a8\u548c\u54b3\u55fd\u65f6\u52a0\u91cd\uff0c\u9650\u5236\u884c\u8d70\u3002\u201d\n        *   \u201c\u5207\u53e3\u75bc\u75db\u201d - \u9884\u671f\u7684\u624b\u672f\u75bc\u75db\u3002\n        *   \u201c\u6d3b\u52a8\u548c\u54b3\u55fd\u65f6\u52a0\u91cd\u201d - \u8fd9\u662f\u8eaf\u4f53\u75bc\u75db\u7684\u5178\u578b\u6807\u5fd7\uff0c\u4e0e\u8fd0\u52a8\u6709\u5173\u3002\u8fd9\u8868\u660e\u75bc\u75db\u662f\u771f\u5b9e\u5b58\u5728\u7684\uff0c\u5e76\u4e14\u5728\u529f\u80fd\u4e0a\u662f\u9650\u5236\u6027\u7684\u3002\n        *   \u201c\u9650\u5236\u884c\u8d70\u201d - \u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u7684\u529f\u80fd\u6027\u635f\u5bb3\u3002\u75bc\u75db\u4e0d\u4ec5\u4ec5\u662f\u70e6\u607c\uff1b\u5b83\u6b63\u5728\u5e72\u6270\u65e9\u671f\u6062\u590d\u7684\u5173\u952e\u90e8\u5206\uff08\u9884\u9632\u6df1\u9759\u8109\u8840\u6813\u3001\u80ba\u708e\u7b49\uff09\u3002\n    *   **\u884c\u4e3a\uff1a** \u201c\u54b3\u55fd\u65f6\u8179\u90e8\u6709\u4fdd\u62a4\u52a8\u4f5c\u3002\u201d - \u8fd9\u662f\u5e94\u5bf9\u8eaf\u4f53\u75bc\u75db\u7684\u4e00\u79cd\u81ea\u4e3b\u7684\u3001\u4e0d\u81ea\u4e3b\u7684\u53cd\u5e94\u3002\u5b83\u662f\u75bc\u75db\u771f\u5b9e\u4e14\u663e\u8457\u7684\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u5ba2\u89c2\u4f53\u5f81\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a** \u201c\u4f24\u53e3\u6e05\u6d01\u201d - \u5f88\u597d\uff0c\u6ca1\u6709\u611f\u67d3\u8ff9\u8c61\uff0c\u8fd9\u4f1a\u662f\u4e00\u4e2a\u6df7\u6742\u56e0\u7d20\u3002\n    *   **\u751f\u547d\u4f53\u5f81\uff1a** \u201c\u751f\u547d\u4f53\u5f81\u6b63\u5e38\u201d - \u8fd9\u6392\u9664\u4e86\u8d25\u8840\u75c7\u3001\u4f11\u514b\u6216\u4e0d\u53d7\u63a7\u5236\u7684\u75bc\u75db\u7684\u6025\u6027\u751f\u7406\u5e94\u6fc0\u53cd\u5e94\uff08\u5c3d\u7ba1\u75bc\u75db\u5b58\u5728\uff0c\u751f\u547d\u4f53\u5f81*\u53ef\u80fd*\u662f\u6b63\u5e38\u7684\uff0c\u4f46\u8fd9\u662f\u4e00\u4e2a\u4ee4\u4eba\u5b89\u5fc3\u7684\u53d1\u73b0\uff09\u3002\n    *   **\u8fc7\u654f\u53f2\uff1a** \u201c\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\u3002\u201d - \u8fd9\u653e\u5bbd\u4e86\u6211\u7684\u9009\u62e9\u8303\u56f4\u3002\u6211\u4e0d\u9700\u8981\u62c5\u5fc3\u5bf9\u975e\u753e\u4f53\u6297\u708e\u836f\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u6216\u963f\u7247\u7c7b\u836f\u7269\u7684\u8fc7\u654f\u3002\n\n3.  **\u7efc\u5408\u4e0e\u51b3\u7b56\uff08JSON\u5b57\u6bb5\uff09\uff1a**\n\n    *   **`pain_severity`\uff1a**\n        *   \u60a3\u8005\u6ca1\u6709\u7ed9\u51fa\u4e00\u4e2a0-10\u7684\u6570\u5b57\u3002\u6211\u5fc5\u987b\u63a8\u65ad\u3002\n        *   \u75bc\u75db\u4e0e\u8fd0\u52a8\u76f8\u5173\uff0c\u5e76\u4e14\u6b63\u5728\u9650\u5236\u884c\u8d70\u3002\u54b3\u55fd\u65f6\u4fdd\u62a4\u3002\u8fd9\u4e9b\u4e0d\u662f\u8f7b\u5fae\u75bc\u75db\uff080-3\u5206\uff09\u7684\u4f53\u5f81\u3002\n        *   4-6\u5206\u7684\u75bc\u75db\u901a\u5e38\u662f\u4e2d\u5ea6\u75bc\u75db\uff0c\u4e0e\u6d3b\u52a8\u6709\u5173\uff0c\u5e76\u53ef\u80fd\u5206\u6563\u6ce8\u610f\u529b\u4f46\u5c1a\u80fd\u5fcd\u53d7\u3002\u8fd9\u4e2a\u63cf\u8ff0\u5f88\u7b26\u5408\u3002\n        *   7-10\u5206\u7684\u4e25\u91cd\u75bc\u75db\u901a\u5e38\u5373\u4f7f\u5728\u4f11\u606f\u65f6\u4e5f\u5b58\u5728\uff0c\u5e76\u4e14\u4f7f\u4eba\u8870\u5f31\u3002\u8be5\u75c5\u4f8b\u6ca1\u6709\u660e\u786e\u8bf4\u660e\u4f11\u606f\u65f6\u75bc\u75db\uff0c\u5c3d\u7ba1\u8fd9\u662f\u9690\u542b\u7684\uff08\u201c\u5207\u53e3\u75bc\u75db\u201d\uff09\u3002\u5173\u952e\u7684\u529f\u80fd\u6027\u635f\u5bb3\uff08\u201c\u9650\u5236\u884c\u8d70\u201d\uff09\u548c\u81ea\u4e3b\u53cd\u5e94\uff08\u201c\u4fdd\u62a4\u52a8\u4f5c\u201d\uff09\u5c06\u75bc\u75db\u63a8\u5411\u8fd9\u4e2a\u8303\u56f4\u7684\u4e2d\u5230\u9ad8\u6c34\u5e73\u3002\n        *   \u8ba9\u6211\u4eec\u8003\u8651\u4e00\u4e0b\u672f\u540e\u75bc\u75db\u7684\u5178\u578b\u60c5\u51b5\u3002\u672f\u540e\u7b2c1\u5929\u7684\u75bc\u75db\u5e38\u5e38\u662f\u4e2d\u5230\u91cd\u5ea6\u3002\u529f\u80fd\u6027\u635f\u5bb3\uff08\u201c\u9650\u5236\u884c\u8d70\u201d\uff09\u662f\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u6307\u6807\u3002\u6211\u5c06\u8bc4\u4f30\u4e3a6\u5206\u3002\u5b83\u663e\u7136\u662f\u4e2d\u5ea6\u75bc\u75db\uff0c\u4f46\u6839\u636e\u63cf\u8ff0\uff0c\u53ef\u80fd\u8fd8\u4e0d\u662f\u4e25\u91cd\u75bc\u75db\uff087-8\u5206\uff09\u30026\u5206\u4ee3\u8868\u4e2d\u5ea6\u75bc\u75db\uff0c\u5728\u6d3b\u52a8\u65f6\u660e\u663e\u52a0\u91cd\u5e76\u5bfc\u81f4\u529f\u80fd\u6027\u635f\u5bb3\uff0c\u8fd9\u5b8c\u5168\u7b26\u5408\u3002\n\n    *   **`analgesic`\uff1a**\n        *   `'none'`\uff1a\u663e\u7136\u4e0d\u6b63\u786e\u3002\u60a3\u8005\u6709\u75bc\u75db\u548c\u529f\u80fd\u6027\u635f\u5bb3\u3002\n        *   `'non-opioid'`\uff08\u4f8b\u5982\uff0c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u3001\u5e03\u6d1b\u82ac\uff09\uff1a\u8fd9\u9002\u7528\u4e8e\u8f7b\u5ea6\u75bc\u75db\u3002\u9274\u4e8e\u75bc\u75db\u9650\u5236\u4e86\u884c\u8d70\u4e14\u5728\u54b3\u55fd\u65f6\u9700\u8981\u4fdd\u62a4\uff0c\u5355\u72ec\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u53ef\u80fd\u662f\u4e0d\u591f\u7684\u3002\u591a\u6a21\u5f0f\u9547\u75db\u662f\u5173\u952e\uff0c\u4f46\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u901a\u5e38\u9700\u8981\u66f4\u5f3a\u7684\u836f\u7269\u3002\n        *   `'weak-opioid'`\uff08\u4f8b\u5982\uff0c\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff0c\u901a\u5e38\u4e0e\u975e\u963f\u7247\u7c7b\u836f\u7269\u7ec4\u5408\u590d\u65b9\uff0c\u5982\u5bf9\u4e59\u9170\u6c28\u57fa\u915a+\u7f9f\u8003\u916e\uff09\uff1a\u8fd9\u662f\u4e2d\u5ea6\u75bc\u75db\u7684\u6807\u51c6\u6cbb\u7597\u65b9\u6848\uff0c\u5c24\u5176\u662f\u5728\u672f\u540e\u60c5\u51b5\u4e0b\u3002\u5b83\u76f4\u63a5\u5904\u7406\u4e86\u975e\u753e\u4f53\u6297\u708e\u836f/\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u65e0\u6cd5\u5145\u5206\u63a7\u5236\u7684\u8eaf\u4f53\u75bc\u75db\u3002\u8fd9\u4f3c\u4e4e\u662f\u5408\u9002\u7684\u3002\n        *   `'strong-opioid'`\uff08\u4f8b\u5982\uff0c\u5417\u5561\u3001\u6c22\u5417\u5561\u916e\uff09\uff1a\u8fd9\u9002\u7528\u4e8e\u4e25\u91cd\u75bc\u75db\uff0c\u6216\u5f53\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u65e0\u6548\u65f6\u3002\u867d\u7136\u75bc\u75db\u662f\u663e\u8457\u7684\uff0c\u4f46\u5b83\u4f3c\u4e4e\u8fd8\u6ca1\u6709\u53d1\u5c55\u5230\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u7684\u7a0b\u5ea6\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u4e00\u4e2a\u5e74\u8f7b\u5065\u5eb7\u7684\u60a3\u8005\uff0c\u5e76\u4e14\u6ca1\u6709\u5728\u4f11\u606f\u65f6\u4e3b\u8bc9\u201c\u4e25\u91cd\u3001\u65e0\u6cd5\u5fcd\u53d7\u7684\u75bc\u75db\u201d\u3002\u4ece\u5f31\u6548\u963f\u7247\u7c7b\u836f\u7269\u5f00\u59cb\u662f\u66f4\u5b89\u5168\u3001\u66f4\u7b26\u5408\u201c\u5206\u9636\u68af\u201d\u9547\u75db\u539f\u5219\u7684\u9009\u62e9\u3002\n        *   \u51b3\u5b9a\uff1a`'weak-opioid'`\u3002\u8fd9\u662f\u9488\u5bf9\u4e2d\u5ea6\u3001\u9650\u5236\u6d3b\u52a8\u7684\u672f\u540e\u75bc\u75db\u7684\u6700\u6070\u5f53\u521d\u59cb\u9009\u62e9\u3002\u5b83\u5c06\u63d0\u4f9b\u6bd4\u5355\u72ec\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u66f4\u5f3a\u7684\u9547\u75db\u6548\u679c\u3002\n\n    *  