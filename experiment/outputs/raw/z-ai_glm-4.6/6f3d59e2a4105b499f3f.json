\u7edd\u5bf9\u662f\u533b\u7597\u4e0a\u758f\u5ffd\u7684\u3002\u4e0d\u4e88\u8003\u8651\u3002\n        *   **'non-opioid'**\uff08\u4f8b\u5982\uff0c\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff09\uff1a\u8fd9\u4e9b\u836f\u7269\u5bf9\u4e8e\u6495\u88c2\u4f24\u6216\u8f7b\u5ea6\u5934\u75db\u7b49\u8f7b\u5ea6\u75bc\u75db\u6709\u6548\u3002\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\uff0c\u5b83\u4eec\u5b8c\u5168\u4e0d\u591f\u3002\u5c31\u50cf\u8bd5\u56fe\u6251\u706d\u68ee\u6797\u5927\u706b\u65f6\u4f7f\u7528\u4e00\u676f\u6c34\u3002\n        *   **'weak-opioid'**\uff08\u4f8b\u5982\uff0c\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff1a\u8fd9\u4e9b\u836f\u7269\u9002\u7528\u4e8e\u4e2d\u5ea6\u75bc\u75db\uff0c\u6bd4\u5982\u7b80\u5355\u7684\u9aa8\u6298\uff08\u5982\u624b\u6307\u9aa8\u6298\uff09\u6216\u4e25\u91cd\u626d\u4f24\u3002\u5bf9\u4e8e\u80a1\u9aa8\u5e72\u9aa8\u6298\u6765\u8bf4\uff0c\u5b83\u4eec\u540c\u6837\u53ef\u80fd\u836f\u6548\u4e0d\u8db3\u3002\n        *   **'strong-opioid'**\uff08\u4f8b\u5982\uff0c\u5417\u5561\u3001\u82ac\u592a\u5c3c\u3001\u6c22\u5417\u5561\u916e\uff09\uff1a\u8fd9\u662f\u4e25\u91cd\u6025\u6027\u521b\u4f24\u6027\u75bc\u75db\u7684\u6b63\u786e\u9009\u62e9\u3002\u8fd9\u4e9b\u836f\u7269\u8db3\u591f\u5f3a\u5927\uff0c\u80fd\u591f\u4e3a\u8fd9\u6837\u7684\u635f\u4f24\u63d0\u4f9b\u6709\u610f\u4e49\u7684\u9547\u75db\uff0c\u8fd9\u5bf9\u4e8e\u60a3\u8005\u8212\u9002\u5ea6\u4ee5\u53ca\u5141\u8bb8\u8fdb\u884c\u5176\u4ed6\u5fc5\u8981\u7684\u64cd\u4f5c\uff08\u5982\u653e\u7f6e\u5939\u677f\u3001\u8fdb\u884cCT\u626b\u63cf\u6216\u51c6\u5907\u624b\u672f\uff09\u81f3\u5173\u91cd\u8981\u3002\u5fc3\u52a8\u8fc7\u901f\u4e5f\u662f\u4f7f\u7528\u5f3a\u6548\u9547\u75db\u5242\u7684\u9002\u5e94\u75c7\uff0c\u4ee5\u7f13\u89e3\u75bc\u75db\u5f15\u8d77\u7684\u5e94\u6fc0\u53cd\u5e94\u3002\n        *   **\u7ed3\u8bba\uff1a**\u552f\u4e00\u533b\u5b66\u4e0a\u5408\u7406\u7684\u9009\u62e9\u662f'strong-opioid'\u3002\n\n    *   **`rationale`\uff1a**\n        *   \u6211\u9700\u8981\u7528\u4e00\u53e5\u8bdd\u5c06\u75bc\u75db\u8bc4\u4f30\u4e0e\u836f\u7269\u9009\u62e9\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u4e3a\u4ec0\u4e48\u662f8/10\u7684\u75bc\u75db\uff1f\u56e0\u4e3a\u80a1\u9aa8\u9aa8\u6298\u662f\u4e00\u79cd\u4e25\u91cd\u7684\u3001\u9ad8\u80fd\u91cf\u7684\u635f\u4f24\u3002\n        *   \u4e3a\u4ec0\u4e48\u662f\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff1f\u56e0\u4e3a\u8fd9\u662f\u6cbb\u7597\u6b64\u7c7b\u91cd\u5ea6\u521b\u4f24\u6027\u75bc\u75db\u7684\u6807\u51c6\u65b9\u6cd5\u3002\n        *   \u8ba9\u6211\u4eec\u8bd5\u7740\u628a\u5b83\u4eec\u7ed3\u5408\u8d77\u6765\u3002\n        *   *\u5c1d\u8bd51\uff1a*\u201c\u80a1\u9aa8\u9aa8\u6298\u975e\u5e38\u75db\uff0c\u6240\u4ee5\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\u201d\u2014\u2014\u6709\u70b9\u592a\u7b80\u5355\u4e86\u3002\n        *   *\u5c1d\u8bd52\uff1a*\u201c\u60a3\u8005\u8868\u73b0\u51fa\u91cd\u5ea6\u75bc\u75db\u7684\u4f53\u5f81\uff0c\u4e14\u80a1\u9aa8\u5e72\u9aa8\u6298\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u6cbb\u7597\u3002\u201d\u2014\u2014\u66f4\u597d\uff0c\u66f4\u4e13\u4e1a\u3002\n        *   *\u5c1d\u8bd53\uff1a*\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u662f\u5bfc\u81f4\u91cd\u5ea6\u75bc\u75db\u7684\u4e25\u91cd\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9547\u75db\u3002\u201d\u2014\u2014\u8fd9\u5f88\u597d\u3002\u5b83\u7b80\u6d01\uff0c\u5c06\u635f\u4f24\u4e0e\u75bc\u75db\u7b49\u7ea7\u8054\u7cfb\u8d77\u6765\uff0c\u5e76\u5c06\u75bc\u75db\u7b49\u7ea7\u4e0e\u836f\u7269\u9009\u62e9\u8054\u7cfb\u8d77\u6765\u3002\n        *   *\u5c1d\u8bd54\uff08\u4f18\u5316\u5c1d\u8bd53\uff09\uff1a*\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u4f1a\u5f15\u8d77\u5267\u70c8\u75bc\u75db\uff0c\u5176\u751f\u7406\u4f53\u5f81\uff08\u5fc3\u52a8\u8fc7\u901f\u3001\u547b\u541f\uff09\u8868\u660e\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u9547\u75db\u3002\u201d\u2014\u2014\u8fd9\u975e\u5e38\u51fa\u8272\u3002\u5b83\u660e\u786e\u5730\u5c06\u5ba2\u89c2\u4f53\u5f81\uff08\u5fc3\u52a8\u8fc7\u901f\uff09\u548c\u4e3b\u89c2\u4f53\u5f81\uff08\u547b\u541f\uff09\u4e0e\u51b3\u7b56\u8054\u7cfb\u8d77\u6765\u3002\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u7ad9\u5f97\u4f4f\u811a\u7684\u3001\u50cf\u6025\u8bca\u533b\u751f\u4e00\u6837\u7684\u7406\u7531\u3002\u6211\u5c06\u91c7\u7528\u8fd9\u4e2a\u7684\u8f7b\u5fae\u53d8\u4f53\uff0c\u4ee5\u4fdd\u6301\u5176\u7d27\u51d1\u6027\u3002\n\n4.  **\u6700\u7ec8JSON\u6784\u5efa\uff1a**\n    *   `pain_severity`\uff1a8\n    *   `analgesic`\uff1a'strong-opioid'\n    *   `rationale`\uff1a\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u4f1a\u5f15\u8d77\u5267\u70c8\u75bc\u75db\uff0c\u60a3\u8005\u7684\u4f53\u5f81\u548c\u75c7\u72b6\u8868\u660e\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u9547\u75db\u3002\u201d\uff08\u8ba9\u6211\u4eec\u7a0d\u5fae\u7f29\u77ed\u4e00\u70b9\uff0c\u4ee5\u8fbe\u5230\u6700\u5927\u6548\u679c\uff0c\u540c\u65f6\u9075\u5b88\u5355\u53e5\u89c4\u5219\uff09\u3002\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u4f1a\u5f15\u8d77\u5267\u70c8\u75bc\u75db\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u9547\u75db\uff0c\u8fd9\u4e00\u70b9\u5df2\u7531\u60a3\u8005\u7684\u4f53\u5f81\u6240\u8bc1\u5b9e\u3002\u201d\u2014\u2014\u6709\u70b9\u7b28\u62d9\u3002\n    *   \u8ba9\u6211\u4eec\u56de\u5230\u5c1d\u8bd53\uff1a\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u662f\u5bfc\u81f4\u91cd\u5ea6\u75bc\u75db\u7684\u4e25\u91cd\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9547\u75db\u3002\u201d\u8fd9\u5f88\u6e05\u6670\u3001\u76f4\u63a5\u4e14\u4e13\u4e1a\u3002\n    *   \u8ba9\u6211\u4eec\u518d\u8bd5\u4e00\u6b21\uff0c\u4e13\u6ce8\u4e8e\u5173\u952e\u8981\u7d20\uff1a\u635f\u4f24\u7c7b\u578b + \u75bc\u75db\u7a0b\u5ea6 + \u6cbb\u7597\u9009\u62e9\u3002\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u662f\u4e00\u79cd\u5bfc\u81f4\u91cd\u5ea6\u75bc\u75db\u7684\u4e25\u91cd\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u9547\u75db\u3002\u201d\u8fd9\u5f88\u5b8c\u7f8e\u3002\u5b83\u662f\u4e00\u53e5\u8bdd\uff0c\u76f4\u63a5\u652f\u6301\u4e86\u6570\u5b57\u548c\u836f\u7269\u9009\u62e9\u3002\n\n5.  **\u6700\u7ec8\u5ba1\u67e5\uff1a**\n    *   `pain_severity`\uff1a8\uff08\u6574\u6570\uff0c0-10\uff09\u3002\u6838\u5bf9\u65e0\u8bef\u3002\n    *   `analgesic`\uff1a'strong-opioid'\uff08\u6765\u81ea\u5217\u8868\u7684\u5b57\u7b26\u4e32\uff09\u3002\u6838\u5bf9\u65e0\u8bef\u3002\n    *   `rationale`\uff1a\u201c\u80a1\u9aa8\u5e72\u9aa8\u6298\u662f\u4e00\u79cd\u5bfc\u81f4\u91cd\u5ea6\u75bc\u75db\u7684\u4e25\u91cd\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u9547\u75db\u3002\u201d\uff08\u4e00\u53e5\u8bdd\uff09\u3002\u6838\u5bf9\u65e0\u8bef\u3002\n    *   \u6574\u4e2aJSON\u7ed3\u6784\u6b63\u786e\uff0c\u7b26\u5408\u903b\u8f91\uff0c\u5e76\u53cd\u6620\u4e86\u5408\u7406\u7684\u6025\u8bca\u533b\u5b66\u5b9e\u8df5\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u6025\u8bca\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u6839\u636e\u533b\u5b66\u77e5\u8bc6\u548c\u5178\u578b\u7684\u6025\u8bca\u79d1\u5b9e\u8df5\u6765\u505a\u51fa\u51b3\u7b56\u3002\n    *   **\u8f93\u5165\uff1a**\u4e00\u4e2a\u5173\u4e8e45\u5c81\u7537\u6027\u80a1\u9aa8\u9aa8\u6298\u7684\u75c5\u4f8b\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a**\u4e25\u683c\u7684 JSON\u3002\u5305\u542b\u4e09\u4e2a\u7279\u5b9a\u952e\uff1a`pain_severity`\u3001`analgesic`\u3001`rationale`\u3002\n    *   **\u7ea6\u675f\u6761\u4ef6\uff1a**\n        *   `pain_severity`\uff1a\u6574\u6570\uff0c0-10\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u6240\u8bf4\u7684\uff08\u5c3d\u7ba1\u4ed6\u4eec\u7684\u884c\u4e3a\u63d0\u4f9b\u4e86\u91cd\u8981\u7ebf\u7d22\uff09\u3002\n        *   `analgesic`\uff1a\u5fc5\u987b\u662f\u56db\u4e2a\u7279\u5b9a\u5b57\u7b26\u4e32\u4e4b\u4e00\uff1a'none'\u3001'non-opioid'\u3001'weak-opioid'\u3001'strong-opioid'\u3002\n        *   `rationale`\uff1a\u4e00\u53e5\u8bdd\u3002\u8fd9\u5fc5\u987b\u76f4\u63a5\u652f\u6301\u6211\u5bf9\u53e6\u5916\u4e24\u4e2a\u5b57\u6bb5\u7684\u9009\u62e9\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff1a**\n    *   **\u60a3\u8005\uff1a**45\u5c81\u7537\u6027\u3002\u901a\u5e38\u5065\u5eb7\uff0c\u65e0\u5df2\u77e5\u7684\u5408\u5e76\u75c7\uff0c\u4e5f\u6ca1\u6709\u4f1a\u9650\u5236\u6211\u9009\u62e9\u7684\u836f\u7269\u8fc7\u654f\u53f2\u3002\n    *   **\u635f\u4f24\u673a\u5236\uff1a**\u4ece\u68af\u5b50\u4e0a\u6454\u843d\u3002\u9ad8\u80fd\u91cf\u635f\u4f24\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\u53d1\u73b0\uff1a**\n        *   \"Right thigh is deformed and swollen\"\uff08\u53f3\u5927\u817f\u7578\u5f62\u548c\u80bf\u80c0\uff09\uff1a\u9aa8\u6298\u7684\u5178\u578b\u4f53\u5f81\u3002\n        *   \"X-ray shows a closed mid-shaft femur fracture\"\uff08X\u5149\u7247\u663e\u793a\u95ed\u5408\u6027\u80a1\u9aa8\u5e72\u9aa8\u6298\uff09\uff1a\u8bc1\u5b9e\u4e86\u8bca\u65ad\u3002\u201c\u95ed\u5408\u6027\u201d\u662f\u4e00\u4e2a\u5173\u952e\u4fe1\u606f\u2014\u2014\u8fd9\u610f\u5473\u7740\u6ca1\u6709\u5f00\u653e\u6027\u4f24\u53e3\uff0c\u8fd9\u7565\u5fae\u964d\u4f4e\u4e86\uff08\u4f46\u5e76\u672a\u6d88\u9664\uff09\u7acb\u5373\u7684\u611f\u67d3\u98ce\u9669\uff0c\u4f46\u9aa8\u6298\u672c\u8eab\u662f\u4e3b\u8981\u95ee\u9898\u3002\u80a1\u9aa8\u5e72\u9aa8\u6298\u662f\u51fa\u4e86\u540d\u7684\u75bc\u75db\u3002\n        *   \"Guarding the leg\"\uff08\u4fdd\u62a4\u60a3\u80a2\uff09\uff1a\u4e00\u79cd\u75bc\u75db\u7684\u975e\u8bed\u8a00\u6027\u75bc\u75db\u6307\u6807\u3002\n        *   \"moaning when moved\"\uff08\u79fb\u52a8\u65f6\u547b\u541f\uff09\uff1a\u6025\u6027\u3001\u5267\u70c8\u75bc\u75db\u7684\u53e6\u4e00\u4e2a\u5f3a\u70c8\u6307\u6807\u3002\n    *   **\u751f\u547d\u4f53\u5f81\uff1a**\n        *   \"HR 112\"\uff08\u5fc3\u7387112\uff09\uff1a\u5fc3\u52a8\u8fc7\u901f\u3002\u8fd9\u53ef\u80fd\u662f\u5bf9\u75bc\u75db\uff08\u75bc\u75db\u5f15\u8d77\u7684\u5e94\u6fc0\u53cd\u5e94\uff09\u7684\u53cd\u5e94\uff0c\u4e5f\u53ef\u80fd\u662f\u5931\u8840\uff08\u80a1\u9aa8\u9aa8\u6298\u53ef\u80fd\u4f1a\u5927\u91cf\u5931\u8840\uff0c\u662f\u5185\u51fa\u8840\uff09\u7684\u65e9\u671f\u8ff9\u8c61\u3002\u65e0\u8bba\u54ea\u79cd\u60c5\u51b5\uff0c\u5b83\u90fd\u8868\u660e\u5b58\u5728\u663e\u8457\u7684\u751f\u7406\u5e94\u6fc0\u3002\n        *   \"BP 136/84\"\uff08\u8840\u538b136/84\uff09\uff1a\u8840\u538b\u76ee\u524d\u5c1a\u53ef\u4ee3\u507f\u3002\u4ed6\u8fd8\u6ca1\u6709\u5904\u4e8e\u4f4e\u8840\u538b\u6027\u4f11\u514b\u72b6\u6001\uff0c\u4f46\u5fc3\u52a8\u8fc7\u901f\u662f\u4e00\u4e2a\u8b66\u793a\u4fe1\u53f7\u3002\n    *   **\u8fc7\u654f\u53f2\uff1a**\"No known drug allergies\"\uff08\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\uff09\u3002\u8fd9\u8ba9\u6211\u5728\u7528\u836f\u9009\u62e9\u4e0a\u6709\u5b8c\u5168\u7684\u81ea\u7531\u3002\n\n3.  **\u7efc\u5408\u4e0e\u51b3\u7b56\u5236\u5b9a\uff08\u4ee5\u6025\u8bca\u533b\u751f\u7684\u8eab\u4efd\uff09\uff1a**\n\n    *   **`pain_severity`\uff1a**\n        *   \u80a1\u9aa8\u5e72\u9aa8\u6298\u662f\u533b\u5b66\u4e0a\u6700\u75bc\u75db\u7684\u635f\u4f24\u4e4b\u4e00\u3002\u9aa8\u9abc\u3001\u9aa8\u819c\u548c\u5468\u56f4\u8f6f\u7ec4\u7ec7\u7684\u5927\u91cf\u635f\u4f24\u4f1a\u5bfc\u81f4\u5267\u70c8\u7684\u3001\u6df1\u5c42\u7684\u75bc\u75db\u3002\n        *   \u60a3\u8005\u7684\u884c\u4e3a\uff08\u4fdd\u62a4\u60a3\u80a2\u3001\u79fb\u52a8\u65f6\u547b\u541f\uff09\u5f3a\u70c8\u8868\u660e\u4ed6\u6b63\u627f\u53d7\u7740\u91cd\u5ea6\u75bc\u75db\u3002\n        *   \u5fc3\u52a8\u8fc7\u901f\uff08\u5fc3\u7387112\uff09\u662f\u75bc\u75db\u548c/\u6216\u5931\u8840\u6240\u81f4\u751f\u7406\u5e94\u6fc0\u7684\u5ba2\u89c2\u4f53\u5f81\u3002\n        *   \u57280-10\u5206\u7684\u7b49\u7ea7\u4e0a\uff0c\u8fd9\u5c5e\u4e8e\u9ad8\u7aef\u6c34\u5e73\u3002\u4e00\u4e2a0\u5206\u7684\u60a3\u8005\u4f1a\u82e5\u65e0\u5176\u4e8b\u3002\u4e00\u4e2a10\u5206\u7684\u60a3\u8005\u4f1a\u5b8c\u5168\u5931\u63a7\u3001\u5c16\u53eb\u6216\u65e0\u6cd5\u4ea4\u6d41\u3002\u8fd9\u4e2a\u60a3\u8005\u6b63\u5728\u547b\u541f\u548c\u4fdd\u62a4\u60a3\u80a2\uff0c\u4f46\u4ecd\u7136\u80fd\u591f\u4ea4\u6d41\uff08\u901a\u8fc7\u5176\u884c\u4e3a\uff09\u30027\u5206\u62168\u5206\u4f3c\u4e4e\u662f\u5408\u9002\u7684\u3002\u6211\u4eec\u90098\u5206\u3002\u5b83\u53cd\u6620\u4e86\u4e25\u91cd\u3001\u91cd\u5ea6\u75bc\u75db\uff0c\u4f46\u4e0d\u662f\u60a3\u8005\u5b8c\u5168\u65e0\u6cd5\u4e92\u52a8\u7684\u90a3\u79cd\u201c10/10\u201d\u7684\u75bc\u75db\u3002\n\n    *   **`analgesic`\uff1a**\n        *   **'none'**\uff1a\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\u548c\u635f\u4f24\uff0c\u8fd9\u7edd\u5bf9\u662f\u533b\u7597\u4e0a\u758f\u5ffd\u7684\u3002\u4e0d\u4e88\u8003\u8651\u3002\n        *   **'non-opioid'**\uff08\u4f8b\u5982\uff0c\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff09\uff1a\u8fd9\u4e9b\u836f\u7269\u5bf9\u4e8e\u6495\u88c2\u4f24\u6216\u8f7b\u5ea6\u5934\u75db\u7b49\u8f7b\u5ea6\u75bc\u75db\u6709\u6548\u3002\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\uff0c\u5b83\u4eec\u5b8c\u5168\u4e0d\u591f\u3002\u5c31\u50cf\u8bd5\u56fe\u6251\u706d\u68ee\u6797\u5927\u706b\u65f6\u4f7f\u7528\u4e00\u676f\u6c34\u3002\n        *   **'weak-opioid'**\uff08\u4f8b\u5982\uff0c\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff1a\u8fd9\u4e9b\u836f\u7269\u9002\u7528\u4e8e\u4e2d\u5ea6\u75bc\u75db\uff0c\u6bd4\u5982\u7b80\u5355\u7684\u9aa8\u6298\uff08\u5982\u624b\u6307\u9aa8\u6298\uff09\u6216\u4e25\u91cd\u626d\u4f24\u3002\u5bf9\u4e8e\u80a1\u9aa8\u5e72\u9aa8\u6298\u6765\u8bf4\uff0c\u5b83\u4eec\u540c\u6837\u53ef\u80fd\u836f\u6548\u4e0d\u8db3\u3002\n        *   **'strong-opioid'**\uff08\u4f8b\u5982\uff0c\u5417\u5561\u3001\u82ac\u592a\u5c3c\u3001\u6c22\u5417\u5561\u916e\uff09\uff1a\u8fd9\u662f\u4e25\u91cd\u6025\u6027\u521b\u4f24\u6027\u75bc\u75db\u7684\u6b63\u786e\u9009\u62e9\u3002\u8fd9\u4e9b\u836f\u7269\u8db3\u591f\u5f3a\u5927\uff0c\u80fd\u591f\u4e3a\u8fd9\u6837\u7684\u635f\u4f24\u63d0\u4f9b\u6709\u610f\u4e49\u7684\u9547\u75db\uff0c\u8fd9\u5bf9\u4e8e\u60a3\u8005\u8212\u9002\u5ea6\u4ee5\u53ca\u5141\u8bb8\u8fdb\u884c\u5176\u4ed6\u5fc5\u8981\u7684\u64cd\u4f5c\uff08\u5982\u653e\u7f6e\u5939\u677f\u3001\u8fdb\u884cCT\u626b\u63cf\u6216\u51c6\u5907\u624b\u672f\uff09\u81f3\u5173\u91cd\u8981\u3002\u5fc3\u52a8\u8fc7\u901f\u4e5f\u662f\u4f7f\u7528\u5f3a\u6548\u9547\u75db\u5242\u7684\u9002\u5e94\u75c7\uff0c\u4ee5\u7f13\u89e3\u75bc\u75db\u5f15\u8d77\u7684\u5e94\u6fc0\u53cd\u5e94\u3002\n        *   **\u7ed3\u8bba\uff1a**\u552f\u4e00\u533b\u5b66\u4e0a\u5408\u7406\u7684\u9009\u62e9\u662f'strong-opioid'\u3002\n\n    *   **`rationale`\uff1a**\n        *   \u6211\u9700\u8981\u7528\u4e00\u53e5\u8bdd\u5c06\u75bc\u75db\u8bc4\u4f30\u4e0e\u836f\u7269\u9009\u62e9\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u4e3a\u4ec0\u4e48\u662f8/10\u7684\u75bc\u75db\uff1f\u56e0\u4e3a\u80a1\u9aa8\u9aa8\u6298\u662f\u4e00\u79cd\u4e25\u91cd\u7684\u3001\u9ad8\u80fd\u91cf\u7684\u635f\u4f24\u3002\n        *   \u4e3a\u4ec0\u4e48\u662f\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff1f\u56e0\u4e3a\u8fd9\u662f\u6cbb\u7597\u6b64\u7c7b\u91cd\u5ea6\u521b\u4f24\u6027\u75bc\u75db\u7684\u6807\u51c6\u65b9\u6cd5\u3002\n        *   \u8ba9\u6211\u4eec\u8bd5\u7740\u628a\u5b83\u4eec\u7ed3\u5408\u8d77\u6765\u3002\n        *   *\u5c1d\u8bd51\uff1a*\u201c\u80a1\u9aa8\u9aa8\u6298\u975e\u5e38\u75db\uff0c\u6240\u4ee5\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u3002\u201d\u2014\u2014\u6709\u70b9\u592a\u7b80\u5355\u4e86\u3002\n        *   *\u5c1d\u8bd52\uff1a*\u201c\u60a3\u8005\u8868\u73b0\u51fa\u91cd\u5ea6\u75bc\u75db\u7684\u4f53\u5f81\uff0c\u4e14\u80a1\u9aa8\u5e72\u9aa8\u6298\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u6cbb\u7597\u3002\u201d\u2014\u2014\u66f4\u597d\uff0c\u66f4\u4e13\u4e1a\u3002\n        *   *\u5c1d\u