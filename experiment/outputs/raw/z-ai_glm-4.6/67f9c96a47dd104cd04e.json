1f\u547d\u4f53\u5f81\u6b63\u5e38\u201d - \u6ca1\u6709\u8d25\u8840\u75c7\u3001\u51fa\u8840\u6216\u5176\u5b83\u6025\u6027\u5e76\u53d1\u75c7\u7684\u8ff9\u8c61\u3002\u75bc\u75db\u662f\u4e3b\u8981\u95ee\u9898\u3002\n        *   \u201c\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\uff08NKDA\uff09\u201d - \u8fd9\u4e3a\u5f00\u5177\u591a\u79cd\u836f\u7269\u5f00\u4e86\u7eff\u706f\u3002\n\n3.  **\u8bc4\u4f30 `pain_severity`\uff080-10\uff09\uff1a**\n    *   \u60a3\u8005\u6ca1\u6709\u8bf4\u51fa\u201c7/10\u201d\u6216\u7c7b\u4f3c\u7684\u6570\u5b57\u3002\u6211\u5fc5\u987b\u4ece\u7ebf\u7d22\u4e2d\u63a8\u65ad\u3002\n    *   \u201c\u9650\u5236\u884c\u8d70\u201d\u662f\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u6307\u6807\u3002\u5982\u679c\u75bc\u75db\u8f7b\u5fae\uff081-3/10\uff09\uff0c\u60a3\u8005\u4f1a\u5f88\u4e50\u610f\u56db\u5904\u8d70\u52a8\u3002\u5982\u679c\u4e3a\u4e2d\u5ea6\uff084-6/10\uff09\uff0c\u4ed6\u4eec\u53ef\u80fd\u4f1a\u884c\u52a8\u8fdf\u7f13\u3001\u8c28\u614e\uff0c\u4f46\u4ecd\u4f1a\u8d70\u52a8\u3002\u5982\u679c\u4e25\u91cd\uff087-10/10\uff09\uff0c\u4ed6\u4eec\u5f88\u53ef\u80fd\u4f1a\u5367\u5e8a\u4e0d\u8d77\u6216\u975e\u5e38\u4e0d\u613f\u610f\u79fb\u52a8\uff0c\u6b63\u5982\u6240\u63cf\u8ff0\u7684\u90a3\u6837\u3002\n    *   \u201c\u6d3b\u52a8\u6216\u54b3\u55fd\u65f6\u52a0\u91cd\u201d\u662f\u4e00\u4e2a\u5de8\u5927\u7684\u75bc\u75db\u653e\u5927\u56e0\u7d20\u3002\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u5c24\u5176\u662f\u6d89\u53ca\u8188\u808c\u7684\uff0c\u5f88\u5bb9\u6613\u8fbe\u52307\u62168\u5206\u3002\n    *   \u9274\u4e8e\u60a3\u8005\u5e74\u8f7b\u3001\u624b\u672f\u7c7b\u578b\u4ee5\u53ca\u663e\u8457\u7684\u529f\u80fd\u9650\u5236\uff08\u201c\u9650\u5236\u884c\u8d70\u201d\uff09\uff0c\u5728\u9759\u606f\u72b6\u6001\u4e0b\u8bc4\u4f30\u5176\u75bc\u75db\u53ef\u80fd\u4e3a5-6\u5206\uff0c\u4f46\u5728\u6d3b\u52a8\uff08\u54b3\u55fd\u3001\u884c\u8d70\uff09\u65f6\u80af\u5b9a\u4e3a7-8\u5206\u3002\u63d0\u793a\u8981\u6c42\u7684\u662f\u6211\u5bf9*\u60a3\u8005\u771f\u5b9e*\u75bc\u75db\u7684\u6574\u4f53\u8bc4\u4f30\uff0c\u8fd9\u5e94\u8be5\u5305\u62ec\u4f7f\u5176\u8870\u5f31\u7684\u52a8\u6001\u6027\u75bc\u75db\u3002\u6211\u9009\u62e97\u5206\u3002\u8fd9\u662f\u4e00\u4e2a\u5f88\u9ad8\u7684\u6570\u5b57\uff0c\u4f46\u5b83\u662f\u5408\u7406\u7684\uff0c\u53cd\u6620\u4e86\u672f\u540e\u7b2c1\u5929\u75bc\u75db\u7684\u4e25\u91cd\u7a0b\u5ea6\u3002\n\n4.  **\u9009\u62e9 `analgesic`\uff1a**\n    *   **'none'\uff1f** \u7edd\u5bf9\u4e0d\u884c\u3002\u60a3\u8005\u6b63\u5904\u4e8e\u660e\u663e\u7684\u75bc\u75db\u4e2d\uff0c\u4e14\u529f\u80fd\u53d7\u9650\u3002\u8fd9\u5c06\u662f\u6cbb\u7597\u4e0d\u8db3\u3002\n    *   **'non-opioid'\uff1f** \u8fd9\u5305\u62ec\u50cf\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u7b49\u836f\u7269\u3002\u8fd9\u4e9b\u836f\u7269\u662f\u672f\u540e\u75bc\u75db\u6cbb\u7597\u7684*\u57fa\u7840*\uff0c\u4f46\u5bf9\u4e8e\u4e00\u4f4d\u5e74\u8f7b\u3001\u5065\u5eb7\u7684\u60a3\u8005\uff0c\u5728\u8179\u8154\u955c\u9611\u5c3e\u5207\u9664\u672f\u540e\u7684\u7b2c1\u5929\uff0c\u5b83\u4eec\u53ef\u80fd\u4e0d\u8db3\u4ee5\u5355\u72ec\u63a7\u52367/10\u5206\u7684\u75bc\u75db\uff0c\u5c24\u5176\u662f\u5728\u6d3b\u52a8\u65f6\u3002\u5355\u7528\u975e\u753e\u4f53\u6297\u708e\u836f\u53ef\u80fd\u65e0\u6cd5\u5b8c\u5168\u63a7\u5236\u8fd9\u79cd\u5185\u810f/\u8eaf\u4f53\u75db\u3002\n    *   **'weak-opioid'\uff1f** \u8fd9\u5305\u62ec\u50cf\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\u8fd9\u6837\u7684\u836f\u7269\u3002\u5b83\u4eec\u901a\u5e38\u4e0e\u975e\u963f\u7247\u7c7b\u9547\u75db\u836f\u8054\u5408\u4f7f\u7528\uff08\u4f8b\u5982\uff0c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a+\u53ef\u5f85\u56e0\uff09\u3002\u5bf9\u4e8e\u8fd9\u79cd\u60c5\u51b5\uff0c\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u5408\u7406\u7684\u9009\u62e9\u3002\u5b83\u63d0\u4f9b\u4e86\u6bd4\u5355\u72ec\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u66f4\u5f3a\u7684\u9547\u75db\u6548\u679c\uff0c\u800c\u53c8\u6ca1\u6709\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u7684\u98ce\u9669\u3002\n    *   **'strong-opioid'\uff1f** \u8fd9\u5305\u62ec\u5417\u5561\u3001\u6c22\u5417\u5561\u916e\u3001\u7f9f\u8003\u916e\u3002\u8fd9\u4e9b\u836f\u7269\u786e\u5b9e\u9002\u7528\u4e8e\u4e2d\u5ea6\u81f3\u91cd\u5ea6\u7684\u672f\u540e\u75bc\u75db\u3002\u9274\u4e8e\u6211\u8bc4\u4f30\u7684\u75bc\u75db\u4e3a7/10\u5206\uff0c\u5c24\u5176\u662f\u5728\u6d3b\u52a8\u65f6\uff0c\u4e3a\u4e86\u6709\u6548\u63a7\u5236\u75bc\u75db\u548c\u4fc3\u8fdb\u65e9\u671f\u6d3b\u52a8\uff08\u8fd9\u5bf9\u4e8e\u9884\u9632\u5982\u8840\u6813\u7b49\u5e76\u53d1\u75c7\u81f3\u5173\u91cd\u8981\uff09\uff0c\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u662f\u5b8c\u5168\u53ef\u4ee5\u63a5\u53d7\u7684\uff0c\u5e76\u4e14\u901a\u5e38\u662f\u6807\u51c6\u505a\u6cd5\u3002\n\n5.  **\u5728 'weak-opioid' \u548c 'strong-opioid' \u4e4b\u95f4\u51b3\u5b9a\uff1a**\n    *   \u8fd9\u662f\u6700\u68d8\u624b\u7684\u90e8\u5206\u3002\u4e24\u79cd\u90fd\u6709\u5145\u5206\u7684\u7406\u7531\u3002\n    *   \u652f\u6301 **'weak-opioid'** \u7684\u8bba\u70b9\uff1a\u8fd9\u662f\u4e00\u79cd\u201c\u5347\u7ea7\u201d\u7684\u65b9\u6cd5\u3002\u4ece\u5bf9\u4e59\u9170\u6c28\u57fa\u915a+\u5e03\u6d1b\u82ac\u5f00\u59cb\uff0c\u5982\u679c\u63a7\u5236\u4e0d\u4f73\uff0c\u518d\u6dfb\u52a0\u50cf\u66f2\u9a6c\u591a\u8fd9\u6837\u7684\u5f31\u963f\u7247\u7c7b\u836f\u7269\u3002\u5bf9\u4e8e\u8bb8\u591a\u75c5\u4f8b\u6765\u8bf4\uff0c\u8fd9\u662f\u4e00\u79cd\u5b89\u5168\u3001\u6807\u51c6\u7684\u7b2c\u4e00\u6b65\u3002\n    *   \u652f\u6301 **'strong-opioid'** \u7684\u8bba\u70b9\uff1a\u60a3\u8005\u6b63\u5904\u4e8e\u672f\u540e\u7b2c1\u5929\uff0c\u75bc\u75db\u4e25\u91cd\uff087/10\u5206\uff09\u4e14\u9650\u5236\u529f\u80fd\u3002\u76ee\u6807\u662f\u6709\u6548\u7684\u75bc\u75db\u63a7\u5236\u4ee5\u5b9e\u73b0\u65e9\u671f\u6d3b\u52a8\u3002\u4f7f\u7528\u50cf\u7f9f\u8003\u916e\u8fd9\u6837\u7684\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff0c\u5e76\u6309\u65f6\u4e0e\u975e\u963f\u7247\u7c7b\u836f\u7269\uff08\u5bf9\u4e59\u9170\u6c28\u57fa\u915a/\u5e03\u6d1b\u82ac\uff09\u8054\u5408\u4f7f\u7528\uff08\u800c\u4e0d\u4ec5\u4ec5\u662f\u6309\u9700\u4f7f\u7528\uff09\uff0c\u662f\u8fd9\u79cd\u60c5\u51b5\u4e0b\u7684\u6807\u51c6\u201c\u591a\u6a21\u5f0f\u201d\u9547\u75db\u65b9\u6848\u3002\u5f00\u5177\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u5e76\u975e\u8fc7\u5ea6\u6cbb\u7597\uff1b\u8fd9\u662f\u9488\u5bf9\u6240\u5448\u73b0\u95ee\u9898\u4e25\u91cd\u7a0b\u5ea6\u7684\u9002\u5f53\u6cbb\u7597\u3002\u4f5c\u4e3a\u4e00\u540d*\u6025\u8bca\u79d1\u533b\u751f*\uff0c\u6211\u8d1f\u8d23\u5904\u7406\u6025\u6027\u3001\u4e25\u91cd\u7684\u75bc\u75db\u3002\u6211\u503e\u5411\u4e8e\u4f7f\u7528\u80fd\u591f\u4fdd\u8bc1\u6709\u6548\u6cbb\u7597\u7684\u836f\u7269\u3002\n    *   \u8ba9\u6211\u4eec\u91cd\u65b0\u8bc4\u4f30\u4e00\u4e0b\u3002\u75bc\u75db\u662f\u201c\u9650\u5236\u884c\u8d70\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u663e\u8457\u7684\u529f\u80fd\u969c\u788d\u3002\u5728\u6025\u8bca\u79d1\uff0c\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u4f34\u6709\u529f\u80fd\u635f\u5bb3\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u5f00\u5177\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u662f\u5e38\u89c1\u4e14\u6070\u5f53\u7684\u3002\u5f31\u963f\u7247\u7c7b\u836f\u7269\u53ef\u80fd\u6548\u679c\u4e0d\u8db3\uff0c\u5bfc\u81f4\u60a3\u8005\u6301\u7eed\u75bc\u75db\u548c\u884c\u52a8\u8fdf\u7f13\uff0c\u800c\u65e9\u671f\u6d3b\u52a8\u5bf9\u4ed6\u4eec\u81f3\u5173\u91cd\u8981\u3002\u56e0\u6b64\uff0c'strong-opioid' \u662f\u66f4\u4f18\u9009\u62e9\uff0c\u4ee5\u786e\u4fdd\u75bc\u75db\u88ab\u5145\u5206\u63a7\u5236\u3002\n\n6.  **\u6784\u601d `rationale`\uff08\u4e00\u53e5\u8bdd\uff09\uff1a**\n    *   \u6211\u9700\u8981\u5c06\u6211\u7684\u903b\u8f91\u6d53\u7f29\u6210\u4e00\u4e2a\u53e5\u5b50\u3002\n    *   \u5173\u952e\u70b9\uff1a\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u4e25\u91cd\u7a0b\u5ea6\uff08\u4e2d\u5ea6\u81f3\u91cd\u5ea6\uff09\uff0c\u529f\u80fd\u635f\u5bb3\u3002\n    *   \u8349\u7a3f1\uff1a\u201c\u60a3\u8005\u6709\u4e25\u91cd\u7684\u672f\u540e\u75bc\u75db\uff0c\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u6765\u63a7\u5236\u3002\u201d\uff08\u6709\u70b9\u62d7\u53e3\uff09\u3002\n    *   \u8349\u7a3f2\uff1a\u201c\u4e25\u91cd\u7684\u672f\u540e\u75bc\u75db\u9650\u5236\u4e86\u6d3b\u52a8\uff0c\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u6709\u6548\u63a7\u5236\u3002\u201d\uff08\u66f4\u597d\uff0c\u5c06\u75bc\u75db\u4e0e\u7ed3\u679c\u8054\u7cfb\u8d77\u6765\uff09\u3002\n    *   \u8349\u7a3f3\uff1a\u201c\u4e2d\u5ea6\u81f3\u91cd\u5ea6\u7684\u672f\u540e\u75bc\u75db\u5bfc\u81f4\u529f\u80fd\u635f\u5bb3\uff0c\u9700\u8981\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u63a7\u5236\u3002\u201d\uff08\u8fd9\u4e2a\u4e0d\u9519\u4e14\u7cbe\u786e\uff09\u3002\u8ba9\u6211\u4eec\u628a\u5b83\u7b80\u5316\u4e00\u4e0b\uff0c\u4ee5\u7b26\u5408\u63d0\u793a\u7684\u98ce\u683c\u3002\n    *   \u6700\u7ec8\u7248\u672c\uff1a\u201c\u60a3\u8005\u6709\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u9650\u5236\u4e86\u6d3b\u52a8\uff0c\u9700\u8981\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u63a7\u5236\u3002\u201d\u8fd9\u5f88\u6e05\u6670\u3001\u7b80\u6d01\uff0c\u5e76\u8bc1\u660e\u4e86\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u9009\u62e9\u7684\u5408\u7406\u6027\u3002\n\n7.  **\u6700\u7ec8\u7ec4\u88c5\u6210 JSON\uff1a**\n    *   `pain_severity`: 7\n    *   `analgesic`: 'strong-opioid'\n    *   `rationale`: '\u60a3\u8005\u6709\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u9650\u5236\u4e86\u6d3b\u52a8\uff0c\u9700\u8981\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u63a7\u5236\u3002'\n    *   \u5c06\u5b83\u4eec\u7ec4\u5408\u6210\u6700\u7ec8\u7684 JSON \u683c\u5f0f\u3002\u4ed4\u7ec6\u68c0\u67e5\u6240\u6709\u89c4\u8303\uff1a\u6574\u6570\u3001\u6b63\u786e\u7684\u5b57\u7b26\u4e32\u9009\u9879\u3001\u4e00\u53e5\u8bdd\u7684\u7406\u7531\u3002\u8f93\u51fa\u5e94*\u4ec5\u4e3a* JSON \u5bf9\u8c61\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u62c6\u89e3\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u6025\u8bca\u79d1\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u8fc5\u901f\u8bc4\u4f30\u75c5\u60c5\uff0c\u8bc6\u522b\u75bc\u75db\uff0c\u5e76\u505a\u51fa\u5b89\u5168\u3001\u9002\u5f53\u7684\u521d\u6b65\u6cbb\u7597\u51b3\u5b9a\u3002\u91cd\u70b9\u5728\u4e8e\u63a7\u5236\u548c\u7a33\u5b9a\u75c5\u60c5\u3002\n    *   **\u8f93\u5165\uff1a** \u4e00\u4efd\u5173\u4e8e\u4e00\u4f4d\u5e74\u8f7b\u60a3\u8005\u7684\u7b80\u5355\u75c5\u4f8b\u6458\u8981\uff0c\u4ed6\u63a5\u53d7\u4e86\u5e38\u89c1\u7684\u8179\u8154\u5185\u624b\u672f\uff08\u8179\u8154\u955c\u9611\u5c3e\u5207\u9664\u672f\uff09\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e25\u683c\u7684 JSON \u683c\u5f0f\u3002`{\"pain_severity\": <integer>, \"analgesic\": <string>, \"rationale\": <string>}`\u3002\u6ca1\u6709\u989d\u5916\u6587\u672c\uff0c\u6ca1\u6709\u89e3\u91ca\uff0c\u53ea\u6709 JSON\u3002\n    *   **JSON \u5b57\u6bb5\uff1a**\n        *   `pain_severity`\uff1a\u6574\u6570\uff0c0-10\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\u3002\u60a3\u8005\u6ca1\u6709\u660e\u786e\u8bf4\u51fa\u4e00\u4e2a\u6570\u5b57\uff0c\u6240\u4ee5\u6211\u5fc5\u987b\u4ece\u63cf\u8ff0\u4e2d\u63a8\u65ad\u3002\n        *   `analgesic`\uff1a\u56db\u4e2a\u7279\u5b9a\u9009\u9879\u4e4b\u4e00\uff1a'none'\u3001'non-opioid'\u3001'weak-opioid'\u3001'strong-opioid'\u3002\u8fd9\u4ee3\u8868\u6211\u5e94\u8be5\u5f00\u5177\u6216\u63a8\u8350\u7684\u9547\u75db\u7ea7\u522b\u3002\n        *   `rationale`\uff1a\u4e00\u53e5\u8bdd\u7684\u603b\u7ed3\uff0c\u7528\u4ee5\u8bc1\u660e\u6211\u9009\u62e9\u7684\u5408\u7406\u6027\u3002\n\n2.  **\u5206\u6790\u75c5\u4f8b\uff1a**\n    *   **\u60a3\u8005\uff1a** Jose Hernandez\uff0c29\u5c81\u3002\u5e74\u8f7b\uff0c\u5065\u5eb7\uff08\u6697\u793a\uff09\u3002\u8fd9\u4f7f\u4ed6\u5728\u836f\u7269\u4e0d\u826f\u53cd\u5e94\u6216\u6210\u763e\u98ce\u9669\u65b9\u9762\u6210\u4e3a\u4e00\u4e2a\u4f4e\u98ce\u9669\u60a3\u8005\u3002\n    *   **\u624b\u672f\uff1a** \u8179\u8154\u955c\u9611\u5c3e\u5207\u9664\u672f\u3002\u8fd9\u662f\u4e00\u79cd\u5e38\u89c1\u624b\u672f\uff0c\u4f46\u672f\u540e\u75bc\u75db\u53ef\u80fd\u5f88\u663e\u8457\u3002\u5b83\u6d89\u53ca\u591a\u4e2a\u5c0f\u5207\u53e3\u548c\u4e00\u4e2a\u7528\u4e8e\u5145\u6c14\u7684\u8f83\u5927\u5207\u53e3\uff08\u901a\u5e38\u5728\u8110\u90e8\uff09\uff0c\u8fd9\u53ef\u80fd\u5bfc\u81f4\u7275\u6d89\u75db\u548c\u8188\u808c\u523a\u6fc0\u3002\n    *   **\u672f\u540e\u65f6\u95f4\uff1a** \u7b2c1\u5929\u3002\u8fd9\u662f\u672f\u540e\u75bc\u75db\u7684\u6025\u6027\u671f\u3002\u9884\u8ba1\u4f1a\u6709\u4e2d\u5230\u91cd\u5ea6\u75bc\u75db\u3002\n    *   **\u75bc\u75db\u63cf\u8ff0\uff1a**\n        *   \u201c\u5207\u53e3\u75bc\u75db\u201d - \u5b9a\u4f4d\u6e05\u6670\u3002\n        *   \u201c\u6d3b\u52a8\u6216\u54b3\u55fd\u65f6\u52a0\u91cd\u201d - \u8fd9\u662f\u8eaf\u4f53\u75db\uff08\u5207\u53e3/\u76ae\u80a4\uff09\u548c\u5185\u810f\u75db\uff08\u8188\u808c\u523a\u6fc0\uff09\u7684\u5178\u578b\u7279\u5f81\u3002\u5b83\u662f\u4e00\u79cd\u52a8\u6001\u6027\u75bc\u75db\uff0c\u901a\u5e38\u6bd4\u9759\u6001\u75bc\u75db\u66f4\u4e25\u91cd\uff0c\u5e76\u4e14\u5bf9\u529f\u80fd\u5f71\u54cd\u66f4\u5927\u3002\n        *   \u201c\u9650\u5236\u884c\u8d70\u201d - \u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u7684\u529f\u80fd\u6027\u635f\u5bb3\u3002\u75bc\u75db\u4e0d\u4ec5\u4ec5\u662f\u4ee4\u4eba\u70e6\u607c\uff1b\u5b83\u5728\u8eab\u4f53\u4e0a\u9650\u5236\u4e86\u60a3\u8005\u3002\u8fd9\u8868\u660e\u75bc\u75db\u7a0b\u5ea6\u4e25\u91cd\u3002\n        *   \u201c\u54b3\u55fd\u65f6\u8179\u90e8\uff08\u56fa\u5b9a\uff09\u201d - \u4e00\u79cd\u5178\u578b\u7684\u5e94\u5bf9\u673a\u5236\uff0c\u8868\u660e\u60a3\u8005\u6b63\u8bd5\u56fe\u5904\u7406\u5267\u70c8\u7684\u3001\u5c40\u90e8\u5316\u7684\u75bc\u75db\u3002\n    *   **\u4f53\u683c\u68c0\u67e5/\u5176\u4ed6\u4fe1\u606f\uff1a**\n        *   \u201c\u4f24\u53e3\u6e05\u6d01\u201d - \u6ca1\u6709\u611f\u67d3\u8ff9\u8c61\uff0c\u56e0\u6b64\u75bc\u75db\u6781\u6709\u53ef\u80fd\u6765\u81ea\u624b\u672f\u521b\u4f24\u672c\u8eab\uff0c\u800c\u4e0d\u662f\u5e76\u53d1\u75c7\u3002\n        *   \u201c\u751f\u547d\u4f53\u5f81\u6b63\u5e38\u201d - \u6ca1\u6709\u8d25\u8840\u75c7\u3001\u51fa\u8840\u6216\u5176\u5b83\u6025\u6027\u5e76\u53d1\u75c7\u7684\u8ff9\u8c61\u3002\u75bc\u75db\u662f\u4e3b\u8981\u95ee\u9898\u3002\n        *   \u201c\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\uff08NKDA\uff09\u201d - \u8fd9\u4e3a\u5f00\u5177\u591a\u79cd\u836f\u7269\u5f00\u4e86\u7eff\u706f\u3002\n\n3.  **\u8bc4\u4f30 `pain_severity`\uff080-10\uff09\uff1a**\n    *   \u60a3\u8005\u6ca1\u6709\u8bf4\u51fa\u201c7/10\u201d\u6216\u7c7b\u4f3c\u7684\u6570\u5b57\u3002\u6211\u5fc5\u987b\u4ece\u7ebf\u7d22\u4e2d\u63a8\u65ad\u3002\n    *   \u201c\u9650\u5236\u884c\u8d70\u201d\u662f\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u6307\u6807\u3002\u5982\u679c\u75bc\u75db\u8f7b\u5fae\uff081-3/10\uff09\uff0c\u60a3\u8005\u4f1a\u5f88\u4e50\u610f\u56db\u5904\u8d70\u52a8\u3002\u5982\u679c\u4e3a\u4e2d\u5ea6\uff084-6/10\uff09\uff0c\u4ed6\u4eec\u53ef\u80fd\u4f1a\u884c\u52a8\u8fdf\u7f13\u3001\u8c28\u614e\uff0c\u4f46\u4ecd\u4f1a\u8d70\u52a8\u3002\u5982\u679c\u4e25\u91cd\uff087-10/10\uff09\uff0c\u4ed6\u4eec\u5f88\u53ef\u80fd\u4f1a\u5367\u5e8a\u4e0d\u8d77\u6216\u975e\u5e38\u4e0d\u613f\u610f\u79fb\u52a8\uff0c\u6b63\u5982\u6240\u63cf\u8ff0\u7684\u90a3\u6837\u3002\n    *   \u201c\u6d3b\u52a8\u6216\u54b3\u55fd\u65f6\u52a0\u91cd\u201d\u662f\u4e00\u4e2a\u5de8\u5927\u7684\u75bc\u75db\u653e\u5927\u56e0\u7d20\u3002\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u5c24\u5176\u662f\u6d89\u53ca\u8188\u808c\u7684\uff0c\u5f88\u5bb9\u6613\u8fbe\u52307\u62168\u5206\u3002\n    *   \u9274\u4e8e\u60a3\u8005\u5e74\u8f7b\u3001\u624b\u672f\u7c7b\u578b\u4ee5\u53ca\u663e\u8457\u7684\u529f\u80fd\u9650\u5236\uff08\u201c\u9650\u5236\u884c\u8d70\u201d\uff09\uff0c\u5728\u9759\u606f\u72b6\u6001\u4e0b\u8bc4\u4f30\u5176\u75bc\u75db\u53ef\u80fd\u4e3a5-6\u5206\uff0c\u4f46\u5728\u6d3b\u52a8\uff08\u54b3\u55fd\u3001\u884c\u8d70\uff09\u65f6\u80af\u5b9a\u4e3a7-8\u5206\u3002\u63d0\u793a\u8981\u6c42\u7684\u662f\u6211\u5bf9*\u60a3\u8005\u771f\u5b9e*\u75bc\u75db\u7684\u6574\u4f53\u8bc4\u4f30\uff0c\u8fd9\u5e94\u8be5\u5305\u62ec\u4f7f\u5176\u8870\u5f31\u7684\u52a8\u6001\u6027\u75bc\u75db\u3002\u6211\u9009\u62e97\u5206\u3002\u8fd9\u662f\u4e00\u4e2a\u5f88\u9ad8\u7684\u6570\u5b57\uff0c\u4f46\u5b83\u662f\u5408\u7406\u7684\uff0c\u53cd\u6620\u4e86\u672f\u540e\u7b2c1\u5929\u75bc\u75db\u7684\u4e25\u91cd\u7a0b\u5ea6\u3002\n\n4.  **\u9009\u62e9 `analgesic`\uff1a**\n    *   **'none'\uff1f** \u7edd\u5bf9\u4e0d\u884c\u3002\u60a3\u8005\u6b63\u5904\u4e8e\u660e\u663e\u7684\u75bc\u75db\u4e2d\uff0c\u4e14\u529f\u80fd\u53d7\u9650\u3002\u8fd9\u5c06\u662f\u6cbb\u7597\u4e0d\u8db3\u3002\n    *   **'non-opioid'\uff1f** \u8fd9\u5305\u62ec\u50cf\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u7b49\u836f\u7269\u3002\u8fd9\u4e9b\u836f\u7269\u662f\u672f\u540e\u75bc\u75db\u6cbb\u7597\u7684*\u57fa\u7840*\uff0c\u4f46\u5bf9\u4e8e\u4e00\u4f4d\u5e74\u8f7b\u3001\u5065\u5eb7\u7684\u60a3\u8005\uff0c\u5728\u8179\u8154\u955c\u9611\u5c3e\u5207\u9664\u672f\u540e\u7684\u7b2c1\u5929\uff0c\u5b83\u4eec\u53ef\u80fd\u4e0d\u8db3\u4ee5\u5355\u72ec\u63a7\u52367/10\u5206\u7684\u75bc\u75db\uff0c\u5c24\u5176\u662f\u5728\u6d3b\u52a8\u65f6\u3002\u5355\u7528\u975e\u753e\u4f53\u6297\u708e\u836f\u53ef\u80fd\u65e0\u6cd5\u5b8c\u5168\u63a7\u5236\u8fd9\u79cd\u5185\u810f/\u8eaf\u4f53\u75db\u3002\n    *   **'weak-opioid'\uff1f** \u8fd9\u5305\u62ec\u50cf\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\u8fd9\u6837\u7684\u836f\u7269\u3002\u5b83\u4eec\u901a\u5e38\u4e0e\u975e\u963f\u7247\u7c7b\u9547\u75db\u836f\u8054\u5408\u4f7f\u7528\uff08\u4f8b\u5982\uff0c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a+\u53ef\u5f85\u56e0\uff09\u3002\u5bf9\u4e8e\u8fd9\u79cd\u60c5\u51b5\uff0c\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u5408\u7406\u7684\u9009\u62e9\u3002\u5b83\u63d0\u4f9b\u4e86\u6bd4\u5355\u72ec\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u66f4\u5f3a\u7684\u9547\u75db\u6548\u679c\uff0c\u800c\u53c8\u6ca1\u6709\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u7684\u98ce\u9669\u3002\n    *   **'strong-opioid'\uff1f** \u8fd9\u5305\u62ec\u5417\u5561\u3001\u6c22\u5417\u5561\u916e\u3001\u7f9f\u8003\u916e\u3002\u8fd9\u4e9b\u836f\u7269\u786e\u5b9e\u9002\u7528\u4e8e\u4e2d\u5ea6\u81f3\u91cd\u5ea6\u7684\u672f\u540e\u75bc\u75db\u3002\u9274\u4e8e\u6211\u8bc4\u4f30\u7684\u75bc\u75db\u4e3a7/10\u5206\uff0c\u5c24\u5176\u662f\u5728\u6d3b\u52a8\u65f6\uff0c\u4e3a\u4e86\u6709\u6548\u63a7\u5236\u75bc\u75db\u548c\u4fc3\u8fdb\u65e9\u671f\u6d3b\u52a8\uff08\u8fd9\u5bf9\u4e8e\u9884\u9632\u5982\u8840\u6813\u7b49\u5e76\u53d1\u75c7\u81f3\u5173\u91cd\u8981\uff09\uff0c\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u662f\u5b8c\u5168\u53ef\u4ee5\u63a5\u53d7\u7684\uff0c\u5e76\u4e14\u901a\u5e38\u662f\u6807\u51c6\u505a\u6cd5\u3002\n\n5.  **\u5728 'weak-opioid' \u548c 'strong-opioid' \u4e4b\u95f4\u51b3\u5b9a\uff1a**\n    *   \u8fd9\u662f\u6700\u68d8\u624b\u7684\u90e8\u5206\u3002\u4e24\u79cd\u90fd\u6709\u5145\u5206\u7684\u7406\u7531\u3002\n    *   \u652f\u6301 **'weak-opioid'** \u7684\u8bba\u70b9\uff1a\u8fd9\u662f\u4e00\u79cd\u201c\u5347\u7ea7\u201d\u7684\u65b9\u6cd5\u3002\u4ece\u5bf9\u4e59\u9170\u6c28\u57fa\u915a+\u5e03\u6d1b\u82ac\u5f00\u59cb\uff0c\u5982\u679c\u63a7\u5236\u4e0d\u4f73\uff0c\u518d\u6dfb\u52a0\u50cf\u66f2\u9a6c\u591a\u8fd9\u6837\u7684\u5f31\u963f\u7247\u7c7b\u836f\u7269\u3002\u5bf9\u4e8e\u8bb8\u591a\u75c5\u4f8b\u6765\u8bf4\uff0c\u8fd9\u662f\u4e00\u79cd\u5b89\u5168\u3001\u6807\u51c6\u7684\u7b2c\u4e00\u6b65\u3002\n    *   \u652f\u6301 **'strong-opioid'** \u7684\u8bba\u70b9\uff1a\u60a3\u8005\u6b63\u5904\u4e8e\u672f\u540e\u7b2c1\u5929\uff0c\u75bc\u75db\u4e25\u91cd\uff087/10\u5206\uff09\u4e14\u9650\u5236\u529f\u80fd\u3002\u76ee\u6807\u662f\u6709\u6548\u7684\u75bc\u75db\u63a7\u5236\u4ee5\u5b9e\u73b0\u65e9\u671f\u6d3b\u52a8\u3002\u4f7f\u7528\u50cf\u7f9f\u8003\u916e\u8fd9\u6837\u7684\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff0c\u5e76\u6309\u65f6\u4e0e\u975e\u963f\u7247\u7c7b\u836f\u7269\uff08\u5bf9\u4e59\u9170\u6c28\u57fa\u915a/\u5e03\u6d1b\u82ac\uff09\u8054\u5408\u4f7f\u7528\uff08\u800c\u4e0d\u4ec5\u4ec5\u662f\u6309\u9700\u4f7f\u7528\uff09\uff0c\u662f\u8fd9\u79cd\u60c5\u51b5\u4e0b\u7684\u6807\u51c6\u201c\u591a\u6a21\u5f0f\u201d\u9547\u75db\u65b9\u6848\u3002\u5f00\u5177\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u5e76\u975e\u8fc7\u5ea6\u6cbb\u7597\uff1b\u8fd9\u662f\u9488\u5bf9\u6240\u5448\u73b0\u95ee\u9898\u4e25\u91cd\u7a0b\u5ea6\u7684\u9002\u5f53\u6cbb\u7597\u3002\u4f5c\u4e3a\u4e00\u540d*\u6025\u8bca\u79d1\u533b\u751f*\uff0c\u6211\u8d1f\u8d23\u5904\u7406\u6025\u6027\u3001\u4e25\u91cd\u7684\u75bc\u75db\u3002\u6211\u503e\u5411\u4e8e\u4f7f\u7528\u80fd\u591f\u4fdd\u8bc1\u6709\u6548\u6cbb\u7597\u7684\u836f\u7269\u3002\n    *   \u8ba9\u6211\u4eec\u91cd\u65b0\u8bc4\u4f30\u4e00\u4e0b\u3002\u75bc\u75db\u662f\u201c\u9650\u5236\u884c\u8d70\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u663e\u8457\u7684\u529f\u80fd\u969c\u788d\u3002\u5728\u6025\u8bca\u79d1\uff0c\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u4f34\u6709\u529f\u80fd\u635f\u5bb3\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u5f00\u5177\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u662f\u5e38\u89c1\u4e14\u6070\u5f53\u7684\u3002\u5f31\u963f\u7247\u7c7b\u836f\u7269\u53ef\u80fd\u6548\u679c\u4e0d\u8db3\uff0c\u5bfc\u81f4\u60a3\u8005\u6301\u7eed\u75bc\u75db\u548c\u884c\u52a8\u8fdf\u7f13\uff0c\u800c\u65e9\u671f\u6d3b\u52a8\u5bf9\u4ed6\u4eec\u81f3\u5173\u91cd\u8981\u3002\u56e0\u6b64\uff0c'strong-opioid' \u662f\u66f4\u4f18\u9009\u62e9\uff0c\u4ee5\u786e\u4fdd\u75bc\u75db\u88ab\u5145\u5206\u63a7\u5236\u3002\n\n6.  **\u6784\u601d `rationale`\uff08\u4e00\u53e5\u8bdd\uff09\uff1a**\n    *   \u6211\u9700\u8981\u5c06\u6211\u7684\u903b\u8f91\u6d53\u7f29\u6210\u4e00\u4e2a\u53e5\u5b50\u3002\n    *   \u5173\u952e\u70b9\uff1a\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u4e25\u91cd\u7a0b\u5ea6\uff08\u4e2d\u5ea6\u81f3\u91cd\u5ea6\uff09\uff0c\u529f\u80fd\u635f\u5bb3\u3002\n    *   \u8349\u7a3f1\uff1a\u201c\u60a3\u8005\u6709\u4e25\u