0c5\uff1a**\n        *   **\u60a3\u8005\uff1a**45\u5c81\u9ed1\u4eba\u7537\u6027\u3002\uff08\u79cd\u65cf\u5728\u6b64\u5904\u901a\u5e38\u4e0e\u75bc\u75db\u7ba1\u7406\u65e0\u5173\uff0c\u4f46\u5e74\u9f84\u76f8\u5173\uff09\u3002\n        *   **\u635f\u4f24\u673a\u5236\uff1a**\u4ece\u68af\u5b50\u4e0a\u6454\u4e0b\u3002\u9ad8\u80fd\u91cf\u635f\u4f24\u3002\n        *   **\u4f53\u683c\u68c0\u67e5\uff1a**\u53f3\u5927\u817f\u7578\u5f62\u548c\u80bf\u80c0\u3002X \u5149\u7247\u8bc1\u5b9e\u4e3a\u95ed\u5408\u6027\u80a1\u9aa8\u5e72\u4e2d\u6bb5\u9aa8\u6298\u3002\n        *   **\u75bc\u75db\u8868\u73b0\uff1a**\u201c\u4fdd\u62a4\u60a3\u80a2\uff0c\u79fb\u52a8\u65f6\u547b\u541f\u3002\u201d\u8fd9\u662f\u4e25\u91cd\u75bc\u75db\u7684\u660e\u786e\u6307\u6807\u3002\u4fdd\u62a4\u662f\u4e00\u79cd\u975e\u8bed\u8a00\u7684\u75bc\u75db\u884c\u4e3a\u3002\u547b\u541f\u4e5f\u662f\u5982\u6b64\u3002\n        *   **\u751f\u547d\u4f53\u5f81\uff1a**HR 112\uff08\u5fc3\u52a8\u8fc7\u901f\uff0c\u901a\u5e38\u662f\u5bf9\u75bc\u75db\u548c/\u6216\u538b\u529b\u7684\u53cd\u5e94\uff09\u3002BP 136/84\uff08\u8840\u538b\u6b63\u5e38\u6216\u8f7b\u5ea6\u5347\u9ad8\uff0c\u53ef\u80fd\u7531\u75bc\u75db/\u7126\u8651\u9a71\u52a8\uff09\u3002\u5fc3\u52a8\u8fc7\u901f\u662f\u4e00\u4e2a\u5173\u952e\u53d1\u73b0\uff0c\u5b83\u5f3a\u5316\u4e86\u75bc\u75db/\u75db\u82e6\u7684\u4e25\u91cd\u6027\u3002\n        *   **\u8fc7\u654f\u53f2\uff1a**\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\u3002\u8fd9\u662f\u4e00\u4e2a\u91cd\u8981\u4fe1\u606f\uff0c\u56e0\u4e3a\u5b83\u610f\u5473\u7740\u6211\u53ef\u4ee5\u4f7f\u7528\u4efb\u4f55\u6807\u51c6\u7684\u9547\u75db\u836f\u7269\u800c\u65e0\u9700\u62c5\u5fc3\u8fc7\u654f\u53cd\u5e94\uff08\u9664\u975e\u6709\u5176\u4ed6\u7981\u5fcc\u75c7\uff09\u3002\n\n2.  **\u62c6\u89e3\u51b3\u7b56\u8fc7\u7a0b\uff08\u4ee5\u6025\u8bca\u533b\u751f\u7684\u601d\u7ef4\u6a21\u5f0f\uff09\uff1a**\n\n    *   **`pain_severity` \u8bc4\u4f30\uff1a**\n        *   \u60a3\u8005\u6709\u80a1\u9aa8\u9aa8\u6298\u3002\u8fd9\u662f\u9aa8\u79d1\u635f\u4f24\u4e2d\u75bc\u75db\u7a0b\u5ea6\u6700\u9ad8\u7684\u4e00\u79cd\u4e4b\u4e00\u3002\u9aa8\u9abc\u3001\u9aa8\u819c\u548c\u5468\u56f4\u8f6f\u7ec4\u7ec7\u90fd\u5df2\u53d7\u635f\u3002\n        *   \u60a3\u8005\u6b63\u5728*\u4e3b\u52a8\u5730*\u8868\u73b0\u51fa\u75bc\u75db\u7684\u8ff9\u8c61\uff1a\u201c\u4fdd\u62a4\u60a3\u80a2\u201d\u548c\u201c\u79fb\u52a8\u65f6\u547b\u541f\u201d\u3002\u4ed6\u4e0d\u4ec5\u4ec5\u662f\u8bf4\u201c\u6211\u75bc\u201d\uff1b\u4ed6\u7684\u8eab\u4f53\u5728\u5c16\u53eb\u7740\u75bc\u75db\u3002\n        *   \u5fc3\u52a8\u8fc7\u901f\uff08HR 112\uff09\u662f\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u5ba2\u89c2\u4f53\u5f81\uff0c\u8868\u660e\u5b58\u5728\u663e\u8457\u7684\u751f\u7406\u5e94\u6fc0\uff0c\u8fd9\u51e0\u4e4e\u80af\u5b9a\u662f\u7531\u4e25\u91cd\u75bc\u75db\u9a71\u52a8\u7684\uff08\u5728\u6ca1\u6709\u660e\u663e\u5931\u8840\u6027\u4f11\u514b\u8ff9\u8c61\u7684\u60c5\u51b5\u4e0b\uff0c\u8003\u8651\u5230\u95ed\u5408\u6027\u9aa8\u6298\u548c\u7a33\u5b9a\u7684\u8840\u538b\uff09\u3002\n        *   \u57fa\u4e8e\u8fd9\u4e9b\u56e0\u7d20\uff0c\u75bc\u75db\u662f\u91cd\u5ea6\u81f3\u6781\u5ea6\u7684\u3002\u4e00\u4e2a 0-10 \u5206\u7684\u91cf\u8868\u5c06\u6b64\u5f52\u5165\u9ad8\u7aef\u8303\u56f4\u30028\u5206\u30019\u5206\u621610\u5206\u90fd\u662f\u5408\u7406\u7684\u3002\u6211\u5c06\u9009\u62e98\u5206\uff0c\u8fd9\u662f\u4e00\u4e2a\u201c\u91cd\u5ea6\u75bc\u75db\u201d\u7684\u8bc4\u5206\uff0c\u4e3a\u6f5c\u5728\u7684\u5267\u75db\u5347\u7ea7\u7559\u51fa\u7a7a\u95f4\uff0c\u4f46\u660e\u786e\u8868\u793a\u8fd9\u4e0d\u662f\u4e00\u4e2a\u8f7b\u5fae\u95ee\u9898\u3002\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u53ef\u4fe1\u4e14\u4e34\u5e8a\u4e0a\u5408\u7406\u7684\u6570\u5b57\u3002\n\n    *   **`analgesic` \u9009\u62e9\uff1a**\n        *   \u8ba9\u6211\u4eec\u56de\u987e\u4e00\u4e0b\u8fd9\u4e9b\u9009\u9879\uff1a\n            *   `'none'`\uff1a\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u6765\u8bf4\u662f\u7edd\u5bf9\u4e0d\u6b63\u786e\u7684\u3002\u8fd9\u5c06\u662f\u4f4e\u4e8e\u6807\u51c6\u7684\u533b\u7597\u62a4\u7406\uff0c\u4e14\u4e0d\u4eba\u9053\u3002\n            *   `'non-opioid'`\uff08\u4f8b\u5982\uff0c\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff09\uff1a\u8fd9\u4e9b\u836f\u7269\u5bf9\u4e8e\u6025\u6027\u3001\u91cd\u5ea6\u3001\u521b\u4f24\u6027\u9aa8\u6298\u75bc\u75db\u662f\u4e0d\u8db3\u7684\u3002\u5b83\u4eec\u53ef\u4ee5\u4f5c\u4e3a\u8f85\u52a9\u7528\u836f\uff0c\u4f46\u5355\u72ec\u4f7f\u7528\u8fdc\u8fdc\u4e0d\u591f\u3002\n            *   `'weak-opioid'`\uff08\u4f8b\u5982\uff0c\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff1a\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u8fd9\u4e9b\u836f\u7269\u901a\u5e38\u662f\u4e0d\u591f\u7684\u3002\u5b83\u4eec\u53ef\u80fd\u5bf9\u4e2d\u5ea6\u75bc\u75db\u6709\u6548\uff0c\u4f46\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u6765\u8bf4\uff0c\u836f\u6548\u53ef\u80fd\u4e0d\u591f\u5f3a\uff0c\u56e0\u6b64\u4e0d\u662f\u6700\u4f73\u7684\u4e00\u7ebf\u9009\u62e9\u3002\n            *   `'strong-opioid'`\uff08\u4f8b\u5982\uff0c\u5417\u5561\u3001\u82ac\u592a\u5c3c\u3001\u6c22\u5417\u5561\u916e\uff09\uff1a\u8fd9\u662f\u80a1\u9aa8\u9aa8\u6298\u7b49\u91cd\u5ea6\u6025\u6027\u521b\u4f24\u6027\u75bc\u75db\u7684\u6807\u51c6\u6cbb\u7597\u3002\u9700\u8981\u5f3a\u6548\u9547\u75db\u6765\u63a7\u5236\u75bc\u75db\u3001\u65b9\u4fbf\u8fdb\u884c\u68c0\u67e5/\u64cd\u4f5c\uff08\u5982\u653e\u7f6e\u5939\u677f\uff09\uff0c\u5e76\u63d0\u9ad8\u60a3\u8005\u7684\u8212\u9002\u5ea6\u3002\n        *   \u56e0\u6b64\uff0c\u552f\u4e00\u4e34\u5e8a\u4e0a\u5408\u7406\u7684\u9009\u62e9\u662f `'strong-opioid'`\u3002\n\n    *   **`rationale` \u5236\u5b9a\uff1a**\n        *   \u7406\u7531\u9700\u8981\u662f\u4e00\u4e2a\u5355\u53e5\uff0c\u5e76\u4e14\u5fc5\u987b\u4e3a `pain_severity` \u548c `analgesic` \u7684\u9009\u62e9\u63d0\u4f9b\u7406\u7531\u3002\n        *   \u6211\u9700\u8981\u5c06\u635f\u4f24\uff08\u80a1\u9aa8\u9aa8\u6298\uff09\u3001\u60a3\u8005\u7684\u8868\u73b0\uff08\u5ba2\u89c2\u75bc\u75db\u4f53\u5f81\uff09\u4ee5\u53ca\u6240\u9009\u7684\u6cbb\u7597\u65b9\u6848\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u4e00\u4e2a\u597d\u7684\u7406\u7531\u5e94\u8be5\u7b80\u6d01\u4e14\u4e34\u5e8a\u4e0a\u7ad9\u5f97\u4f4f\u811a\u3002\n        *   \u8349\u7a3f1\uff1a\u201c\u80a1\u9aa8\u9aa8\u6298\u975e\u5e38\u75bc\uff0c\u6240\u4ee5\u9700\u8981\u5417\u5561\u3002\u201d\u2014\u2014\u6709\u70b9\u592a\u7b80\u5355\u4e86\u3002\n        *   \u8349\u7a3f2\uff1a\u201c\u80a1\u9aa8\u9aa8\u6298\u5f15\u8d77\u7684\u91cd\u5ea6\u75bc\u75db\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u7684\u9547\u75db\u3002\u201d\u2014\u2014\u8fd9\u4e2a\u5f88\u597d\u3002\u5b83\u5f88\u4e13\u4e1a\uff0c\u4f7f\u7528\u4e86\u4e34\u5e8a\u8bed\u8a00\uff08\u201c\u91cd\u5ea6\u75bc\u75db\u201d\u3001\u201c\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u201d\u3001\u201c\u5145\u5206\u7684\u9547\u75db\u201d\uff09\uff0c\u5e76\u76f4\u63a5\u5c06\u95ee\u9898\u4e0e\u89e3\u51b3\u65b9\u6848\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u8349\u7a3f3\uff1a\u201c\u751f\u547d\u4f53\u5f81\u548c\u75bc\u75db\u8868\u73b0\u8868\u660e\u5b58\u5728\u91cd\u5ea6\u75bc\u75db\uff0c\u8fd9\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u6765\u7ba1\u7406\u80a1\u9aa8\u9aa8\u6298\u3002\u201d\u2014\u2014\u4e5f\u5f88\u597d\uff0c\u53ef\u80fd\u66f4\u8be6\u7ec6\u4e00\u4e9b\u3002\u4f46\u8349\u7a3f2\u66f4\u76f4\u63a5\uff0c\u4fa7\u91cd\u4e8e\u635f\u4f24\u672c\u8eab\uff0c\u8fd9\u662f\u75bc\u75db\u7684\u4e3b\u8981\u539f\u56e0\u3002\n        *   \u6211\u4eec\u8fd8\u662f\u91c7\u7528\u7c7b\u4f3c\u8349\u7a3f2\u7684\u8bf4\u6cd5\u3002\u6211\u5c06\u5b83\u4f18\u5316\u4e3a\uff1a\u201c\u80a1\u9aa8\u9aa8\u6298\u662f\u4e00\u79cd\u91cd\u5ea6\u521b\u4f24\u6027\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u6765\u63a7\u5236\u60a3\u8005\u660e\u663e\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u3002\u201d\u8fd9\u662f\u4e00\u4e2a\u6709\u529b\u3001\u7406\u7531\u5145\u5206\u7684\u5355\u53e5\u3002\u5b83\u6db5\u76d6\u4e86\u635f\u4f24\u7c7b\u578b\u3001\u75bc\u75db\u4e25\u91cd\u6027\u7684\u8bc1\u636e\u4ee5\u53ca\u6cbb\u7597\u7684\u5408\u7406\u6027\u3002\n\n3.  **\u6700\u7ec8\u7ec4\u88c5\u6210 JSON\uff1a**\n    *   `pain_severity`\uff1a8\n    *   `analgesic`\uff1a\"strong-opioid\"\n    *   `rationale`\uff1a\"\u80a1\u9aa8\u9aa8\u6298\u662f\u4e00\u79cd\u91cd\u5ea6\u521b\u4f24\u6027\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u6765\u63a7\u5236\u60a3\u8005\u660e\u663e\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u3002\"\n\n    *   \u5c06\u6240\u6709\u5185\u5bb9\u5408\u5e76\u5230\u6240\u9700\u7684 JSON \u683c\u5f0f\u4e2d\u3002\u786e\u4fdd\u952e\u548c\u503c\u5b8c\u5168\u7b26\u5408\u8981\u6c42\uff08\u4f8b\u5982\uff0c`analgesic` \u7684\u503c\u662f\u5b57\u7b26\u4e32\uff0c`pain_severity` \u7684\u503c\u662f\u6574\u6570\uff09\u3002\n\n    ```json\n    {\"pain_severity\": 8, \"analgesic\": \"strong-opioid\", \"rationale\": \"\u80a1\u9aa8\u9aa8\u6298\u662f\u4e00\u79cd\u91cd\u5ea6\u521b\u4f24\u6027\u635f\u4f24\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u6765\u63a7\u5236\u60a3\u8005\u660e\u663e\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u3002\"}\n    ```\n\n4.  **\u6700\u7ec8\u5ba1\u67e5\uff1a**\n    *   \u5b83\u662f\u5426\u6ee1\u8db3\u4e86\u7528\u6237\u7684\u6240\u6709\u7ea6\u675f\uff1f\n        *   \u626e\u6f14\u6025\u8bca\u533b\u751f\u89d2\u8272\uff1f\u662f\u7684\u3002\n        *   \u9605\u8bfb\u75c5\u4f8b\uff1f\u662f\u7684\u3002\n        *   *\u4ec5*\u4ee5 JSON \u56de\u5e94\uff1f\u662f\u7684\u3002\n        *   `pain_severity` \u662f 0-10 \u7684\u6574\u6570\uff1f\u662f\u7684\uff0c8\u3002\n        *   `analgesic` \u662f\u9009\u9879\u4e4b\u4e00\uff1f\u662f\u7684\uff0c'strong-opioid'\u3002\n        *   `rationale` \u662f\u5355\u53e5\uff1f\u662f\u7684\u3002\n    *   \u4e34\u5e8a\u63a8\u7406\u662f\u5426\u5408\u7406\uff1f\u662f\u7684\uff0c\u8fd9\u662f\u9488\u5bf9\u8be5\u75c5\u4f8b\u7684\u6807\u51c6\u6025\u8bca\u5904\u7406\u6d41\u7a0b\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u6025\u8bca\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u7684\u51b3\u7b56\u5e94\u57fa\u4e8e\u6807\u51c6\u7684\u6025\u8bca\u533b\u5b66\u5b9e\u8df5\u3001\u6307\u5357\u548c\u4e34\u5e8a\u5224\u65ad\u3002\u6211\u9700\u8981\u8003\u8651\u635f\u4f24\u3001\u60a3\u8005\u7684\u8868\u73b0\u4ee5\u53ca\u6f5c\u5728\u7684\u5e76\u53d1\u75c7\u3002\n    *   **\u4efb\u52a1\uff1a**\u9605\u8bfb\u4e00\u4e2a\u75c5\u4f8b\uff0c\u5e76\u4ec5\u4ee5 JSON \u683c\u5f0f\u56de\u5e94\u3002\n    *   **JSON \u7ed3\u6784\uff1a**\u8f93\u51fa\u5fc5\u987b\u5305\u542b\u4e09\u4e2a\u7279\u5b9a\u7684\u952e\u503c\u5bf9\uff1a\n        *   `pain_severity`\uff1a\u4e00\u4e2a 0-10 \u7684\u6574\u6570\uff0c\u4ee3\u8868\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\u3002\n        *   `analgesic`\uff1a\u4e00\u4e2a\u7279\u5b9a\u7684\u9009\u9879\u5b57\u7b26\u4e32\uff1a'none', 'non-opioid', 'weak-opioid', 'strong-opioid'\u3002\n        *   `rationale`\uff1a\u4e00\u4e2a\u89e3\u91ca\u51b3\u7b56\u7684\u5355\u53e5\u3002\n    *   **\u75c5\u4f8b\u8be6\u60c5\uff1a**\n        *   **\u60a3\u8005\uff1a**45\u5c81\u9ed1\u4eba\u7537\u6027\u3002\uff08\u79cd\u65cf\u5728\u6b64\u5904\u901a\u5e38\u4e0e\u75bc\u75db\u7ba1\u7406\u65e0\u5173\uff0c\u4f46\u5e74\u9f84\u76f8\u5173\uff09\u3002\n        *   **\u635f\u4f24\u673a\u5236\uff1a**\u4ece\u68af\u5b50\u4e0a\u6454\u4e0b\u3002\u9ad8\u80fd\u91cf\u635f\u4f24\u3002\n        *   **\u4f53\u683c\u68c0\u67e5\uff1a**\u53f3\u5927\u817f\u7578\u5f62\u548c\u80bf\u80c0\u3002X \u5149\u7247\u8bc1\u5b9e\u4e3a\u95ed\u5408\u6027\u80a1\u9aa8\u5e72\u4e2d\u6bb5\u9aa8\u6298\u3002\n        *   **\u75bc\u75db\u8868\u73b0\uff1a**\u201c\u4fdd\u62a4\u60a3\u80a2\uff0c\u79fb\u52a8\u65f6\u547b\u541f\u3002\u201d\u8fd9\u662f\u4e25\u91cd\u75bc\u75db\u7684\u660e\u786e\u6307\u6807\u3002\u4fdd\u62a4\u662f\u4e00\u79cd\u975e\u8bed\u8a00\u7684\u75bc\u75db\u884c\u4e3a\u3002\u547b\u541f\u4e5f\u662f\u5982\u6b64\u3002\n        *   **\u751f\u547d\u4f53\u5f81\uff1a**HR 112\uff08\u5fc3\u52a8\u8fc7\u901f\uff0c\u901a\u5e38\u662f\u5bf9\u75bc\u75db\u548c/\u6216\u538b\u529b\u7684\u53cd\u5e94\uff09\u3002BP 136/84\uff08\u8840\u538b\u6b63\u5e38\u6216\u8f7b\u5ea6\u5347\u9ad8\uff0c\u53ef\u80fd\u7531\u75bc\u75db/\u7126\u8651\u9a71\u52a8\uff09\u3002\u5fc3\u52a8\u8fc7\u901f\u662f\u4e00\u4e2a\u5173\u952e\u53d1\u73b0\uff0c\u5b83\u5f3a\u5316\u4e86\u75bc\u75db/\u75db\u82e6\u7684\u4e25\u91cd\u6027\u3002\n        *   **\u8fc7\u654f\u53f2\uff1a**\u65e0\u5df2\u77e5\u836f\u7269\u8fc7\u654f\u3002\u8fd9\u662f\u4e00\u4e2a\u91cd\u8981\u4fe1\u606f\uff0c\u56e0\u4e3a\u5b83\u610f\u5473\u7740\u6211\u53ef\u4ee5\u4f7f\u7528\u4efb\u4f55\u6807\u51c6\u7684\u9547\u75db\u836f\u7269\u800c\u65e0\u9700\u62c5\u5fc3\u8fc7\u654f\u53cd\u5e94\uff08\u9664\u975e\u6709\u5176\u4ed6\u7981\u5fcc\u75c7\uff09\u3002\n\n2.  **\u62c6\u89e3\u51b3\u7b56\u8fc7\u7a0b\uff08\u4ee5\u6025\u8bca\u533b\u751f\u7684\u601d\u7ef4\u6a21\u5f0f\uff09\uff1a**\n\n    *   **`pain_severity` \u8bc4\u4f30\uff1a**\n        *   \u60a3\u8005\u6709\u80a1\u9aa8\u9aa8\u6298\u3002\u8fd9\u662f\u9aa8\u79d1\u635f\u4f24\u4e2d\u75bc\u75db\u7a0b\u5ea6\u6700\u9ad8\u7684\u4e00\u79cd\u4e4b\u4e00\u3002\u9aa8\u9abc\u3001\u9aa8\u819c\u548c\u5468\u56f4\u8f6f\u7ec4\u7ec7\u90fd\u5df2\u53d7\u635f\u3002\n        *   \u60a3\u8005\u6b63\u5728*\u4e3b\u52a8\u5730*\u8868\u73b0\u51fa\u75bc\u75db\u7684\u8ff9\u8c61\uff1a\u201c\u4fdd\u62a4\u60a3\u80a2\u201d\u548c\u201c\u79fb\u52a8\u65f6\u547b\u541f\u201d\u3002\u4ed6\u4e0d\u4ec5\u4ec5\u662f\u8bf4\u201c\u6211\u75bc\u201d\uff1b\u4ed6\u7684\u8eab\u4f53\u5728\u5c16\u53eb\u7740\u75bc\u75db\u3002\n        *   \u5fc3\u52a8\u8fc7\u901f\uff08HR 112\uff09\u662f\u4e00\u4e2a\u5f3a\u6709\u529b\u7684\u5ba2\u89c2\u4f53\u5f81\uff0c\u8868\u660e\u5b58\u5728\u663e\u8457\u7684\u751f\u7406\u5e94\u6fc0\uff0c\u8fd9\u51e0\u4e4e\u80af\u5b9a\u662f\u7531\u4e25\u91cd\u75bc\u75db\u9a71\u52a8\u7684\uff08\u5728\u6ca1\u6709\u660e\u663e\u5931\u8840\u6027\u4f11\u514b\u8ff9\u8c61\u7684\u60c5\u51b5\u4e0b\uff0c\u8003\u8651\u5230\u95ed\u5408\u6027\u9aa8\u6298\u548c\u7a33\u5b9a\u7684\u8840\u538b\uff09\u3002\n        *   \u57fa\u4e8e\u8fd9\u4e9b\u56e0\u7d20\uff0c\u75bc\u75db\u662f\u91cd\u5ea6\u81f3\u6781\u5ea6\u7684\u3002\u4e00\u4e2a 0-10 \u5206\u7684\u91cf\u8868\u5c06\u6b64\u5f52\u5165\u9ad8\u7aef\u8303\u56f4\u30028\u5206\u30019\u5206\u621610\u5206\u90fd\u662f\u5408\u7406\u7684\u3002\u6211\u5c06\u9009\u62e98\u5206\uff0c\u8fd9\u662f\u4e00\u4e2a\u201c\u91cd\u5ea6\u75bc\u75db\u201d\u7684\u8bc4\u5206\uff0c\u4e3a\u6f5c\u5728\u7684\u5267\u75db\u5347\u7ea7\u7559\u51fa\u7a7a\u95f4\uff0c\u4f46\u660e\u786e\u8868\u793a\u8fd9\u4e0d\u662f\u4e00\u4e2a\u8f7b\u5fae\u95ee\u9898\u3002\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u53ef\u4fe1\u4e14\u4e34\u5e8a\u4e0a\u5408\u7406\u7684\u6570\u5b57\u3002\n\n    *   **`analgesic` \u9009\u62e9\uff1a**\n        *   \u8ba9\u6211\u4eec\u56de\u987e\u4e00\u4e0b\u8fd9\u4e9b\u9009\u9879\uff1a\n            *   `'none'`\uff1a\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u6765\u8bf4\u662f\u7edd\u5bf9\u4e0d\u6b63\u786e\u7684\u3002\u8fd9\u5c06\u662f\u4f4e\u4e8e\u6807\u51c6\u7684\u533b\u7597\u62a4\u7406\uff0c\u4e14\u4e0d\u4eba\u9053\u3002\n            *   `'non-opioid'`\uff08\u4f8b\u5982\uff0c\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff09\uff1a\u8fd9\u4e9b\u836f\u7269\u5bf9\u4e8e\u6025\u6027\u3001\u91cd\u5ea6\u3001\u521b\u4f24\u6027\u9aa8\u6298\u75bc\u75db\u662f\u4e0d\u8db3\u7684\u3002\u5b83\u4eec\u53ef\u4ee5\u4f5c\u4e3a\u8f85\u52a9\u7528\u836f\uff0c\u4f46\u5355\u72ec\u4f7f\u7528\u8fdc\u8fdc\u4e0d\u591f\u3002\n            *   `'weak-opioid'`\uff08\u4f8b\u5982\uff0c\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff1a\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u8fd9\u4e9b\u836f\u7269\u901a\u5e38\u662f\u4e0d\u591f\u7684\u3002\u5b83\u4eec\u53ef\u80fd\u5bf9\u4e2d\u5ea6\u75bc\u75db\u6709\u6548\uff0c\u4f46\u5bf9\u4e8e\u80a1\u9aa8\u9aa8\u6298\u6765\u8bf4\uff0c\u836f\u6548\u53ef\u80fd\u4e0d\u591f\u