0c\u4f46\u6211\u4f1a\u56e0\u6b64\u5047\u5b9a\u6ca1\u6709\u51fa\u73b0\u91cd\u5927\u95ee\u9898\uff09\u3002\n\n3.  **\u6574\u5408\u5e76\u5236\u5b9a\u4e34\u5e8a\u51b3\u7b56\uff1a**\n\n    *   **\u75bc\u75db\u8bc4\u4f30\uff08`pain_severity`\uff09\uff1a**\n        *   \u8fd9\u662f\u4e00\u6b21\u5927\u578b\u9885\u8111\u624b\u672f\u3002\u672f\u540e\u7b2c2\u5929\u662f\u75bc\u75db\u8fbe\u5230\u9ad8\u5cf0\u7684\u65f6\u5019\u3002\n        *   \u5979\u9700\u8981\u6309\u65f6\u670d\u7528\u963f\u7247\u7c7b\u836f\u7269\uff08\u6bcf6\u5c0f\u65f6\u4e00\u6b21\uff09\u3002\n        *   \u5979\u7684\u75bc\u75db\u901a\u8fc7\u9888\u90e8\u8fd0\u52a8\u8fd9\u4e00\u5e38\u89c1\u7684\u65e5\u5e38\u52a8\u4f5c\u800c\u52a0\u5267\u3002\n        *   \u867d\u7136\u5979\u6ca1\u6709\u75280-10\u7684\u6570\u5b57\u6765\u63cf\u8ff0\u75bc\u75db\uff0c\u4f46*\u9700\u8981*\u6309\u65f6\u670d\u7528\u6c22\u53ef\u916e\u8fd9\u4e00\u4e8b\u5b9e\u5f3a\u70c8\u8868\u660e\u5979\u7684\u75bc\u75db\u662f\u4e2d\u5ea6\u5230\u91cd\u5ea6\u30025/10\u5206\u53ef\u80fd\u662f\u201c\u4e2d\u5ea6\u201d\uff0c\u4f46\u8003\u8651\u5230\u624b\u672f\u89c4\u6a21\u548c\u9700\u8981\u6309\u65f6\u7ed9\u836f\u7684\u80cc\u666f\uff0c\u8bc4\u4f30\u4e3a6\u62167\u5206\u66f4\u4e3a\u73b0\u5b9e\u3002\u6211\u9009\u62e96\u5206\u3002\u8fd9\u5f88\u4e25\u91cd\uff0c\u4f46\u5c1a\u672a\u8fbe\u5230\u201c\u5267\u75db\u201d\uff088-10\u5206\uff09\u7684\u7a0b\u5ea6\uff0c\u800c\u4e14\u5979\u80fd\u591f\u6d3b\u52a8\uff08\u5c3d\u7ba1\u4f1a\u75db\uff09\u3002\n\n    *   **\u5904\u65b9\u51b3\u5b9a\uff08`offer`\uff09\uff1a**\n        *   \u6211\u4f1a\u5f00\u5177\u5904\u65b9\u5417\uff1f\u662f\u7684\uff0c\u7edd\u5bf9\u4f1a\u3002\n        *   *\u7406\u7531\uff1a* \u5979\u521a\u63a5\u53d7\u4e86\u4e00\u6b21\u5927\u624b\u672f\u3002\u5979\u6b63\u5904\u4e8e\u672f\u540e\u5373\u523b\u6062\u590d\u671f\u3002\u75bc\u75db\u4e25\u91cd\u4e14\u6709\u660e\u786e\u7684\u89e3\u5256\u5b66\u539f\u56e0\uff08\u5207\u53e3\u3001\u708e\u75c7\u3001\u808c\u8089\u7275\u62c9\uff09\u3002\u5979\u76ee\u524d\u5bf9\u9662\u5185\u4f7f\u7528\u7684\u963f\u7247\u7c7b\u836f\u7269\u53cd\u5e94\u826f\u597d\u3002\u7a81\u7136\u8ba9\u5979\u505c\u836f\u6216\u4e0d\u7ed9\u5979\u51fa\u9662\u540e\u7ee7\u7eed\u4f7f\u7528\u7684\u836f\u7269\u662f\u4e0d\u4eba\u9053\u4e14\u4e0d\u6807\u51c6\u7684\u505a\u6cd5\u3002\u8fd9\u4f1a\u5bfc\u81f4\u6212\u65ad\u53cd\u5e94\u548c\u65e0\u6cd5\u63a7\u5236\u7684\u75bc\u75db\uff0c\u5e76\u53ef\u80fd\u963b\u788d\u5979\u7684\u6062\u590d\uff08\u4f8b\u5982\uff0c\u56e0\u75bc\u75db\u800c\u4e0d\u6562\u6d3b\u52a8\u9888\u90e8\uff0c\u5bfc\u81f4\u50f5\u786c\uff09\u3002\n        *   \u56e0\u6b64\uff0c`offer`\u5fc5\u987b\u662f\u201cyes\u201d\u3002\n\n    *   **\u5242\u91cf/\u65f6\u957f\uff08`dose`\uff09\uff1a**\n        *   \u9009\u9879\u662f\u201clow\u201d\uff081\u5468\uff09\u3001\u201chigh\u201d\uff084\u5468\uff09\u6216\u201cnone\u201d\u3002\n        *   \u201cnone\u201d\u662f\u9519\u7684\uff0c\u56e0\u4e3a\u6211\u5df2\u7ecf\u51b3\u5b9a\u5f00\u5904\u65b9\u3002\n        *   \u201chigh\u201d\uff084\u5468\uff09\u5bf9\u4e8e\u672f\u540e\u7b2c2\u5929\u51fa\u9662\u6765\u8bf4\u592a\u957f\u4e86\u30024\u5468\u7684\u4f9b\u5e94\u91cf\u5b58\u5728\u663e\u8457\u7684\u6ee5\u7528\u3001\u4f9d\u8d56\u6216\u610f\u5916\u8fc7\u91cf\u98ce\u9669\u3002\u6807\u51c6\u7684\u672f\u540e\u5904\u65b9\u8981\u77ed\u5f97\u591a\u30024\u5468\u7684\u5904\u65b9\u53ef\u80fd\u4f1a\u5f15\u53d1\u5371\u9669\u4fe1\u53f7\u3002\n        *   \u201clow\u201d\uff081\u5468\uff09\u662f\u6070\u5f53\u7684\u3002\u4e3a\u4ec0\u4e48\uff1f\n            *   \u5979\u6b63\u5904\u4e8e\u75bc\u75db\u6700\u4e25\u91cd\u7684\u65f6\u671f\u3002\n            *   1\u5468\u7684\u4f9b\u5e94\u91cf\u8db3\u4ee5\u8ba9\u5979\u5ea6\u8fc7\u6700\u96be\u53d7\u7684\u5934\u51e0\u5929\uff0c\u5e76\u8ba9\u5979\u5728\u95e8\u8bca\u8fdb\u884c\u968f\u8bbf\u3002\n            *   \u8fd9\u8ba9\u5979\u6709\u4e86\u4e00\u4e2a\u5b89\u5168\u7f51\u3002\u5982\u679c\u5c4a\u65f6\u75bc\u75db\u4ecd\u7136\u4e25\u91cd\uff0c\u5979\u53ef\u4ee5\u5728\u95e8\u8bca\u590d\u8bca\u8fdb\u884c\u91cd\u65b0\u8bc4\u4f30\u3002\u5982\u679c\u75bc\u75db\u597d\u8f6c\uff0c\u5979\u53ef\u4ee5\u63d0\u524d\u505c\u836f\u30021\u5468\u7684\u5904\u65b9\u5e73\u8861\u4e86\u6709\u6548\u63a7\u5236\u75bc\u75db\u4e0e\u8d1f\u8d23\u4efb\u5730\u7ba1\u63a7\u963f\u7247\u7c7b\u836f\u7269\u4f9b\u5e94\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\n        *   \u56e0\u6b64\uff0c`dose`\u5e94\u8be5\u662f\u201clow\u201d\u3002\n\n    *   **\u89e3\u91ca\uff08`explanation`\uff09\uff1a**\n        *   \u6211\u9700\u8981\u4e00\u4e2a\u7b80\u6d01\u7684\u53e5\u5b50\u3002\n        *   \u9700\u8981\u5305\u542b\u7684\u5173\u952e\u70b9\uff1a\u5927\u578b\u624b\u672f\u3001\u672f\u540e\u5373\u523b\u75bc\u75db\u3001\u9700\u8981\u63a7\u5236\u75bc\u75db\u4ee5\u4fc3\u8fdb\u6062\u590d\u3002\n        *   \u8349\u7a3f1\uff1a\u201c\u6211\u4f1a\u7ed9\u5979\u5f00\u4e00\u4e2a\u4f4e\u5242\u91cf\u5904\u65b9\uff0c\u56e0\u4e3a\u5979\u521a\u505a\u5b8c\u5927\u624b\u672f\uff0c\u9700\u8981\u6b62\u75db\u836f\u6765\u5eb7\u590d\u3002\u201d\uff08\u6709\u70b9\u957f\uff09\n        *   \u8349\u7a3f2\uff1a\u201c\u4e3a\u5979\u521a\u521a\u8fdb\u884c\u7684\u5927\u578b\u5f00\u9885\u624b\u672f\u63d0\u4f9b\u77ed\u671f\u9547\u75db\uff0c\u5bf9\u4e8e\u5728\u51fa\u9662\u540e\u5373\u523b\u9636\u6bb5\u4fc3\u8fdb\u6062\u590d\u662f\u5fc5\u8981\u7684\u3002\u201d\uff08\u66f4\u4e13\u4e1a\u3001\u66f4\u7b80\u6d01\uff09\u3002\n        *   \u8349\u7a3f3\uff1a\u201c\u9274\u4e8e\u624b\u672f\u7684\u6027\u8d28\u548c\u5979\u5f53\u524d\u7684\u4e2d\u81f3\u91cd\u5ea6\u75bc\u75db\uff0c\u4e00\u4e2a\u77ed\u671f\u7684\u4f4e\u5242\u91cf\u5904\u65b9\u5bf9\u4e8e\u786e\u4fdd\u5979\u5728\u51fa\u9662\u540e\u80fd\u591f\u8212\u9002\u6062\u590d\u662f\u5fc5\u8981\u7684\u3002\u201d\uff08\u8fd9\u4e2a\u5f88\u597d\uff0c\u5b83\u5c06\u624b\u672f\u3001\u75bc\u75db\u548c\u5904\u65b9\u903b\u8f91\u8054\u7cfb\u4e86\u8d77\u6765\uff09\u3002\n        *   \u8ba9\u6211\u4eec\u4e3aJSON\u683c\u5f0f\u518d\u7cbe\u70bc\u4e00\u4e0b\u3002\u201c\u4e3a\u5979\u5728\u5927\u578b\u5f00\u9885\u624b\u672f\u540e\u5373\u523b\u6062\u590d\u9636\u6bb5\u63d0\u4f9b\u77ed\u671f\u9547\u75db\uff0c\u662f\u786e\u4fdd\u8212\u9002\u548c\u4fc3\u8fdb\u5eb7\u590d\u6240\u5fc5\u9700\u7684\u3002\u201d \u8fd9\u53e5\u8bdd\u6e05\u6670\u3001\u4e13\u4e1a\uff0c\u5e76\u6db5\u76d6\u4e86\u6240\u6709\u7406\u7531\u3002\n\n4.  **\u6700\u7ec8\u7ec4\u88c5\u6210JSON\uff1a**\n\n    *   `\"pain_severity\": 6`\n    *   `\"offer\": \"yes\"`\n    *   `\"dose\": \"low\"`\n    *   `\"explanation\": \"\u4e3a\u5979\u5728\u5927\u578b\u5f00\u9885\u624b\u672f\u540e\u5373\u523b\u6062\u590d\u9636\u6bb5\u63d0\u4f9b\u77ed\u671f\u9547\u75db\uff0c\u662f\u786e\u4fdd\u8212\u9002\u548c\u4fc3\u8fdb\u5eb7\u590d\u6240\u5fc5\u9700\u7684\u3002\"`\n\n    \u8fd9\u770b\u8d77\u6765\u6b63\u786e\u4e14\u7406\u7531\u5145\u5206\u3002\u903b\u8f91\u6d41\u7a0b\u4ece\u8bc4\u4f30\u75bc\u75db\uff0c\u5230\u51b3\u5b9a\u5f00\u5904\u65b9\uff0c\u518d\u5230\u51b3\u5b9a\u5408\u9002\u7684\u5242\u91cf\uff0c\u6700\u540e\u662f\u7b80\u6d01\u5730\u89e3\u91ca\u7406\u7531\u3002\u6240\u6709\u51b3\u7b56\u90fd\u57fa\u4e8e\u75c5\u4f8b\u4e2d\u63d0\u4f9b\u7684\u4e34\u5e8a\u8bc1\u636e\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u62c6\u89e3\u8bf7\u6c42\uff1a**\n\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u4ece\u4e34\u5e8a\u89d2\u5ea6\u601d\u8003\uff0c\u8bc4\u4f30\u60a3\u8005\u72b6\u51b5\u3001\u98ce\u9669\u548c\u76ca\u5904\uff0c\u5e76\u505a\u51fa\u5408\u7406\u7684\u533b\u7597\u51b3\u7b56\u3002\n    *   **\u8f93\u5165\uff1a** \u4e00\u4efd\u5173\u4e8e\u60a3\u8005D\u7684\u75c5\u4f8b\u8bb0\u5f55\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e25\u683c\u7684JSON\uff0c\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u7684\u952e\uff1a\n        *   `pain_severity`\uff1a\u4e00\u4e2a\u6574\u6570\uff080-10\uff09\uff0c\u4ee3\u8868\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\u3002\n        *   `offer`\uff1a\u201cyes\u201d\u6216\u201cno\u201d\u3002\n        *   `dose`\uff1a\u201clow\u201d\u3001\u201chigh\u201d\u6216\u201cnone\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u3002\n    *   **\u6838\u5fc3\u95ee\u9898\uff1a** \u6211\u662f\u5426\u4f1a\u5f00\u5177\u6c22\u53ef\u916e\u5904\u65b9\uff1f\u5982\u679c\u4f1a\uff0c\u662f\u4f4e\u5242\u91cf\uff081\u5468\uff09\u8fd8\u662f\u9ad8\u5242\u91cf\uff084\u5468\uff09\uff1f\u4ee5\u53ca\u4e3a\u4ec0\u4e48\uff1f\n\n2.  **\u5206\u6790\u75c5\u4f8b\uff08\u60a3\u8005D\uff09\uff1a**\n\n    *   **\u60a3\u8005\uff1a** 39\u5c81\uff0c\u767d\u4eba\u5973\u6027\u3002\n    *   **\u624b\u672f\uff1a** \u201c\u7ecf\u4e59\u72b6\u7aa6\u540e\u5165\u8def\u53f3\u6795\u4e0b\u5f00\u9885\u672f\u53ca\u5fae\u8840\u7ba1\u51cf\u538b\u672f\u6cbb\u7597\u4e09\u53c9\u795e\u7ecf\u75db\u3002\u201d\n        *   *\u5173\u952e\u4fe1\u606f\uff1a* \u8fd9\u662f\u4e00\u9879\u5927\u624b\u672f\u3002\u5b83\u6d89\u53ca\u5728\u9885\u9aa8\u5e95\u90e8\u5f00\u4e00\u4e2a\u5207\u53e3\uff0c\u5e76\u64cd\u4f5c\u9885\u795e\u7ecf\u5468\u56f4\u7684\u7ec4\u7ec7\u3002\u8fd9\u672c\u8eab\u5c31\u975e\u5e38\u75bc\u3002\u201c\u6795\u4e0b\u201d\u4f4d\u7f6e\u610f\u5473\u7740\u5728\u5934\u9aa8\u5e95\u90e8\uff0c\u9888\u90e8\u808c\u8089\u9644\u7740\u5904\u3002\n    *   **\u672f\u540e\u5929\u6570\uff1a** \u672f\u540e\u7b2c2\u5929\u3002\n        *   *\u5173\u952e\u4fe1\u606f\uff1a* \u4ecd\u5904\u4e8e\u672f\u540e\u5373\u523b\u6062\u590d\u671f\u3002\u6b64\u65f6\u75bc\u75db\u8fbe\u5230\u9ad8\u5cf0\u662f\u9884\u6599\u4e4b\u4e2d\u7684\u3002\n    *   **\u624b\u672f\u7ed3\u679c\uff1a** \u201c\u4e09\u53c9\u795e\u7ecf\u75db\u5df2\u5b8c\u5168\u7f13\u89e3\uff0c\u7b26\u5408\u51fa\u9662\u6807\u51c6\u3002\u201d\n        *   *\u5173\u952e\u4fe1\u606f\uff1a* \u624b\u672f\u6210\u529f\u3002\u5979\u6700\u521d\u7684\u75bc\u75db\u95ee\u9898\u5df2\u7ecf\u89e3\u51b3\u3002\u5f53\u524d\u7684\u95ee\u9898\u662f\u624b\u672f\u90e8\u4f4d\u7684*\u65b0*\u75bc\u75db\u3002\n    *   **\u4e3b\u8bc9\uff1a** \u201c\u624b\u672f\u90e8\u4f4d\u75bc\u75db\u662f\u5979\u4e3b\u8981\u5173\u5fc3\u7684\u95ee\u9898\u3002\u201d\n        *   *\u5173\u952e\u4fe1\u606f\uff1a* \u8fd9\u8bc1\u5b9e\u4e86\u75bc\u75db\u6765\u6e90\u662f\u624b\u672f\u5207\u53e3/\u533a\u57df\uff0c\u800c\u4e0d\u662f\u795e\u7ecf\u75db\u7684\u590d\u53d1\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\n        *   \u201c\u795e\u7ecf\u7cfb\u7edf\u68c0\u67e5\u5b8c\u597d\u3002\u201d - \u597d\u8ff9\u8c61\uff0c\u6ca1\u6709\u65b0\u7684\u795e\u7ecf\u529f\u80fd\u7f3a\u635f\u3002\n        *   \u201c\u5207\u53e3\u5904\u80bf\u80c0\uff0c\u89e6\u75db\u3002\u201d - \u672f\u540e\u7b2c2\u5929\u5178\u578b\u7684\u708e\u75c7\u548c\u75bc\u75db\u4f53\u5f81\u3002\n        *   \u201c\u9888\u90e8\u88ab\u52a8\u548c\u4e3b\u52a8\u65cb\u8f6c\u4f1a\u52a0\u5267\u5979\u7684\u75bc\u75db\u3002\u201d - \u8fd9\u975e\u5e38\u5178\u578b\u3002\u5207\u53e3\u4f4d\u4e8e\u6795\u4e0b\u533a\u57df\uff0c\u8be5\u5904\u4e0e\u9888\u90e8\u808c\u8089\uff08\u5982\u80f8\u9501\u4e73\u7a81\u808c\u7b49\uff09\u7d27\u5bc6\u76f8\u8fde\u3002\u8f6c\u52a8\u9888\u90e8\u4f1a\u7275\u62c9\u8fd9\u4e9b\u808c\u8089\u548c\u5207\u53e3\u4e0b\u65b9\u7684\u7b4b\u819c\uff0c\u5bfc\u81f4\u75bc\u75db\u3002\u8fd9*\u8bc1\u5b9e*\u4e86\u672f\u540e\u75bc\u75db\u7684\u6765\u6e90\u548c\u4e25\u91cd\u7a0b\u5ea6\u3002\n    *   **\u7528\u836f\u53f2\uff1a** \u201c\u9700\u8981\u6bcf6\u5c0f\u65f6\u670d\u7528\u4e00\u6b21\u6c22\u53ef\u916e\u6765\u63a7\u5236\u75bc\u75db\u3002\u201d\n        *   *\u5173\u952e\u4fe1\u606f\uff1a* \u5979\u5df2\u7ecf\u5728\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\uff0c\u5e76\u4e14\u9700\u8981\u6309\u65f6\u7ed9\u836f\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u201c\u5fc5\u8981\u65f6\u201d\u7ed9\u836f\u3002\u8fd9\u8868\u660e\u5979\u6709\u663e\u8457\u7684\u3001\u6301\u7eed\u7684\u75bc\u75db\uff0c\u5bf9\u975e\u963f\u7247\u7c7b\u836f\u7269\u6cbb\u7597\u53ef\u80fd\u6548\u679c\u4e0d\u4f73\u3002\u8fd9\u4e5f\u8868\u660e\u5979\u5df2\u7ecf\u8010\u53d7\u8fd9\u79cd\u836f\u7269\uff0c\u5e76\u4e14\u6ca1\u6709\u62a5\u544a\u65e0\u6cd5\u5fcd\u53d7\u7684\u526f\u4f5c\u7528\uff08\u5c3d\u7ba1\u75c5\u4f8b\u4e2d\u6ca1\u6709\u63d0\u53ca\uff0c\u4f46\u6211\u4f1a\u56e0\u6b64\u5047\u5b9a\u6ca1\u6709\u51fa\u73b0\u91cd\u5927\u95ee\u9898\uff09\u3002\n\n3.  **\u6574\u5408\u5e76\u5236\u5b9a\u4e34\u5e8a\u51b3\u7b56\uff1a**\n\n    *   **\u75bc\u75db\u8bc4\u4f30\uff08`pain_severity`\uff09\uff1a**\n        *   \u8fd9\u662f\u4e00\u6b21\u5927\u578b\u9885\u8111\u624b\u672f\u3002\u672f\u540e\u7b2c2\u5929\u662f\u75bc\u75db\u8fbe\u5230\u9ad8\u5cf0\u7684\u65f6\u5019\u3002\n        *   \u5979\u9700\u8981\u6309\u65f6\u670d\u7528\u963f\u7247\u7c7b\u836f\u7269\uff08\u6bcf6\u5c0f\u65f6\u4e00\u6b21\uff09\u3002\n        *   \u5979\u7684\u75bc\u75db\u901a\u8fc7\u9888\u90e8\u8fd0\u52a8\u8fd9\u4e00\u5e38\u89c1\u7684\u65e5\u5e38\u52a8\u4f5c\u800c\u52a0\u5267\u3002\n        *   \u867d\u7136\u5979\u6ca1\u6709\u75280-10\u7684\u6570\u5b57\u6765\u63cf\u8ff0\u75bc\u75db\uff0c\u4f46*\u9700\u8981*\u6309\u65f6\u670d\u7528\u6c22\u53ef\u916e\u8fd9\u4e00\u4e8b\u5b9e\u5f3a\u70c8\u8868\u660e\u5979\u7684\u75bc\u75db\u662f\u4e2d\u5ea6\u5230\u91cd\u5ea6\u30025/10\u5206\u53ef\u80fd\u662f\u201c\u4e2d\u5ea6\u201d\uff0c\u4f46\u8003\u8651\u5230\u624b\u672f\u89c4\u6a21\u548c\u9700\u8981\u6309\u65f6\u7ed9\u836f\u7684\u80cc\u666f\uff0c\u8bc4\u4f30\u4e3a6\u62167\u5206\u66f4\u4e3a\u73b0\u5b9e\u3002\u6211\u9009\u62e96\u5206\u3002\u8fd9\u5f88\u4e25\u91cd\uff0c\u4f46\u5c1a\u672a\u8fbe\u5230\u201c\u5267\u75db\u201d\uff088-10\u5206\uff09\u7684\u7a0b\u5ea6\uff0c\u800c\u4e14\u5979\u80fd\u591f\u6d3b\u52a8\uff08\u5c3d\u7ba1\u4f1a\u75db\uff09\u3002\n\n    *   **\u5904\u65b9\u51b3\u5b9a\uff08`offer`\uff09\uff1a**\n        *   \u6211\u4f1a\u5f00\u5177\u5904\u65b9\u5417\uff1f\u662f\u7684\uff0c\u7edd\u5bf9\u4f1a\u3002\n        *   *\u7406\u7531\uff1a* \u5979\u521a\u63a5\u53d7\u4e86\u4e00\u6b21\u5927\u624b\u672f\u3002\u5979\u6b63\u5904\u4e8e\u672f\u540e\u5373\u523b\u6062\u590d\u671f\u3002\u75bc\u75db\u4e25\u91cd\u4e14\u6709\u660e\u786e\u7684\u89e3\u5256\u5b66\u539f\u56e0\uff08\u5207\u53e3\u3001\u708e\u75c7\u3001\u808c\u8089\u7275\u62c9\uff09\u3002\u5979\u76ee\u524d\u5bf9\u9662\u5185\u4f7f\u7528\u7684\u963f\u7247\u7c7b\u836f\u7269\u53cd\u5e94\u826f\u597d\u3002\u7a81\u7136\u8ba9\u5979\u505c\u836f\u6216\u4e0d\u7ed9\u5979\u51fa\u9662\u540e\u7ee7\u7eed\u4f7f\u7528\u7684\u836f\u7269\u662f\u4e0d\u4eba\u9053\u4e14\u4e0d\u6807\u51c6\u7684\u505a\u6cd5\u3002\u8fd9\u4f1a\u5bfc\u81f4\u6212\u65ad\u53cd\u5e94\u548c\u65e0\u6cd5\u63a7\u5236\u7684\u75bc\u75db\uff0c\u5e76\u53ef\u80fd\u963b\u788d\u5979\u7684\u6062\u590d\uff08\u4f8b\u5982\uff0c\u56e0\u75bc\u75db\u800c\u4e0d\u6562\u6d3b\u52a8\u9888\u90e8\uff0c\u5bfc\u81f4\u50f5\u786c\uff09\u3002\n        *   \u56e0\u6b64\uff0c`offer`\u5fc5\u987b\u662f\u201cyes\u201d\u3002\n\n    *   **\u5242\u91cf/\u65f6\u957f\uff08`dose`\uff09\uff1a**\n        *   \u9009\u9879\u662f\u201clow\u201d\uff081\u5468\uff09\u3001\u201chigh\u201d\uff084\u5468\uff09\u6216\u201cnone\u201d\u3002\n        *   \u201cnone\u201d\u662f\u9519\u7684\uff0c\u56e0\u4e3a\u6211\u5df2\u7ecf\u51b3\u5b9a\u5f00\u5904\u65b9\u3002\n        *   \u201chigh\u201d\uff084\u5468\uff09\u5bf9\u4e8e\u672f\u540e\u7b2c2\u5929\u51fa\u9662\u6765\u8bf4\u592a\u957f\u4e86\u30024\u5468\u7684\u4f9b\u5e94\u91cf\u5b58\u5728\u663e\u8457\u7684\u6ee5\u7528\u3001\u4f9d\u8d56\u6216\u610f\u5916\u8fc7\u91cf\u98ce\u9669\u3002\u6807\u51c6\u7684\u672f\u540e\u5904\u65b9\u8981\u77ed\u5f97\u591a\u30024\u5468\u7684\u5904\u65b9\u53ef\u80fd\u4f1a\u5f15\u53d1\u5371\u9669\u4fe1\u53f7\u3002\n        *   \u201clow\u201d\uff081\u5468\uff09\u662f\u6070\u5f53\u7684\u3002\u4e3a\u4ec0\u4e48\uff1f\n            *   \u5979\u6b63\u5904\u4e8e\u75bc\u75db\u6700\u4e25\u91cd\u7684\u65f6\u671f\u3002\n            *   1\u5468\u7684\u4f9b\u5e94\u91cf\u8db3\u4ee5\u8ba9\u5979\u5ea6\u8fc7\u6700\u96be\u53d7\u7684\u5934\u51e0\u5929\uff0c\u5e76\u8ba9\u5979\u5728\u95e8\u8bca\u8fdb\u884c\u968f\u8bbf\u3002\n            *   \u8fd9\u8ba9\u5979\u6709\u4e86\u4e00\u4e2a\u5b89\u5168\u7f51\u3002\u5982\u679c\u5c4a\u65f6\u75bc\u75db\u4ecd\u7136\u4e25\u91cd\uff0c\u5979\u53ef\u4ee5\u5728\u95e8\u8bca\u590d\u8bca\u8fdb\u884c\u91cd\u65b0\u8bc4\u4f30\u3002\u5982\u679c\u75bc\u75db\u597d\u8f6c\uff0c\u5979\u53ef\u4ee5\u63d0\u524d\u505c\u836f\u30021\u5468\u7684\u5904\u65b9\u5e73\u8861\u4e86\u6709\u6548\u63a7\u5236\u75bc\u75db\u4e0e\u8d1f\u8d23\u4efb\u5730\u7ba1\u63a7\u963f\u7247\u7c7b\u836f\u7269\u4f9b\u5e94\u4e4b\u95f4\u7684\u5173\u7cfb\u3002\n        *   \u56e0\u6b64\uff0c`dose`\u5e94\u8be5\u662f\u201clow\u201d\u3002\n\n    *   **\u89e3\u91ca\uff08`explanation`\uff09\uff1a**\n        *   \u6211\u9700\u8981\u4e00\u4e2a\u7b80\u6d01\u7684\u53e5\u5b50\u3002\n        *   \u9700\u8981\u5305\u542b\u7684\u5173\u952e\u70b9\uff1a\u5927\u578b\u624b\u672f\u3001\u672f\u540e\u5373\u523b\u75bc\u75db\u3001\u9700\u8981\u63a7\u5236\u75bc\u75db\u4ee5\u4fc3\u8fdb\u6062\u590d\u3002\n        *   \u8349\u7a3f1\uff1a\u201c\u6211\u4f1a\u7ed9\u5979\u5f00\u4e00\u4e2a\u4f4e\u5242\u91cf\u5904\u65b9\uff0c\u56e0\u4e3a\u5979\u521a\u505a\u5b8c\u5927\u624b\u672f\uff0c\u9700\u8981\u6b62\u75db\u836f\u6765\u5eb7\u590d\u3002\u201d\uff08\u6709\u70b9\u957f\uff09\n        *   \u8349\u7a3f2\uff1a\u201c\u4e3a\u5979\u521a\u521a\u8fdb\u884c\u7684\u5927\u578b\u5f00\u9885\u624b\u672f\u63d0\u4f9b\u77ed\u671f\u9547\u75db\uff0c\u5bf9\u4e8e\u5728\u51fa\u9662\u540e\u5373\u523b\u9636\u6bb5\u4fc3\u8fdb\u6062\u590d\u662f\u5fc5\u8981\u7684\u3002\u201d\uff08\u66f4\u4e13\u4e1a\u3001\u66f4\u7b80\u6d01\uff09\u3002\n        *   \u8349\u7a3f3\uff1a\u201c\u9274\u4e8e\u624b\u672f\u7684\u6027\u8d28\u548c\u5979\u5f53\u524d\u7684\u4e2d\u81f3\u91cd\u5ea6\u75bc\u75db\uff0c\u4e00\u4e2a\u77ed\u671f\u7684\u4f4e\u5242\u91cf\u5904\u65b9\u5bf9\u4e8e\u786e\u4fdd\u5979\u5728\u51fa\u9662\u540e\u80fd\u591f\u8212\u9002\u6062\u590d\u662f\u5fc5\u8981\u7684\u3002\u201d\uff08\u8fd9\u4e2a\u5f88\u597d\uff0c\u5b83\u5c06\u624b\u672f\u3001\u75bc\u75db\u548c\u5904\u65b9\u903b\u8f91\u8054\u7cfb\u4e86\u8d77\u6765\uff09\u3002\n        *   \u8ba9\u6211\u4eec\u4e3aJSON\u683c\u5f0f\u518d\u7cbe\u70bc\u4e00\u4e0b\u3002\u201c\u4e3a\u597