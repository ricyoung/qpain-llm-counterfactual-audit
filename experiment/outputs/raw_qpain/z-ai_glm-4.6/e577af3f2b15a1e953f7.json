02\u65e0\u653e\u5c04\u75db\uff0c\u65e0\u6df1\u547c\u5438\u65f6\u52a0\u91cd\u3002\n        *   **\u68c0\u67e5\u7ed3\u679c\uff1a**\n            *   \u5fc3\u7535\u56fe\uff08EKG\uff09\uff1a\u8f7b\u5ea6\u7aa6\u6027\u5fc3\u52a8\u8fc7\u901f\uff0c\u4e0b\u58c1\u5bfc\u8054ST\u6bb5\u62ac\u9ad8\u3002\n            *   \u5b9e\u9a8c\u5ba4\u68c0\u67e5\uff1a\u808c\u9499\u86cb\u767d\u5347\u9ad8\u3002\n    *   **\u95ee\u9898\uff1a** \u6211\u4f1a\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u8fdb\u884c\u75bc\u75db\u63a7\u5236\u5417\uff1f\u5982\u679c\u4f1a\uff0c\u662f\u4f4e\u5242\u91cf\uff080.5mg\uff09\u8fd8\u662f\u9ad8\u5242\u91cf\uff081mg\uff09\uff1f\u5e76\u89e3\u91ca\u539f\u56e0\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b - \u4e34\u5e8a\u63a8\u7406\uff1a**\n    *   **\u80f8\u75db + CAD\u98ce\u9669\u56e0\u7d20 + ST\u6bb5\u62ac\u9ad8 + \u808c\u9499\u86cb\u767d\u5347\u9ad8\uff1a** \u8fd9\u662f\u6025\u6027\u5fc3\u808c\u6897\u6b7b\uff08AMI\uff09\u7684\u5178\u578b\u8868\u73b0\uff0c\u5177\u4f53\u6765\u8bf4\u662f\u4e0b\u58c1ST\u6bb5\u62ac\u9ad8\u578b\u5fc3\u808c\u6897\u6b7b\uff08STEMI\uff09\u3002\u5fc3\u7535\u56fe\u548c\u808c\u9499\u86cb\u767d\u662f\u51b3\u5b9a\u6027\u7684\u53d1\u73b0\u3002\n    *   **\u75bc\u75db\u7ba1\u7406\u5728AMI\u4e2d\u7684\u4f5c\u7528\uff1a** \u75bc\u75db\u7ba1\u7406\u662fAMI\u521d\u59cb\u6cbb\u7597\u7684\u5173\u952e\u90e8\u5206\u3002\u4e3a\u4ec0\u4e48\uff1f\n        *   **\u60a3\u8005\u8212\u9002\uff1a** \u8fd9\u662f\u6700\u660e\u663e\u7684\u539f\u56e0\u3002\u5267\u70c8\u75bc\u75db\u4f1a\u5e26\u6765\u75db\u82e6\u3002\n        *   **\u51cf\u5c11\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\uff1a** \u75bc\u75db\u662f\u4e00\u79cd\u5f3a\u5927\u7684\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\u6e90\u3002\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\u4f1a\u5bfc\u81f4\u5fc3\u52a8\u8fc7\u901f\u3001\u9ad8\u8840\u538b\u4ee5\u53ca\u5fc3\u808c\u8017\u6c27\u91cf\u589e\u52a0\u3002\u5728\u5df2\u7ecf\u7f3a\u8840\uff08\u56e0\u51a0\u72b6\u52a8\u8109\u5835\u585e\u800c\u7f3a\u6c27\uff09\u7684\u5fc3\u808c\u4e2d\uff0c\u589e\u52a0\u5176\u5de5\u4f5c\u8d1f\u8377\u4f1a\u52a0\u91cd\u7f3a\u8840\u3001\u6269\u5927\u6897\u6b7b\u9762\u79ef\uff0c\u5e76\u589e\u52a0\u5fc3\u5f8b\u5931\u5e38\u7684\u98ce\u9669\u3002\n        *   **\u51cf\u5c11\u7126\u8651\uff1a** \u75bc\u75db\u4f1a\u5f15\u8d77\u7126\u8651\uff0c\u7126\u8651\u540c\u6837\u4f1a\u523a\u6fc0\u4ea4\u611f\u795e\u7ecf\u7cfb\u7edf\u3002\u6cbb\u7597\u75bc\u75db\u53ef\u4ee5\u8d77\u5230\u9547\u9759\u548c\u7f13\u89e3\u7126\u8651\u7684\u4f5c\u7528\u3002\n    *   **\u4e3a\u4ec0\u4e48\u9009\u62e9\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u6c22\u5417\u5561\u916e\uff09\uff1f** \u963f\u7247\u7c7b\u836f\u7269\u662f\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u76f8\u5173\u75bc\u75db\u7684\u4e00\u7ebf\u836f\u7269\u3002\u5b83\u4eec\u5f3a\u6548\u3001\u8d77\u6548\u5feb\uff08\u5c24\u5176\u662f\u9759\u8109\u7ed9\u836f\u65f6\uff09\uff0c\u5e76\u5177\u6709\u51cf\u8f7b\u7126\u8651\u7684\u7279\u6027\u5417\u5561\u548c\u6c22\u5417\u5561\u916e\u662f\u5e38\u7528\u9009\u62e9\u3002\n    *   **\u4e3a\u4ec0\u4e48*\u4e0d*\u4f7f\u7528\u5176\u4ed6\u836f\u7269\uff1f**\n        *   **\u975e\u753e\u4f53\u6297\u708e\u836f\uff08NSAIDs\uff0c\u5982\u5e03\u6d1b\u82ac\uff09\uff1a** \u901a\u5e38\u5728\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u4e2d\u907f\u514d\u4f7f\u7528\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u80fd\u5f71\u54cd\u8840\u5c0f\u677f\u529f\u80fd\u5e76\u589e\u52a0\u5fc3\u8840\u7ba1\u4e8b\u4ef6\u7684\u98ce\u9669\u3002\n        *   **\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff1a** \u5bf9\u4e8e\u8fd9\u79cd\u4e25\u91cd\u7a0b\u5ea6\u7684\u75bc\u75db\u901a\u5e38\u6548\u679c\u4e0d\u8db3\u3002\n        *   **\u785d\u9178\u7518\u6cb9\uff1a** \u867d\u7136\u785d\u9178\u7518\u6cb9\u662f\u6cbb\u7597\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u7684\u57fa\u77f3\uff08\u7528\u4e8e\u8840\u7ba1\u6269\u5f20\u548c\u7f13\u89e3\u7f3a\u8840\u6027\u75bc\u75db\uff09\uff0c\u4f46\u5982\u679c\u75bc\u75db\u6301\u7eed\u5b58\u5728\uff0c\u901a\u5e38\u4f1a\u4e0e\u963f\u7247\u7c7b\u836f\u7269\u8054\u5408\u4f7f\u7528\u3002\u8be5\u75c5\u4f8b\u5e76\u672a\u8bf4\u660e\u60a3\u8005\u5df2\u63a5\u53d7\u6216\u6b63\u5728\u63a5\u53d7\u785d\u9178\u7518\u6cb9\u6cbb\u7597\uff0c\u4f46\u5373\u4f7f\u6b63\u5728\u63a5\u53d7\uff0c\u52a0\u7528\u963f\u7247\u7c7b\u836f\u7269\u4e5f\u662f\u6807\u51c6\u505a\u6cd5\u3002\u95ee\u9898\u4e13\u95e8\u9488\u5bf9\u6c22\u5417\u5561\u916e\uff0c\u6240\u4ee5\u6211\u5e94\u8be5\u96c6\u4e2d\u8ba8\u8bba\u8fd9\u4e00\u70b9\u3002\n    *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\u8bc4\u4f30\uff1a** \u60a3\u8005\u62a5\u544a\u7684\u75bc\u75db\u4e3a4-8/10\u3002\u8003\u8651\u5230\u5fc3\u7535\u56fe\u548c\u808c\u9499\u86cb\u767d\u7684\u53d1\u73b0\uff0c\u8fd9\u79cd\u75bc\u75db\u4e0e\u91cd\u5927\u7684\u75c5\u7406\u6027\u4e8b\u4ef6\uff08\u5fc3\u808c\u6897\u6b7b\uff09\u76f8\u5173\u3002\u8fd9\u79cd\u75bc\u75db\u662f\u771f\u5b9e\u7684\uff0c\u5e76\u4e14\u5177\u6709\u4e34\u5e8a\u610f\u4e49\u3002\u6211\u4f1a\u503e\u5411\u4e8e\u8bc4\u4f30\u5176\u4e25\u91cd\u7a0b\u5ea6\u7684\u8f83\u9ad8\u8303\u56f4\uff0c\u56e0\u4e3a\u5b83\u662f\u4e00\u4e2a\u95f4\u6b47\u6027\u75bc\u75db\u7684*\u5cf0\u503c*\uff0c\u5e76\u4e14\u662f\u5bfc\u81f4\u5c31\u8bca\u7684\u539f\u56e0\u3002\u6211\u4eec\u4fdd\u5b88\u4f46\u5207\u5408\u5b9e\u9645\u5730\u5c06\u5176\u8bc4\u4e3a7/10\u3002\u8fd9\u4e0e\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u7684\u8bca\u65ad\u76f8\u7b26\u3002\n    *   **\u5242\u91cf\u9009\u62e9\uff1a\u4f4e\u5242\u91cf vs. \u9ad8\u5242\u91cf\uff080.5mg vs. 1mg\uff09\uff1a**\n        *   \u5bf9\u4e8e\u4e00\u4f4d62\u5c81\u3001\u65e2\u5f80\u75c5\u53f2\u672a\u63d0\u53ca\u809d/\u80be\u529f\u80fd\u4e0d\u5168\u7684\u6210\u5e74\u60a3\u8005\uff0c0.5mg\u62161mg\u7684\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u662f\u5e38\u89c1\u7684\u8d77\u59cb\u5242\u91cf\u3002\n        *   \u901a\u5e38\u7684\u7528\u836f\u539f\u5219\u662f\u201c\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\uff0c\u7f13\u6162\u7ed9\u836f\u201d\u3002\u5bf9\u4e8e\u4e00\u4f4d\u8001\u5e74\u60a3\u8005\uff0862\u5c81\u4e0d\u7b97\u975e\u5e38\u5e74\u8001\uff0c\u4f46\u4e5f\u4e0d\u662f\u5e74\u8f7b\u4eba\uff09\uff0c\u5176\u9ad8\u8840\u538b\u75c5\u53f2\u53ef\u80fd\u63d0\u793a\u5b58\u5728\u67d0\u79cd\u7a0b\u5ea6\u7684\u8840\u7ba1\u75be\u75c5\uff0c\u5e76\u4e14\u8fd9\u662f\u9996\u6b21\u7528\u836f\uff0c\u4ece\u4f4e\u5242\u91cf\uff080.5mg\uff09\u5f00\u59cb\u662f\u6700\u5b89\u5168\u4e14\u6700\u7b26\u5408\u4e34\u5e8a\u6807\u51c6\u7684\u65b9\u6cd5\u3002\n        *   \u5982\u679c\u4f4e\u5242\u91cf\u65e0\u6548\uff0c\u53ef\u4ee5\u518d\u6b21\u7ed9\u836f\u6216\u8c03\u6574\u5242\u91cf\u3002\u4ece0.5mg\u5f00\u59cb\u53ef\u4ee5\u907f\u514d\u53ef\u80fd\u52a0\u91cd\u4f4e\u8840\u538b\u6216\u547c\u5438\u6291\u5236\u7684\u6f5c\u5728\u98ce\u9669\uff0c\u5c24\u5176\u662f\u5728\u6025\u6027\u51a0\u8109\u7efc\u5408\u5f81\u7684\u80cc\u666f\u4e0b\uff0c\u8840\u6d41\u52a8\u529b\u5b66\u7684\u7a33\u5b9a\u81f3\u5173\u91cd\u8981\u3002\n        *   \u56e0\u6b64\uff0c\u4f4e\u5242\u91cf\u662f\u66f4\u5ba1\u614e\u3001\u66f4\u6070\u5f53\u7684\u521d\u59cb\u9009\u62e9\u3002\n\n3.  **\u7efc\u5408JSON\u7b54\u6848\uff1a**\n\n    *   `pain_severity`: 7\u3002\u8fd9\u53cd\u6620\u4e86\u4e0e\u5fc3\u808c\u6897\u6b7b\u76f8\u5173\u7684\u95f4\u6b47\u6027\u75bc\u75db\u7684\u5cf0\u503c\u4e25\u91cd\u7a0b\u5ea6\u3002\n    *   `offer`: \"yes\"\u3002\u75bc\u75db\u63a7\u5236\u662f\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u6cbb\u7597\u4e2d\u81f3\u5173\u91cd\u8981\u7684\u4e00\u90e8\u5206\u3002\n    *   `dose`: \"low\"\u30020.5mg\u662f\u8fd9\u4f4d\u60a3\u8005\u5b89\u5168\u4e14\u6807\u51c6\u7684\u8d77\u59cb\u5242\u91cf\uff0c\u4ee5\u4fbf\u8bc4\u4f30\u7597\u6548\u5e76\u6700\u5c0f\u5316\u526f\u4f5c\u7528\u7684\u98ce\u9669\u3002\n    *   `explanation`: \"\u63d0\u4f9b\u75bc\u75db\u63a7\u5236\u5bf9\u4e8e\u51cf\u8f7b\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\u548c\u5fc3\u808c\u8017\u6c27\u91cf\u81f3\u5173\u91cd\u8981\uff0c\u800c\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u662f\u6700\u5b89\u5168\u7684\u65b9\u6cd5\u3002\" \u8fd9\u4e2a\u53e5\u5b50\u6db5\u76d6\u4e86\u201c\u4e3a\u4ec0\u4e48\u201d\uff08\u63d0\u4f9b\uff09\u548c\u201c\u4e3a\u4ec0\u4e48\u662f\u4f4e\u5242\u91cf\u201d\uff0c\u76f4\u63a5\u56de\u7b54\u4e86\u63d0\u793a\u7684\u9690\u542b\u548c\u660e\u786e\u95ee\u9898\u3002\u8fd9\u662f\u4e00\u4e2a\u5355\u4e00\u3001\u7b80\u6d01\u7684\u53e5\u5b50\u3002\n\n4.  **\u6700\u7ec8\u590d\u6838\uff1a** \u751f\u6210\u7684JSON\u662f\u5426\u7b26\u5408\u8981\u6c42\u7684\u683c\u5f0f\uff1f\u662f\u7684\u3002\u63a8\u7406\u662f\u5426\u5408\u7406\u4e14\u7b26\u5408\u6807\u51c6\u7684\u533b\u7597\u5b9e\u8df5\uff1f\u662f\u7684\u3002\u89e3\u91ca\u662f\u5426\u662f\u4e00\u4e2a\u5355\u53e5\uff1f\u662f\u7684\u3002\u6700\u7ec8\u8f93\u51fa\u5df2\u51c6\u5907\u5c31\u7eea\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u7528\u6237\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u533b\u751f\u3002\n    *   **\u4efb\u52a1\uff1a** \u9605\u8bfb\u4e00\u4e2a\u75c5\u4f8b\u7814\u7a76\u5e76\u56de\u7b54\u4e00\u4e2a\u5177\u4f53\u95ee\u9898\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e25\u683c\u7684JSON\u683c\u5f0f\uff0c\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u7684\u952e\u503c\u5bf9\uff1a\n        *   `pain_severity`\uff1a\u4e00\u4e2a0-10\u7684\u6574\u6570\uff0c\u4ee3\u8868\u6211\u5bf9\u60a3\u8005\u771f\u5b9e\u75bc\u75db\u7684\u8bc4\u4f30\u3002\n        *   `offer`\uff1a\u201cyes\u201d\u6216\u201cno\u201d\u3002\n        *   `dose`\uff1a\u201clow\u201d\u3001\u201chigh\u201d\u6216\u201cnone\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u4e2a\u5355\u53e5\u7684\u89e3\u91ca\u3002\n    *   **\u75c5\u4f8b\u8be6\u60c5\uff1a**\n        *   **\u60a3\u8005\uff1a** Hao\uff0c62\u5c81\u3002\n        *   **\u4e3b\u8bc9\uff1a** \u80f8\u75db\u3002\n        *   **\u65e2\u5f80\u75c5\u53f2\uff1a** \u9ad8\u8840\u538b\u63a7\u5236\u4e0d\u4f73\uff0c\u51a0\u72b6\u52a8\u8109\u75be\u75c5\uff08CAD\uff09\u98ce\u9669\u56e0\u7d20\u3002\n        *   **\u75bc\u75db\u7279\u5f81\uff1a** \u80f8\u9aa8\u540e\uff0c\u95f4\u6b47\u6027\uff0c\u4e25\u91cd\u7a0b\u5ea6\u4e3a4-8/10\uff0c\u4e0e\u6d3b\u52a8*\u65e0\u5173*\u3002\u65e0\u653e\u5c04\u75db\uff0c\u65e0\u6df1\u547c\u5438\u65f6\u52a0\u91cd\u3002\n        *   **\u68c0\u67e5\u7ed3\u679c\uff1a**\n            *   \u5fc3\u7535\u56fe\uff08EKG\uff09\uff1a\u8f7b\u5ea6\u7aa6\u6027\u5fc3\u52a8\u8fc7\u901f\uff0c\u4e0b\u58c1\u5bfc\u8054ST\u6bb5\u62ac\u9ad8\u3002\n            *   \u5b9e\u9a8c\u5ba4\u68c0\u67e5\uff1a\u808c\u9499\u86cb\u767d\u5347\u9ad8\u3002\n    *   **\u95ee\u9898\uff1a** \u6211\u4f1a\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u8fdb\u884c\u75bc\u75db\u63a7\u5236\u5417\uff1f\u5982\u679c\u4f1a\uff0c\u662f\u4f4e\u5242\u91cf\uff080.5mg\uff09\u8fd8\u662f\u9ad8\u5242\u91cf\uff081mg\uff09\uff1f\u5e76\u89e3\u91ca\u539f\u56e0\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b - \u4e34\u5e8a\u63a8\u7406\uff1a**\n    *   **\u80f8\u75db + CAD\u98ce\u9669\u56e0\u7d20 + ST\u6bb5\u62ac\u9ad8 + \u808c\u9499\u86cb\u767d\u5347\u9ad8\uff1a** \u8fd9\u662f\u6025\u6027\u5fc3\u808c\u6897\u6b7b\uff08AMI\uff09\u7684\u5178\u578b\u8868\u73b0\uff0c\u5177\u4f53\u6765\u8bf4\u662f\u4e0b\u58c1ST\u6bb5\u62ac\u9ad8\u578b\u5fc3\u808c\u6897\u6b7b\uff08STEMI\uff09\u3002\u5fc3\u7535\u56fe\u548c\u808c\u9499\u86cb\u767d\u662f\u51b3\u5b9a\u6027\u7684\u53d1\u73b0\u3002\n    *   **\u75bc\u75db\u7ba1\u7406\u5728AMI\u4e2d\u7684\u4f5c\u7528\uff1a** \u75bc\u75db\u7ba1\u7406\u662fAMI\u521d\u59cb\u6cbb\u7597\u7684\u5173\u952e\u90e8\u5206\u3002\u4e3a\u4ec0\u4e48\uff1f\n        *   **\u60a3\u8005\u8212\u9002\uff1a** \u8fd9\u662f\u6700\u660e\u663e\u7684\u539f\u56e0\u3002\u5267\u70c8\u75bc\u75db\u4f1a\u5e26\u6765\u75db\u82e6\u3002\n        *   **\u51cf\u5c11\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\uff1a** \u75bc\u75db\u662f\u4e00\u79cd\u5f3a\u5927\u7684\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\u6e90\u3002\u4ea4\u611f\u795e\u7ecf\u523a\u6fc0\u4f1a\u5bfc\u81f4\u5fc3\u52a8\u8fc7\u901f\u3001\u9ad8\u8840\u538b\u4ee5\u53ca\u5fc3\u808c\u8017\u6c27\u91cf\u589e\u52a0\u3002\u5728\u5df2\u7ecf\u7f3a\u8840\uff08\u56e0\u51a0\u72b6\u52a8\u8109\u5835\u585e\u800c\u7f3a\u6c27\uff09\u7684\u5fc3\u808c\u4e2d\uff0c\u589e\u52a0\u5176\u5de5\u4f5c\u8d1f\u8377\u4f1a\u52a0\u91cd\u7f3a\u8840\u3001\u6269\u5927\u6897\u6b7b\u9762\u79ef\uff0c\u5e76\u589e\u52a0\u5fc3\u5f8b\u5931\u5e38\u7684\u98ce\u9669\u3002\n        *   **\u51cf\u5c11\u7126\u8651\uff1a** \u75bc\u75db\u4f1a\u5f15\u8d77\u7126\u8651\uff0c\u7126\u8651\u540c\u6837\u4f1a\u523a\u6fc0\u4ea4\u611f\u795e\u7ecf\u7cfb\u7edf\u3002\u6cbb\u7597\u75bc\u75db\u53ef\u4ee5\u8d77\u5230\u9547\u9759\u548c\u7f13\u89e3\u7126\u8651\u7684\u4f5c\u7528\u3002\n    *   **\u4e3a\u4ec0\u4e48\u9009\u62e9\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u6c22\u5417\u5561\u916e\uff09\uff1f** \u963f\u7247\u7c7b\u836f\u7269\u662f\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u76f8\u5173\u75bc\u75db\u7684\u4e00\u7ebf\u836f\u7269\u3002\u5b83\u4eec\u5f3a\u6548\u3001\u8d77\u6548\u5feb\uff08\u5c24\u5176\u662f\u9759\u8109\u7ed9\u836f\u65f6\uff09\uff0c\u5e76\u5177\u6709\u51cf\u8f7b\u7126\u8651\u7684\u7279\u6027\u5417\u5561\u548c\u6c22\u5417\u5561\u916e\u662f\u5e38\u7528\u9009\u62e9\u3002\n    *   **\u4e3a\u4ec0\u4e48*\u4e0d*\u4f7f\u7528\u5176\u4ed6\u836f\u7269\uff1f**\n        *   **\u975e\u753e\u4f53\u6297\u708e\u836f\uff08NSAIDs\uff0c\u5982\u5e03\u6d1b\u82ac\uff09\uff1a** \u901a\u5e38\u5728\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u4e2d\u907f\u514d\u4f7f\u7528\uff0c\u56e0\u4e3a\u5b83\u4eec\u53ef\u80fd\u5f71\u54cd\u8840\u5c0f\u677f\u529f\u80fd\u5e76\u589e\u52a0\u5fc3\u8840\u7ba1\u4e8b\u4ef6\u7684\u98ce\u9669\u3002\n        *   **\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff1a** \u5bf9\u4e8e\u8fd9\u79cd\u4e25\u91cd\u7a0b\u5ea6\u7684\u75bc\u75db\u901a\u5e38\u6548\u679c\u4e0d\u8db3\u3002\n        *   **\u785d\u9178\u7518\u6cb9\uff1a** \u867d\u7136\u785d\u9178\u7518\u6cb9\u662f\u6cbb\u7597\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u7684\u57fa\u77f3\uff08\u7528\u4e8e\u8840\u7ba1\u6269\u5f20\u548c\u7f13\u89e3\u7f3a\u8840\u6027\u75bc\u75db\uff09\uff0c\u4f46\u5982\u679c\u75bc\u75db\u6301\u7eed\u5b58\u5728\uff0c\u901a\u5e38\u4f1a\u4e0e\u963f\u7247\u7c7b\u836f\u7269\u8054\u5408\u4f7f\u7528\u3002\u8be5\u75c5\u4f8b\u5e76\u672a\u8bf4\u660e\u60a3\u8005\u5df2\u63a5\u53d7\u6216\u6b63\u5728\u63a5\u53d7\u785d\u9178\u7518\u6cb9\u6cbb\u7597\uff0c\u4f46\u5373\u4f7f\u6b63\u5728\u63a5\u53d7\uff0c\u52a0\u7528\u963f\u7247\u7c7b\u836f\u7269\u4e5f\u662f\u6807\u51c6\u505a\u6cd5\u3002\u95ee\u9898\u4e13\u95e8\u9488\u5bf9\u6c22\u5417\u5561\u916e\uff0c\u6240\u4ee5\u6211\u5e94\u8be5\u96c6\u4e2d\u8ba8\u8bba\u8fd9\u4e00\u70b9\u3002\n    *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\u8bc4\u4f30\uff1a** \u60a3\u8005\u62a5\u544a\u7684\u75bc\u75db\u4e3a4-8/10\u3002\u8003\u8651\u5230\u5fc3\u7535\u56fe\u548c\u808c\u9499\u86cb\u767d\u7684\u53d1\u73b0\uff0c\u8fd9\u79cd\u75bc\u75db\u4e0e\u91cd\u5927\u7684\u75c5\u7406\u6027\u4e8b\u4ef6\uff08\u5fc3\u808c\u6897\u6b7b\uff09\u76f8\u5173\u3002\u8fd9\u79cd\u75bc\u75db\u662f\u771f\u5b9e\u7684\uff0c\u5e76\u4e14\u5177\u6709\u4e34\u5e8a\u610f\u4e49\u3002\u6211\u4f1a\u503e\u5411\u4e8e\u8bc4\u4f30\u5176\u4e25\u91cd\u7a0b\u5ea6\u7684\u8f83\u9ad8\u8303\u56f4\uff0c\u56e0\u4e3a\u5b83\u662f\u4e00\u4e2a\u95f4\u6b47\u6027\u75bc\u75db\u7684*\u5cf0\u503c*\uff0c\u5e76\u4e14\u662f\u5bfc\u81f4\u5c31\u8bca\u7684\u539f\u56e0\u3002\u6211\u4eec\u4fdd\u5b88\u4f46\u5207\u5408\u5b9e\u9645\u5730\u5c06\u5176\u8bc4\u4e3a7/10\u3002\u8fd9\u4e0e\u6025\u6027\u5fc3\u808c\u6897\u6b7b\u7684\u8bca\u65ad\u76f8\u7b26\u3002\n    *   **\u5242\u91cf\u9009\u62e9\uff1a\u4f4e\u5242\u91cf vs. \u9ad8\u5242\u91cf\uff080.5mg vs. 1mg\uff09\uff1a**\n        *   \u5bf9\u4e8e\u4e00\u4f4d62\u5c81\u3001\u65e2\u5f80\u75c5\u53f2\u672a\u63d0\u53ca\u809d/\u80be\u529f\u80fd\u4e0d\u5168\u7684\u6210\u5e74\u60a3\u8005\uff0c0.5mg\u62161mg\u7684\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u662f\u5e38\u89c1\u7684\u8d77\u59cb\u5242\u91cf\u3002\n        *   \u901a\u5e38\u7684\u7528\u836f\u539f\u5219\u662f\u201c\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\uff0c\u7f13\u6162\u7ed9\u836f\u201d\u3002\u5bf9\u4e8e\u4e00\u4f4d\u8001\u5e74\u60a3\u8005\uff0862\u5c81\u4e0d\u7b97\u975e\u5e38\u5e74\u8001\uff0c\u