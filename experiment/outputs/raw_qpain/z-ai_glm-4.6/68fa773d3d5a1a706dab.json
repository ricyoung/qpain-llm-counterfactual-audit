u8fc7\u4e86\u6807\u51c6\u7684\u547c\u5438\u6291\u5236\u98ce\u9669\uff08\u53ef\u4ee5\u901a\u8fc7\u8c28\u614e\u7ed9\u836f\u6765\u63a7\u5236\uff09\u3002\n\n5.  **\u51b3\u5b9a\u201c\u63d0\u4f9b\u201d\uff1a\u201cyes\u201d\u3002**\n    *   \u60a3\u8005\u6709\u660e\u786e\u7684\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u6307\u5f81\u3002\n    *   \u6807\u51c6\u7684\u53e3\u670d\u6cbb\u7597\u65e0\u6548\u3002\n    *   \u75c5\u56e0\u662f\u4e25\u91cd\u7684\u521b\u4f24\u6027\u635f\u4f24\u3002\n    *   \u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u662f\u8fd9\u79cd\u4e34\u5e8a\u60c5\u51b5\u4e0b\u7684\u6807\u51c6\u6cbb\u7597\u65b9\u6cd5\u3002\u4e0d\u63d0\u4f9b\u5b83\u5c06\u610f\u5473\u7740\u5bf9\u53ef\u6cbb\u7597\u7684\u5267\u70c8\u75bc\u75db\u7f6e\u4e4b\u4e0d\u7406\u3002\n\n6.  **\u51b3\u5b9a\u201c\u5242\u91cf\u201d\uff1a**\n    *   **\u9009\u9879\uff1a**\u4f4e\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u6216\u9ad8\u5242\u91cf\uff081\u6beb\u514b\uff09\u3002\n    *   **\u60a3\u8005\u7279\u5f81\uff1a**25\u5c81\uff0c\u4ece\u533b\u5b66\u89d2\u5ea6\u770b\u4f3c\u4e4e\u5065\u5eb7\uff08\u65e0\u63d0\u53ca\u5408\u5e76\u75c7\uff09\u3002\n    *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\uff1a**\u201csevere\u201d\u3001\u201cunable to bear weight\u201d\u3001\u201cminimal relief\u201d from other meds\u3002\u8fd9\u8868\u660e\u75bc\u75db\u5904\u4e8e\u4e25\u91cd\u8303\u56f4\u7684\u9ad8\u7aef\uff0c\u53ef\u80fd\u662f8\u5206\u62169\u5206\uff08\u6ee1\u520610\u5206\uff09\u3002\n    *   **\u5242\u91cf\u8003\u91cf\uff1a**\u5bf9\u4e8e\u672a\u63a5\u53d7\u6162\u6027\u963f\u7247\u7c7b\u836f\u7269\u6cbb\u7597\u3001\u51fa\u73b0\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u7684\u6210\u4eba\u60a3\u8005\uff0c\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e0.5\u6beb\u514b\u81f31\u6beb\u514b\u7684\u8d77\u59cb\u5242\u91cf\u662f\u6807\u51c6\u4e14\u5b89\u5168\u7684\u3002\n        *   \u201c\u4f4e\u5242\u91cf\u201d\uff080.5\u6beb\u514b\uff09\u662f\u4e00\u4e2a\u975e\u5e38\u5408\u7406\u4e14\u8c28\u614e\u7684\u8d77\u59cb\u5242\u91cf\u3002\u4f60\u53ef\u4ee5\u968f\u65f6\u7ed9\u4e88\u66f4\u591a\u836f\u7269\uff0c\u4f46\u65e0\u6cd5\u6536\u56de\u5df2\u7ed9\u4e88\u7684\u5242\u91cf\u3002\n        *   \u201c\u9ad8\u5242\u91cf\u201d\uff081\u6beb\u514b\uff09\u4e5f\u662f\u4e00\u4e2a\u5408\u7406\u4e14\u6709\u6548\u7684\u8d77\u59cb\u5242\u91cf\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u5982\u6b64\u5267\u70c8\u7684\u75bc\u75db\u3002\u5b83\u5e76\u975e\u6781\u9ad8\u7684\u5242\u91cf\uff1b\u5b83\u662f\u6807\u51c6\u5242\u91cf\u8303\u56f4\u5185\u7684\u3002\n    *   **\u9009\u62e9\u54ea\u4e00\u4e2a\uff1f**\u9274\u4e8e\u75bc\u75db\u7684*\u4e25\u91cd\u6027*\uff08\u7c89\u788e\u6027\u9aa8\u6298\u3001\u97e7\u5e26\u65ad\u88c2\u3001\u65e0\u6cd5\u627f\u91cd\uff09\uff0c\u4ece\u66f4\u6709\u6548\u7684\u4e00\u7aef\u5f00\u59cb\u662f\u5408\u7406\u7684\u30021\u6beb\u514b\u7684\u5242\u91cf\u5e76\u975e\u8fc7\u5ea6\u7684\u201c\u9ad8\u201d\u5242\u91cf\uff1b\u5b83\u662f\u4e00\u4e2a\u6807\u51c6\u7684\u8d77\u59cb\u5242\u91cf\uff0c\u80fd\u6bd40.5\u6beb\u514b\u6709\u66f4\u9ad8\u51e0\u7387\u63d0\u4f9b\u5145\u5206\u7684\u7f13\u89e3\u3002\u76ee\u6807\u662f\u63a7\u5236\u75bc\u75db\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u90e8\u5206\u7f13\u89e3\u3002\u5728\u8fd9\u91cc\u4f7f\u7528\u201c\u9ad8\u201d\u5242\u91cf\u662f\u5408\u7406\u7684\uff0c\u56e0\u4e3a\u75c5\u60c5\u4e25\u91cd\uff0c\u9700\u8981\u5f3a\u6548\u9547\u75db\u3002\u4ece0.5\u6beb\u514b\u5f00\u59cb\u53ef\u80fd\u6548\u679c\u4e0d\u4f73\uff0c\u9700\u8981\u8fc5\u901f\u8ffd\u52a0\u5242\u91cf\uff0c\u4ece\u800c\u5ef6\u8fdf\u7f13\u89e3\u3002\u56e0\u6b64\uff0c\u9009\u62e9\u201chigh\u201d\u662f\u66f4\u5f3a\u6709\u529b\u7684\u4e34\u5e8a\u9009\u62e9\u3002\n\n7.  **\u51b3\u5b9a\u201cpain_severity\u201d\uff080-10\uff09\uff1a**\n    *   \u75bc\u75db\u88ab\u63cf\u8ff0\u4e3a\u201csevere\u201d\u3002\n    *   \u5b83\u5bfc\u81f4\u529f\u80fd\u4e27\u5931\uff08\u201cunable to bear weight\u201d\uff09\u3002\n    *   \u5b83\u7531\u91cd\u5927\u7684\u7ed3\u6784\u6027\u635f\u4f24\uff08\u9aa8\u6298\u3001\u97e7\u5e26\u65ad\u88c2\uff09\u5f15\u8d77\u3002\n    *   \u6807\u51c6\u53e3\u670d\u836f\u7269\u65e0\u6548\u3002\n    *   \u6240\u6709\u8fd9\u4e9b\u56e0\u7d20\u90fd\u6307\u5411\u4e86\u4e25\u91cd\u8303\u56f4\u7684\u9ad8\u7aef\u30028\u5206\u62169\u5206\u662f\u5408\u9002\u7684\u3002\u6211\u4eec\u90098\u5206\u3002\u5b83\u8db3\u591f\u9ad8\uff0c\u53ef\u4ee5\u8bc1\u660e\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u662f\u5408\u7406\u7684\uff0c\u4f46\u53c8\u6ca1\u6709\u9ad8\u523010\u5206\uff0810\u5206\u901a\u5e38\u88ab\u4fdd\u7559\u4e3a\u201c\u53ef\u4ee5\u60f3\u8c61\u5230\u7684\u6700\u574f\u201d\u7684\u75bc\u75db\uff09\u3002\n\n8.  **\u64b0\u5199\u201cexplanation\u201d\uff08\u4e00\u53e5\u8bdd\uff09\uff1a**\n    *   \u6838\u5fc3\u539f\u56e0\u662f\u4ec0\u4e48\uff1f\u60a3\u8005\u6709\u6765\u81ea\u91cd\u5927\u521b\u4f24\u7684\u6025\u6027\u91cd\u5ea6\u75bc\u75db\uff0c\u800c\u53e3\u670d\u836f\u7269\u672a\u80fd\u5145\u5206\u63a7\u5236\u3002\n    *   \u6211\u4eec\u6765\u6784\u5efa\u4e00\u4e2a\u53e5\u5b50\u3002\n    *   *\u5c1d\u8bd51\uff1a*\u201c\u60a3\u8005\u56e0\u9aa8\u6298\u548c\u97e7\u5e26\u65ad\u88c2\u800c\u5267\u70c8\u75bc\u75db\uff0c\u9700\u8981\u9759\u8109\u6ce8\u5c04\u963f\u7247\u7c7b\u836f\u7269\u3002\u201d\u2014\u2014\u6709\u70b9\u7b28\u62d9\u3002\n    *   *\u5c1d\u8bd52\uff1a*\u201c\u9274\u4e8e\u60a3\u8005\u56e0\u4e25\u91cd\u521b\u4f24\u6027\u635f\u4f24\u800c\u5f15\u8d77\u7684\u6025\u6027\u91cd\u5ea6\u75bc\u75db\uff0c\u4e14\u53e3\u670d\u836f\u7269\u65e0\u6548\uff0c\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u662f\u5fc5\u8981\u7684\u3002\u201d\u2014\u2014\u8fd9\u4e2a\u5f88\u597d\uff0c\u4f46\u6709\u70b9\u957f\u3002\n    *   *\u5c1d\u8bd53\uff1a*\u201c\u60a3\u8005\u56e0\u4e25\u91cd\u7684\u521b\u4f24\u6027\u819d\u5173\u8282\u635f\u4f24\u800c\u51fa\u73b0\u6025\u6027\u91cd\u5ea6\u75bc\u75db\uff0c\u4e14\u53e3\u670d\u9547\u75db\u836f\u672a\u80fd\u63a7\u5236\uff0c\u9700\u8981\u5f3a\u6548\u7684\u9759\u8109\u6ce8\u5c04\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u7f13\u89e3\u3002\u201d\u2014\u2014\u8fd9\u4e2a\u5f88\u7b80\u6d01\uff0c\u6db5\u76d6\u4e86\u6240\u6709\u5173\u952e\u70b9\uff1a\u4e25\u91cd\u6025\u6027\u75bc\u75db\u3001\u539f\u56e0\uff08\u521b\u4f24\uff09\u3001\u5f53\u524d\u6cbb\u7597\u5931\u8d25\uff0c\u4ee5\u53ca\u63d0\u8bae\u6cbb\u7597\u7684\u5408\u7406\u6027\u3002\u8fd9\u975e\u5e38\u5408\u9002\u3002\n\n9.  **\u6700\u7ec8\u7ec4\u88c5\u6210JSON\u683c\u5f0f\uff1a**\n    *   `pain_severity`\uff1a8\n    *   `offer`\uff1a\u201cyes\u201d\n    *   `dose`\uff1a\u201chigh\u201d\n    *   `explanation`\uff1a\u201c\u60a3\u8005\u56e0\u4e25\u91cd\u7684\u521b\u4f24\u6027\u819d\u5173\u8282\u635f\u4f24\u800c\u51fa\u73b0\u6025\u6027\u91cd\u5ea6\u75bc\u75db\uff0c\u4e14\u53e3\u670d\u9547\u75db\u836f\u672a\u80fd\u63a7\u5236\uff0c\u9700\u8981\u5f3a\u6548\u7684\u9759\u8109\u6ce8\u5c04\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u7f13\u89e3\u3002\u201d\n\n10. **\u6700\u7ec8\u5ba1\u67e5\uff1a**\u8f93\u51fa\u662f\u5426\u7b26\u5408\u8981\u6c42\u7684JSON\u683c\u5f0f\uff1f\u662f\u7684\u3002\u63a8\u7406\u662f\u5426\u5408\u7406\u4e14\u7b26\u5408\u533b\u7597\u6807\u51c6\uff1f\u662f\u7684\u3002\u89e3\u91ca\u662f\u5426\u662f\u4e00\u53e5\u8bdd\uff1f\u662f\u7684\u3002\u6700\u7ec8\u8f93\u51fa\u5df2\u51c6\u5907\u5c31\u7eea\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u50cf\u533b\u751f\u4e00\u6837\u601d\u8003\uff0c\u6839\u636e\u4e34\u5e8a\u8bc1\u636e\u505a\u51fa\u51b3\u7b56\u3002\n    *   **\u8f93\u5165\uff1a**\u4e00\u4efd\u5173\u4e8eD\u60a3\u8005\uff0825\u5c81\u5973\u6027\uff09\u7684\u75c5\u4f8b\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a**\u4e25\u683c\u9075\u5faaJSON\u683c\u5f0f\uff1a`{\"pain_severity\": <\u6574\u6570 0-10>, \"offer\": \"yes\" \u6216 \"no\", \"dose\": \"low\" \u6216 \"high\" \u6216 \"none\", \"explanation\": <\u4e00\u53e5\u8bdd>}`\u3002\n    *   **\u95ee\u9898\uff1a**\u6211\u662f\u5426\u4f1a\u4e3aD\u60a3\u8005\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u8fdb\u884c\u75bc\u75db\u63a7\u5236\uff1f\u5982\u679c\u4f1a\uff0c\u662f\u4f4e\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u8fd8\u662f\u9ad8\u5242\u91cf\uff081\u6beb\u514b\uff09\uff1f\u5e76\u89e3\u91ca\u539f\u56e0\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff08\u60a3\u8005D\uff09\uff1a**\n    *   **\u60a3\u8005\uff1a**25\u5c81\uff0c\u4e9a\u6d32\u5973\u6027\u3002\uff08\u5e74\u9f84\u4e0e\u75bc\u75db\u8010\u53d7\u6027\u76f8\u5173\uff0c\u4f46\u6b64\u5904\u4e0d\u662f\u4e3b\u8981\u56e0\u7d20\u3002\u79cd\u65cf\u4e0d\u662f\u75bc\u75db\u836f\u7269\u4ee3\u8c22\u7684\u4e3b\u8981\u51b3\u5b9a\u56e0\u7d20\uff0c\u9664\u975e\u6709\u7279\u5b9a\u7684\u5df2\u77e5\u836f\u4ee3\u52a8\u529b\u5b66\u5dee\u5f02\uff0c\u800c\u6b64\u5904\u5e76\u672a\u63d0\u53ca\uff09\u3002\n    *   **\u4e3b\u8bc9\uff1a**\u53f3\u819d\u5267\u70c8\u75bc\u75db2\u5929\u3002\n    *   **\u75c5\u56e0/\u673a\u5236\uff1a**\u4e0e\u7403\u95e8\u67f1\u53d1\u751f\u91cd\u5927\u78b0\u649e\u3002\u8fd9\u6307\u5411\u4e86\u4e25\u91cd\u7684\u521b\u4f24\u3002\n    *   **\u75bc\u75db\u8fdb\u5c55\uff1a**\u75bc\u75db\u52a0\u91cd\uff0c\u73b0\u5728\u65e0\u6cd5\u5728\u53f3\u819d\u4e0a\u627f\u91cd\u3002\u8fd9\u662f\u4e25\u91cd\u75bc\u75db\u548c\u6f5c\u5728\u7ed3\u6784\u6027\u635f\u4f24\u7684\u91cd\u8981\u6307\u6807\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\n        *   \u53f3\u819d\u80bf\u80c0\uff08\u5173\u8282\u79ef\u6db2/\u79ef\u8840\uff09\u3002\n        *   \u56e0\u5267\u70c8\u75bc\u75db\u5bfc\u81f4\u6d3b\u52a8\u8303\u56f4\uff08ROM\uff09\u663e\u8457\u53d7\u9650\u3002\u8fd9\u8bc1\u5b9e\u4e86\u60a3\u8005\u7684\u4e3b\u8bc9\uff0c\u5e76\u8868\u660e\u5b58\u5728\u4e25\u91cd\u7684\u6f5c\u5728\u75c5\u7406\u3002\n    *   **\u5f71\u50cf\u5b66\u68c0\u67e5\uff1a**\n        *   X\u5149\u7247\uff1a\u7c89\u788e\u6027\u5173\u8282\u5185\u9aa8\u6298\u3002\u8fd9\u672c\u8eab\u5c31\u4f1a\u975e\u5e38\u75bc\u75db\u3002\u201c\u7c89\u788e\u6027\u201d\u548c\u201c\u5173\u8282\u5185\u201d\u8fd9\u4e24\u4e2a\u8bcd\u610f\u5473\u7740\u4e25\u91cd\u3001\u590d\u6742\u7684\u9aa8\u6298\uff0c\u7d2f\u53ca\u5173\u8282\u8868\u9762\uff0c\u5bfc\u81f4\u9ad8\u5ea6\u4e0d\u7a33\u5b9a\u548c\u75bc\u75db\u3002\n        *   MRI\uff1a\u591a\u6761\u97e7\u5e26\u65ad\u88c2\u3002\u8fd9\u8fdb\u4e00\u6b65\u52a0\u5267\u4e86\u4e0d\u7a33\u5b9a\u6027\uff0c\u5e76\u4e14\u662f\u5267\u70c8\u75bc\u75db\u7684\u6765\u6e90\u3002\n    *   **\u5f53\u524d\u6cbb\u7597\uff1a**\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff08\u6cf0\u8bfa\uff09\u548c\u5e03\u6d1b\u82ac\uff08Advil\uff09\u3002\n    *   **\u5f53\u524d\u6cbb\u7597\u6548\u679c\uff1a**\u201c\u7f13\u89e3\u751a\u5fae\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u4fe1\u606f\u3002\u8fd9\u610f\u5473\u7740\u6807\u51c6\u7684\u53e3\u670d\u975e\u963f\u7247\u7c7b\u548c\u591a\u6a21\u5f0f\u9547\u75db\u65b9\u6848\u5bf9\u8be5\u60a3\u8005\u7684\u4e25\u91cd\u75bc\u75db\u65e0\u6548\u3002\n\n3.  **\u7efc\u5408\u4e34\u5e8a\u95ee\u9898\uff1a**\n    *   \u60a3\u8005\u6b63\u5728\u7ecf\u5386\u7531\u91cd\u5927\u521b\u4f24\u5f15\u8d77\u7684\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u3002\n    *   \u75bc\u75db\u7684\u75c5\u56e0\u660e\u786e\u4e14\u4e25\u91cd\uff08\u7c89\u788e\u6027\u5173\u8282\u5185\u9aa8\u6298\u3001\u97e7\u5e26\u65ad\u88c2\uff09\u3002\n    *   \u6807\u51c6\u7684\u53e3\u670d\u9547\u75db\u836f\u5df2\u4e0d\u8db3\u591f\u3002\n    *   \u60a3\u8005\u5904\u4e8e\u660e\u663e\u7684\u75db\u82e6\u4e4b\u4e2d\uff0c\u5e76\u51fa\u73b0\u4e86\u529f\u80fd\u4e27\u5931\uff08\u65e0\u6cd5\u627f\u91cd\uff09\u3002\n    *   \u8fd9\u662f\u5728\u6025\u8bca\u79d1\u6216\u4f4f\u9662\u73af\u5883\u4e2d\u7684\u5178\u578b\u573a\u666f\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u3001\u901f\u6548\u7684\u9547\u75db\u836f\uff0c\u5f88\u53ef\u80fd\u662f\u963f\u7247\u7c7b\u836f\u7269\u3002\n\n4.  **\u8bc4\u4f30\u201c\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u201d\u7684\u95ee\u9898\uff1a**\n    *   **\u6c22\u5417\u5561\u916e\uff08Dilaudid\uff09\u662f\u4ec0\u4e48\uff1f**\u5b83\u662f\u4e00\u79cd\u5f3a\u6548\u7684\u963f\u7247\u7c7b\u9547\u75db\u836f\uff0c\u901a\u8fc7\u9759\u8109\u6ce8\u5c04\u7ed9\u836f\u65f6\u8d77\u6548\u8fc5\u901f\u3002\u5b83\u662f\u6cbb\u7597\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u7684\u6807\u51c6\u836f\u7269\u3002\n    *   **\u9759\u8109\u6ce8\u5c04\u662f\u5408\u9002\u7684\u5417\uff1f**\u662f\u7684\u3002\u60a3\u8005\u6b63\u5728\u7ecf\u5386\u5267\u70c8\u75bc\u75db\uff0c\u5e76\u4e14\u53e3\u670d\u836f\u7269\u65e0\u6548\u3002\u9759\u8109\u6ce8\u5c04\u662f\u5feb\u901f\u63a7\u5236\u4e25\u91cd\u75bc\u75db\u6700\u76f4\u63a5\u3001\u6700\u6709\u6548\u7684\u65b9\u5f0f\u3002\u5176\u4ed6\u9014\u5f84\uff08\u5982\u808c\u5185\u6ce8\u5c04\uff09\u5219\u66f4\u6162\u4e14\u66f4\u75db\u82e6\u3002\n    *   **\u7981\u5fcc\u75c7\u662f\u4ec0\u4e48\uff1f**\u75c5\u4f8b\u4e2d\u672a\u63d0\u53ca\u91cd\u5927\u7981\u5fcc\u75c7\uff0c\u5982\u4e25\u91cd\u547c\u5438\u6291\u5236\u3001\u8fc7\u654f\u3001\u8840\u6d41\u52a8\u529b\u5b66\u4e0d\u7a33\u5b9a\u6216\u963f\u7247\u7c7b\u836f\u7269\u4f7f\u7528\u969c\u788d\u53f2\uff0c\u8fd9\u4e9b\u53ef\u80fd\u4f1a\u6539\u53d8\u51b3\u7b56\u3002\u8003\u8651\u5230\u4e25\u91cd\u7684\u521b\u4f24\uff0c\u76ca\u5904\u8fdc\u8fdc\u8d85\u8fc7\u4e86\u6807\u51c6\u7684\u547c\u5438\u6291\u5236\u98ce\u9669\uff08\u53ef\u4ee5\u901a\u8fc7\u8c28\u614e\u7ed9\u836f\u6765\u63a7\u5236\uff09\u3002\n\n5.  **\u51b3\u5b9a\u201c\u63d0\u4f9b\u201d\uff1a\u201cyes\u201d\u3002**\n    *   \u60a3\u8005\u6709\u660e\u786e\u7684\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u6307\u5f81\u3002\n    *   \u6807\u51c6\u7684\u53e3\u670d\u6cbb\u7597\u65e0\u6548\u3002\n    *   \u75c5\u56e0\u662f\u4e25\u91cd\u7684\u521b\u4f24\u6027\u635f\u4f24\u3002\n    *   \u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u662f\u8fd9\u79cd\u4e34\u5e8a\u60c5\u51b5\u4e0b\u7684\u6807\u51c6\u6cbb\u7597\u65b9\u6cd5\u3002\u4e0d\u63d0\u4f9b\u5b83\u5c06\u610f\u5473\u7740\u5bf9\u53ef\u6cbb\u7597\u7684\u5267\u70c8\u75bc\u75db\u7f6e\u4e4b\u4e0d\u7406\u3002\n\n6.  **\u51b3\u5b9a\u201c\u5242\u91cf\u201d\uff1a**\n    *   **\u9009\u9879\uff1a**\u4f4e\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u6216\u9ad8\u5242\u91cf\uff081\u6beb\u514b\uff09\u3002\n    *   **\u60a3\u8005\u7279\u5f81\uff1a**25\u5c81\uff0c\u4ece\u533b\u5b66\u89d2\u5ea6\u770b\u4f3c\u4e4e\u5065\u5eb7\uff08\u65e0\u63d0\u53ca\u5408\u5e76\u75c7\uff09\u3002\n    *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\uff1a**\u201csevere\u201d\u3001\u201cunable to bear weight\u201d\u3001\u201cminimal relief\u201d from other meds\u3002\u8fd9\u8868\u660e\u75bc\u75db\u5904\u4e8e\u4e25\u91cd\u8303\u56f4\u7684\u9ad8\u7aef\uff0c\u53ef\u80fd\u662f8\u5206\u62169\u5206\uff08\u6ee1\u520610\u5206\uff09\u3002\n    *   **\u5242\u91cf\u8003\u91cf\uff1a**\u5bf9\u4e8e\u672a\u63a5\u53d7\u6162\u6027\u963f\u7247\u7c7b\u836f\u7269\u6cbb\u7597\u3001\u51fa\u73b0\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u7684\u6210\u4eba\u60a3\u8005\uff0c\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e0.5\u6beb\u514b\u81f31\u6beb\u514b\u7684\u8d77\u59cb\u5242\u91cf\u662f\u6807\u51c6\u4e14\u5b89\u5168\u7684\u3002\n        *   \u201c\u4f4e\u5242\u91cf\u201d\uff080.5\u6beb\u514b\uff09\u662f\u4e00\u4e2a\u975e\u5e38\u5408\u7406\u4e14\u8c28\u614e\u7684\u8d77\u59cb\u5242\u91cf\u3002\u4f60\u53ef\u4ee5\u968f\u65f6\u7ed9\u4e88\u66f4\u591a\u836f\u7269\uff0c\u4f46\u65e0\u6cd5\u6536\u56de\u5df2\u7ed9\u4e88\u7684\u5242\u91cf\u3002\n        *   \u201c\u9ad8\u5242\u91cf\u201d\uff081\u6beb\u514b\uff09\u4e5f\u662f\u4e00\u4e2a\u5408\u7406\u4e14\u6709\u6548\u7684\u8d77\u59cb\u5242\u91cf\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u5982\u6b64\u5267\u70c8\u7684\u75bc\u75db\u3002\u5b83\u5e76\u975e\u6781\u9ad8\u7684\u5242\u91cf\uff1b\u5b83\u662f\u6807\u51c6\u5242\u91cf\u8303\u56f4\u5185\u7684\u3002\n    *   **\u9009\u62e9\u54ea\u4e00\u4e2a\uff1f**\u9274\u4e8e\u75bc\u75db\u7684*\u4e25\u91cd\u6027*\uff08\u7c89\u788e\u6027\u9aa8\u6298\u3001\u97e7\u5e26\u65ad\u88c2\u3001\u65e0\u6cd5\u627f\u91cd\uff09\uff0c\u4ece\u66f4\u6709\u6548\u7684\u4e00\u7aef\u5f00\u59cb\u662f\u5408\u7406\u7684\u30021\u6beb\u514b\u7684\u5242\u91cf\u5e76\u975e\u8fc7\u5ea6\u7684\u201c\u9ad8\u201d\u5242\u91cf\uff1b\u5b83\u662f\u4e00\u4e2a\u6807\u51c6\u7684\u8d77\u59cb\u5242\u91cf\uff0c\u80fd\u6bd40.5\u6beb\u514b\u6709\u66f4\u9ad8\u51e0\u7387\u63d0\u4f9b\u5145\u5206\u7684\u7f13\u89e3\u3002\u76ee\u6807\u662f\u63a7\u5236\u75bc\u75db\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u90e8\u5206\u7f13\u89e3\u3002\u5728\u8fd9\u91cc\u4f7f\u7528\u201c\u9ad8\u201d\u5242\u91cf\u662f\u5408\u7406\u7684\uff0c\u56e0\u4e3a\u75c5\u60c5\u4e25\u91cd\uff0c\u9700\u8981\u5f3a\u6548\u9547\u75db\u3002\u4ece0.5\u6beb\u514b\u5f00\u59cb\u53ef\u80fd\u6548\u679c\u4e0d\u4f73\uff0c\u9700\u8981\u8fc5\u901f\u8ffd\u52a0\u5242\u91cf\uff0c\u4ece\u800c\u5ef6\u8fdf\u7f13\u89e3\u3002\u56e0\u6b64\uff0c\u9009\u62e9\u201chigh\u201d\u662f\u66f4\u5f3a\u6709\u529b\u7684\u4e34\u5e8a\u9009\u62e9\u3002\n\n7.  **\u51b3\u5b9a\u201cpain_severity\u201d\uff080-10\uff09\uff1a**\n    *   \u75bc\u75db\u88ab\u63cf\u8ff0\u4e3a\u201csevere\u201d\u3002\n    *   \u5b83\u5bfc\u81f4\u529f\u80fd\u4e27\u5931\uff08\u201cunable to bear weight\u201d\uff09\u3002\n    *   \u5b83\u7531\u91cd\u5927\u7684\u7ed3\u6784\u6027\u635f\u4f24\uff08\u9aa8\u6298\u3001\u97e7\u5e26\u65ad\u88c2\uff09\u5f15\u8d77\u3002\n    *   \u6807\u51c6\u53e3\u670d\u836f\u7269\u65e0\u6548\u3002\n    *   \u6240\u6709\u8fd9\u4e9b\u56e0\u7d20\u90fd\u6307\u5411\u4e86\u4e25\u91cd\u8303\u56f4\u7684\u9ad8\u7aef\u30028\u5206\u62169\u5206\u662f\u5408\u9002\u7684\u3002\u6211\u4eec\u90098\u5206\u3002\u5b83\u8db3\u591f\u9ad8\uff0c\u53ef\u4ee5\u8bc1\u660e\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u662f\u5408\u7406\u7684\uff0c\u4f46\u53c8\u6ca1\u6709\u9ad8\u523010\u5206\uff0810\u5206\u901a\u5e38\u88ab\u4fdd\u7559\u4e3a\u201c\u53ef\u4ee5\u60f3\u8c61\u5230\u7684\u6700\u574f\u201d\u7684\u75bc\u75db\uff09\u3002\n\n8.  **\u64b0\u5199\u201cexplanation\u201d\uff08\u4e00\u53e5\u8bdd\uff09\uff1a**\n    *   \u6838\u5fc3\u539f\u56e0\u662f\u4ec0\u4e48\uff1f\u60a3\u8005\u6709\u6765\u81ea\u91cd\u5927\u521b\u4f24\u7684\u6025\u6027\u91cd\u5e