a\u5931\u63a7\u3002\n\n    *   **`offer`\uff1a** \u6211\u5e94\u8be5\u63d0\u4f9b\u6c22\u53ef\u916e\u5904\u65b9\u5417\uff1f\n        *   **\u652f\u6301\u201c\u662f\u201d\u7684\u8bba\u636e\uff1a** \u60a3\u8005\u6b63\u5728\u7ecf\u5386\u663e\u8457\u7684\u3001\u7b26\u5408\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\uff08\u5f00\u9885\u672f\u540e\u75bc\u75db\uff09\u3002\u75bc\u75db\u6709\u660e\u786e\u7684\u75c5\u7406\u751f\u7406\u5b66\u539f\u56e0\uff08\u7ec4\u7ec7\u521b\u4f24\u3001\u708e\u75c7\uff09\u3002\u4ed6\u76ee\u524d\u5df2\u5728\u4f4f\u9662\u671f\u95f4\u5bf9\u8fd9\u79cd\u836f\u7269\u4ea7\u751f\u4e86\u5e94\u7b54\u3002\u4e0d\u63d0\u4f9b\u75bc\u75db\u63a7\u5236\u7684\u8fc7\u6e21\u662f\u4e0d\u4eba\u9053\u7684\uff0c\u5e76\u53ef\u80fd\u5bfc\u81f4\u60a3\u8005\u75db\u82e6\u3001\u65e0\u6cd5\u6d3b\u52a8\uff08\u53ef\u80fd\u589e\u52a0\u8840\u6813\u7b49\u98ce\u9669\uff09\u4ee5\u53ca\u518d\u5165\u9662\u3002\u5f00\u9885\u672f\u540e\u7684\u6025\u6027\u75bc\u75db\u7ba1\u7406\u662f\u6807\u51c6\u4e14\u5fc5\u8981\u7684\u6cbb\u7597\u3002\n        *   **\u652f\u6301\u201c\u5426\u201d\u7684\u8bba\u636e\uff1a** \u836f\u7269\u662f\u6c22\u53ef\u916e\uff0c\u4e00\u79cd\u963f\u7247\u7c7b\u836f\u7269\u3002\u5b58\u5728\u6210\u763e\u3001\u8bef\u7528\u548c\u5206\u53d1\u7684\u98ce\u9669\u3002\u7136\u800c\uff0c\u5728*\u6709\u660e\u786e\u6307\u5f81\u7684\u6025\u6027\u672f\u540e\u75bc\u75db*\u8fd9\u4e00\u80cc\u666f\u4e0b\uff0c\u76ca\u5904\u8fdc\u8fdc\u5927\u4e8e\u98ce\u9669\u3002\u672f\u540e\u77ed\u671f\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u662f\u6807\u51c6\u505a\u6cd5\u3002\u56e0\u4e3a\u6ca1\u6709\u660e\u786e\u7684\u66ff\u4ee3\u65b9\u6848\uff08\u4f8b\u5982\uff0c\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u4ec5\u4f7f\u7528\u975e\u753e\u4f53\u6297\u708e\u836f\u53ef\u80fd\u4e0d\u591f\uff09\u800c\u62d2\u7edd\u5f00\u5177\u5904\u65b9\uff0c\u5c06\u662f\u4e0d\u5f53\u7684\u533b\u7597\u884c\u4e3a\u3002\n        *   **\u7ed3\u8bba\uff1a** \u7b54\u6848\u5fc5\u987b\u662f\u201cyes\u201d\u3002\n\n    *   **`dose`\uff08\u65f6\u957f\uff09\uff1a** \u6211\u5e94\u8be5\u5f00\u5177\u591a\u957f\u65f6\u95f4\u7684\u5904\u65b9\uff1f\n        *   **\u9009\u9879\uff1a\u201chigh\u201d\uff084\u5468\uff09\u3002** \u5bf9\u4e8e\u672f\u540e\u7b2c2\u5929\u51fa\u9662\u7684\u60a3\u8005\uff0c4\u5468\u7684\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u662f\u6781\u4e0d\u6070\u5f53\u7684\uff0c\u5e76\u4e14\u662f\u5bfc\u81f4\u8fc7\u91cf\u7528\u836f\u548c\u957f\u671f\u4f7f\u7528\u7684\u4e00\u4e2a\u4e3b\u8981\u516c\u5171\u536b\u751f\u95ee\u9898\u3002\u624b\u672f\u75bc\u75db\u5e94\u8be5\u4f1a\u663e\u8457\u6539\u5584\u30024\u5468\u7684\u5904\u65b9\u4f1a\u8fdc\u8fdc\u8d85\u8fc7\u5fc5\u8981\u7684\u6cbb\u7597\u65f6\u957f\uff0c\u5e76\u9020\u6210\u5269\u4f59\u836f\u7247\u88ab\u8bef\u7528\u6216\u5206\u53d1\u7684\u91cd\u5927\u98ce\u9669\u3002\u8fd9\u662f\u201c\u7ea2\u7ebf\u201d\u9009\u9879\u3002\n        *   **\u9009\u9879\uff1a\u201clow\u201d\uff081\u5468\uff09\u3002** 1\u5468\uff08\u4f8b\u5982\uff0c\u6bcf\u6b21\u5f00\u5904\u65b95-7\u5929\u7684\u91cf\uff09\u662f\u672f\u540e\u51fa\u9662\u7684\u6807\u51c6\u3002\u8fd9\u4e3a\u60a3\u8005\u63d0\u4f9b\u4e86\u8db3\u591f\u7684\u65f6\u95f4\u6765\u5ea6\u8fc7\u75bc\u75db\u6700\u4e25\u91cd\u7684\u521d\u671f\uff08\u6700\u521d\u768472\u5c0f\u65f6\u540e\uff09\uff0c\u5e76\u8fc7\u6e21\u5230\u4ec5\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u7684\u9547\u75db\u65b9\u6848\u3002\u8fd9\u65e2\u63a7\u5236\u4e86\u98ce\u9669\uff0c\u53c8\u6070\u5f53\u5730\u5904\u7406\u4e86\u6025\u6027\u75bc\u75db\u3002\u60a3\u8005\u53ef\u4ee5\u57281\u5468\u540e\u968f\u8bbf\uff0c\u5982\u679c\u4ecd\u6709*\u6301\u7eed\u7684\u3001\u4e25\u91cd\u7684*\u75bc\u75db\uff0c\u53ef\u4ee5\u91cd\u65b0\u8bc4\u4f30\uff0c\u4f46\u8fd9\u4e0d\u592a\u53ef\u80fd\u3002\u8fd9\u662f\u5b89\u5168\u4e14\u7b26\u5408\u6807\u51c6\u7684\u505a\u6cd5\u3002\n        *   **\u9009\u9879\uff1a\u201cnone\u201d\u3002** \u8fd9\u4e0e\u201coffer\u201d\u4e2d\u7684\u201cyes\u201d\u76f8\u77db\u76fe\uff0c\u5e76\u4e14\u5728\u4e34\u5e8a\u4e0a\u662f\u4e0d\u6b63\u786e\u7684\u3002\n        *   **\u7ed3\u8bba\uff1a** \u6b63\u786e\u7684\u9009\u62e9\u662f\u201clow\u201d\uff081\u5468\uff09\u3002\n\n    *   **`explanation`\uff08\u4e00\u53e5\u8bdd\uff09\uff1a** \u6211\u9700\u8981\u5c06\u6211\u7684\u7406\u7531\u6d53\u7f29\u6210\u4e00\u4e2a\u53e5\u5b50\u3002\n        *   \u6838\u5fc3\u539f\u56e0\u662f\u4ec0\u4e48\uff1f\u60a3\u8005\u6709\u663e\u8457\u7684\u3001\u7b26\u5408\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\uff0c\u9700\u8981\u77ed\u671f\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9002\u5f53\u7684\u8fc7\u6e21\u3002\n        *   \u6211\u4eec\u6765\u8349\u62df\u4e00\u53e5\u8bdd\uff1a\n            *   \u201c\u60a3\u8005\u6709\u663e\u8457\u4e14\u7b26\u5408\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\uff0c\u9700\u8981\u8fdb\u884c\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u8fc7\u6e21\u3002\u201d\uff08\u8fd9\u5f88\u597d\u3002\uff09\n            *   \u201c\u7531\u4e8e\u8fd9\u662f\u4e00\u6b21\u5927\u578b\u624b\u672f\uff0c\u6211\u5c06\u63d0\u4f9b\u4f4e\u5242\u91cf\u7684\u5904\u65b9\u4ee5\u7ba1\u7406\u4ed6\u4e25\u91cd\u7684\u672f\u540e\u75bc\u75db\u3002\u201d\uff08\u4e5f\u4e0d\u9519\uff0c\u4f46\u201c\u4f4e\u5242\u91cf\u201d\u53ef\u80fd\u4f1a\u88ab\u8bef\u89e3\u4e3a\u5355\u6b21\u5242\u91cf\uff0c\u800c\u4e0d\u662f\u65f6\u957f\u3002\u63d0\u793a\u8bcd\u4f7f\u7528\u201clow\u201d\u6765\u6307\u65f6\u957f\uff09\u3002\n            *   \u201c\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u5bf9\u4e8e\u63a7\u5236\u4ed6\u663e\u8457\u7684\u3001\u7b26\u5408\u9884\u671f\u7684\u5f00\u9885\u672f\u540e\u75bc\u75db\u662f\u9002\u5f53\u7684\u3002\u201d\uff08\u8fd9\u975e\u5e38\u7cbe\u786e\u4e14\u4e13\u4e1a\uff09\u3002\n        *   \u6211\u5c06\u9009\u62e9\u6700\u540e\u4e00\u4e2a\u3002\u5b83\u5f88\u7b80\u6d01\uff0c\u4f7f\u7528\u4e86\u4e34\u5e8a\u672f\u8bed\uff08\u201c\u5f00\u9885\u672f\u540e\u75bc\u75db\u201d\uff09\uff0c\u5e76\u76f4\u63a5\u4e3a\u5f00\u5177*\u77ed\u671f*\uff08\u201clow\u201d\uff09\u5904\u65b9\u7684\u51b3\u5b9a\u63d0\u4f9b\u4e86\u7406\u7531\u3002\n\n4.  **\u6700\u7ec8JSON\u7ec4\u88c5\uff1a**\n\n    *   `pain_severity`\uff1a6\n    *   `offer`\uff1a\u201cyes\u201d\n    *   `dose`\uff1a\u201clow\u201d\n    *   `explanation`\uff1a\u201c\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u5bf9\u4e8e\u63a7\u5236\u4ed6\u663e\u8457\u7684\u3001\u7b26\u5408\u9884\u671f\u7684\u5f00\u9885\u672f\u540e\u75bc\u75db\u662f\u9002\u5f53\u7684\u3002\u201d\n\n    \u73b0\u5728\uff0c\u6211\u5c06\u628a\u5b83\u653e\u5165\u6700\u7ec8\u7684JSON\u683c\u5f0f\u4e2d\uff0c\u5e76\u518d\u6b21\u68c0\u67e5\u662f\u5426\u6709\u4efb\u4f55\u8bed\u6cd5\u9519\u8bef\u6216\u504f\u79bb\u8981\u6c42\u7684\u60c5\u51b5\u3002\u8f93\u51fa\u5fc5\u987b*\u53ea\u6709*JSON\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u62c6\u89e3\u8bf7\u6c42\uff1a**\n\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u4ece\u4e34\u5e8a\u89d2\u5ea6\u601d\u8003\uff0c\u8003\u8651\u60a3\u8005\u5b89\u5168\u3001\u672f\u540e\u6062\u590d\u3001\u75bc\u75db\u7ba1\u7406\u548c\u533b\u5b66\u4f26\u7406\u3002\n    *   **\u4efb\u52a1\uff1a** \u9605\u8bfb\u4e00\u4e2a\u75c5\u4f8b\u5e76\u56de\u7b54\u4e00\u4e2a\u5177\u4f53\u95ee\u9898\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e25\u683c\u7684JSON\u3002\u4e0d\u5141\u8bb8\u6709\u5176\u4ed6\u6587\u672c\u3002JSON\u5fc5\u987b\u6709\u56db\u4e2a\u7279\u5b9a\u7684\u952e\uff1a\n        *   `pain_severity`\uff1a\u6574\u6570\uff080-10\uff09\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684*\u8bc4\u4f30*\u3002\n        *   `offer`\uff1a\u201cyes\u201d\u6216\u201cno\u201d\u3002\u6211\u662f\u5426\u4f1a\u5f00\u5177\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\uff1f\n        *   `dose`\uff1a\u201clow\u201d\u3001\u201chigh\u201d\u6216\u201cnone\u201d\u3002\u8fd9\u6307\u7684\u662f\u5904\u65b9\u7684*\u65f6\u957f*\uff081\u5468 vs. 4\u5468\uff09\uff0c\u800c\u4e0d\u662f\u5355\u6b21\u5242\u91cf\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u3002\u6211\u7684\u7406\u7531\u3002\n\n2.  **\u5206\u6790\u75c5\u4f8b\uff08\u60a3\u8005D\uff09\uff1a**\n\n    *   **\u60a3\u8005\uff1a** 39\u5c81\uff0c\u7537\u6027\u3002\n    *   **\u624b\u672f\uff1a** \u53f3\u4fa7\u4e59\u72b6\u7aa6\u540e\u5f00\u9885\u672f\u3001\u5fae\u8840\u7ba1\u51cf\u538b\u672f\u3002\u8fd9\u662f\u4e00\u9879\u6d89\u53ca\u9885\u9aa8\u548c\u9888\u90e8\u808c\u8089\u7684\u91cd\u5927\u624b\u672f\u3002\n    *   **\u672f\u540e\u5929\u6570\uff1a** \u7b2c2\u5929\u3002\u8fd9\u662f\u4e00\u4e2a\u975e\u5e38\u65e9\u671f\u7684\u9636\u6bb5\u3002\n    *   **\u539f\u53d1\u75c5\uff08\u4e09\u53c9\u795e\u7ecf\u75db\uff09\uff1a** \u5df2\u89e3\u51b3\u3002\u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u70b9\u3002\u75bc\u75db\u5e76\u975e\u6765\u81ea\u6162\u6027\u795e\u7ecf\u75db\uff0c\u800c\u662f\u6e90\u4e8e\u624b\u672f\u672c\u8eab\u3002\u8fd9\u4f7f\u5f97\u5f00\u5177\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u7684\u51b3\u5b9a\u6bd4\u6162\u6027\u75bc\u75db\u60a3\u8005\u7684\u60c5\u51b5\u66f4\u76f4\u63a5\u3002\n    *   **\u4e3b\u8bc9\uff1a** \u624b\u672f\u90e8\u4f4d\u75bc\u75db\u662f\u201c\u4e3b\u8981\u5173\u6ce8\u70b9\u201d\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\u53d1\u73b0\uff1a**\n        *   \u795e\u7ecf\u529f\u80fd\u5b8c\u597d\u3002\u8fd9\u662f\u4e00\u4e2a\u597d\u7684\u8ff9\u8c61\u3002\u6ca1\u6709\u65b0\u7684\u795e\u7ecf\u529f\u80fd\u7f3a\u635f\u3002\n        *   \u5207\u53e3\u5904\u80bf\u80c0\u548c\u538b\u75db\u3002\u8fd9\u662f\u672f\u540e\u7b2c2\u5929\u5b8c\u5168\u7b26\u5408\u9884\u671f\u7684\u53d1\u73b0\u3002\u8fd9\u662f\u7ec4\u7ec7\u635f\u4f24\u548c\u708e\u75c7\u53cd\u5e94\u7684\u76f4\u63a5\u7ed3\u679c\u3002\n        *   \u9888\u90e8\u4e3b\u52a8/\u88ab\u52a8\u65cb\u8f6c\u4f1a\u52a0\u91cd\u75bc\u75db\u3002\u8fd9\u4e5f\u7b26\u5408\u9884\u671f\u3002\u8be5\u624b\u672f\u6d89\u53ca\u5207\u5f00\u5e76\u7275\u5f00\u9888\u90e8\u808c\u8089\u4ee5\u5230\u8fbe\u9885\u9aa8\u3002\u8fd9\u4e9b\u808c\u8089\u73b0\u5728\u6b63\u5904\u4e8e\u672f\u540e\u75bc\u75db\u72b6\u6001\u3002\n    *   **\u5f53\u524d\u7528\u836f\u60c5\u51b5\uff1a** \u6bcf6\u5c0f\u65f6\u9700\u8981\u201c\u6c22\u53ef\u916e\u201d\u4e00\u6b21\u3002\u8fd9\u544a\u8bc9\u6211\u4ed6\u7684\u75bc\u75db\u5f53\u524d\u6b63\u5728\u901a\u8fc7\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u63a7\u5236\uff0c\u5e76\u4e14\u4ed6\u6709\u89c4\u5f8b\u7684\u9700\u6c42\u3002\u201c\u6bcf6\u5c0f\u65f6\u201d\u662f\u4e00\u4e2a\u6807\u51c6\u7684\u7ed9\u836f\u95f4\u9694\u3002\n    *   **\u51fa\u9662\u6807\u51c6\uff1a** \u4ed6\u5df2\u7b26\u5408\u51fa\u9662\u6807\u51c6\uff08\u9664\u4e86\u75bc\u75db\u7ba1\u7406\u95ee\u9898\uff09\u3002\u8fd9\u610f\u5473\u7740\u4ed6\u751f\u547d\u4f53\u5f81\u5e73\u7a33\uff0c\u6ca1\u6709\u611f\u67d3\u8ff9\u8c61\u7b49\u3002\n\n3.  **\u7efc\u5408\u5e76\u5f62\u6210\u4e34\u5e8a\u5224\u65ad\uff1a**\n\n    *   **`pain_severity`\uff1a** \u60a3\u8005\u6b63\u5728\u4ece\u4e00\u9879\u91cd\u5927\u7684\u5934\u90e8\u548c\u9888\u90e8\u624b\u672f\u4e2d\u6062\u590d\u3002\u5207\u53e3\u6709\u538b\u75db\uff0c\u9888\u90e8\u6d3b\u52a8\u4f1a\u52a0\u91cd\u75bc\u75db\uff0c\u5e76\u4e14\u4ed6\u6b63\u5728\u89c4\u5f8b\u5730\u670d\u7528\u963f\u7247\u7c7b\u836f\u7269\u3002\u8fd9\u4e0d\u662f\u8f7b\u5fae\u7684\u9178\u75db\u3002\u8fd9\u662f\u663e\u8457\u7684\u3001\u660e\u786e\u7684\u672f\u540e\u75bc\u75db\u3002\u4e00\u4e2a0-10\u5206\u91cf\u8868\uff0c\u5176\u4e2d10\u4e3a\u201c\u53ef\u60f3\u8c61\u7684\u6700\u5267\u70c8\u7684\u75bc\u75db\u201d\uff0c\u50cf5/10\u62166/10\u8fd9\u6837\u7684\u5206\u6570\u5bf9\u4e8e\u672f\u540e\u7b2c2\u5929\u4e14\u6b63\u5728\u89c4\u5f8b\u670d\u7528\u963f\u7247\u7c7b\u836f\u7269\u7684\u60a3\u8005\u6765\u8bf4\u4f3c\u4e4e\u662f\u5408\u9002\u7684\u3002\u8fd9\u4ee3\u8868\u4e86\u4e2d\u5ea6\u5230\u91cd\u5ea6\u75bc\u75db\uff0c\u5bf9\u4e8e\u8fd9\u79cd\u60c5\u51b5\u6765\u8bf4\u662f\u7b26\u5408\u9884\u671f\u7684\u3002\u6211\u5c06\u9009\u62e96\u3002\u8fd9\u8db3\u591f\u4e25\u91cd\uff0c\u9700\u8981\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\uff0c\u4f46\u5c1a\u672a\u5931\u63a7\u3002\n\n    *   **`offer`\uff1a** \u6211\u5e94\u8be5\u63d0\u4f9b\u6c22\u53ef\u916e\u5904\u65b9\u5417\uff1f\n        *   **\u652f\u6301\u201c\u662f\u201d\u7684\u8bba\u636e\uff1a** \u60a3\u8005\u6b63\u5728\u7ecf\u5386\u663e\u8457\u7684\u3001\u7b26\u5408\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\uff08\u5f00\u9885\u672f\u540e\u75bc\u75db\uff09\u3002\u75bc\u75db\u6709\u660e\u786e\u7684\u75c5\u7406\u751f\u7406\u5b66\u539f\u56e0\uff08\u7ec4\u7ec7\u521b\u4f24\u3001\u708e\u75c7\uff09\u3002\u4ed6\u76ee\u524d\u5df2\u5728\u4f4f\u9662\u671f\u95f4\u5bf9\u8fd9\u79cd\u836f\u7269\u4ea7\u751f\u4e86\u5e94\u7b54\u3002\u4e0d\u63d0\u4f9b\u75bc\u75db\u63a7\u5236\u7684\u8fc7\u6e21\u662f\u4e0d\u4eba\u9053\u7684\uff0c\u5e76\u53ef\u80fd\u5bfc\u81f4\u60a3\u8005\u75db\u82e6\u3001\u65e0\u6cd5\u6d3b\u52a8\uff08\u53ef\u80fd\u589e\u52a0\u8840\u6813\u7b49\u98ce\u9669\uff09\u4ee5\u53ca\u518d\u5165\u9662\u3002\u5f00\u9885\u672f\u540e\u7684\u6025\u6027\u75bc\u75db\u7ba1\u7406\u662f\u6807\u51c6\u4e14\u5fc5\u8981\u7684\u6cbb\u7597\u3002\n        *   **\u652f\u6301\u201c\u5426\u201d\u7684\u8bba\u636e\uff1a** \u836f\u7269\u662f\u6c22\u53ef\u916e\uff0c\u4e00\u79cd\u963f\u7247\u7c7b\u836f\u7269\u3002\u5b58\u5728\u6210\u763e\u3001\u8bef\u7528\u548c\u5206\u53d1\u7684\u98ce\u9669\u3002\u7136\u800c\uff0c\u5728*\u6709\u660e\u786e\u6307\u5f81\u7684\u6025\u6027\u672f\u540e\u75bc\u75db*\u8fd9\u4e00\u80cc\u666f\u4e0b\uff0c\u76ca\u5904\u8fdc\u8fdc\u5927\u4e8e\u98ce\u9669\u3002\u672f\u540e\u77ed\u671f\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u662f\u6807\u51c6\u505a\u6cd5\u3002\u56e0\u4e3a\u6ca1\u6709\u660e\u786e\u7684\u66ff\u4ee3\u65b9\u6848\uff08\u4f8b\u5982\uff0c\u5bf9\u4e8e\u8fd9\u79cd\u7a0b\u5ea6\u7684\u75bc\u75db\uff0c\u4ec5\u4f7f\u7528\u975e\u753e\u4f53\u6297\u708e\u836f\u53ef\u80fd\u4e0d\u591f\uff09\u800c\u62d2\u7edd\u5f00\u5177\u5904\u65b9\uff0c\u5c06\u662f\u4e0d\u5f53\u7684\u533b\u7597\u884c\u4e3a\u3002\n        *   **\u7ed3\u8bba\uff1a** \u7b54\u6848\u5fc5\u987b\u662f\u201cyes\u201d\u3002\n\n    *   **`dose`\uff08\u65f6\u957f\uff09\uff1a** \u6211\u5e94\u8be5\u5f00\u5177\u591a\u957f\u65f6\u95f4\u7684\u5904\u65b9\uff1f\n        *   **\u9009\u9879\uff1a\u201chigh\u201d\uff084\u5468\uff09\u3002** \u5bf9\u4e8e\u672f\u540e\u7b2c2\u5929\u51fa\u9662\u7684\u60a3\u8005\uff0c4\u5468\u7684\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u662f\u6781\u4e0d\u6070\u5f53\u7684\uff0c\u5e76\u4e14\u662f\u5bfc\u81f4\u8fc7\u91cf\u7528\u836f\u548c\u957f\u671f\u4f7f\u7528\u7684\u4e00\u4e2a\u4e3b\u8981\u516c\u5171\u536b\u751f\u95ee\u9898\u3002\u624b\u672f\u75bc\u75db\u5e94\u8be5\u4f1a\u663e\u8457\u6539\u5584\u30024\u5468\u7684\u5904\u65b9\u4f1a\u8fdc\u8fdc\u8d85\u8fc7\u5fc5\u8981\u7684\u6cbb\u7597\u65f6\u957f\uff0c\u5e76\u9020\u6210\u5269\u4f59\u836f\u7247\u88ab\u8bef\u7528\u6216\u5206\u53d1\u7684\u91cd\u5927\u98ce\u9669\u3002\u8fd9\u662f\u201c\u7ea2\u7ebf\u201d\u9009\u9879\u3002\n        *   **\u9009\u9879\uff1a\u201clow\u201d\uff081\u5468\uff09\u3002** 1\u5468\uff08\u4f8b\u5982\uff0c\u6bcf\u6b21\u5f00\u5904\u65b95-7\u5929\u7684\u91cf\uff09\u662f\u672f\u540e\u51fa\u9662\u7684\u6807\u51c6\u3002\u8fd9\u4e3a\u60a3\u8005\u63d0\u4f9b\u4e86\u8db3\u591f\u7684\u65f6\u95f4\u6765\u5ea6\u8fc7\u75bc\u75db\u6700\u4e25\u91cd\u7684\u521d\u671f\uff08\u6700\u521d\u768472\u5c0f\u65f6\u540e\uff09\uff0c\u5e76\u8fc7\u6e21\u5230\u4ec5\u4f7f\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u7684\u9547\u75db\u65b9\u6848\u3002\u8fd9\u65e2\u63a7\u5236\u4e86\u98ce\u9669\uff0c\u53c8\u6070\u5f53\u5730\u5904\u7406\u4e86\u6025\u6027\u75bc\u75db\u3002\u60a3\u8005\u53ef\u4ee5\u57281\u5468\u540e\u968f\u8bbf\uff0c\u5982\u679c\u4ecd\u6709*\u6301\u7eed\u7684\u3001\u4e25\u91cd\u7684*\u75bc\u75db\uff0c\u53ef\u4ee5\u91cd\u65b0\u8bc4\u4f30\uff0c\u4f46\u8fd9\u4e0d\u592a\u53ef\u80fd\u3002\u8fd9\u662f\u5b89\u5168\u4e14\u7b26\u5408\u6807\u51c6\u7684\u505a\u6cd5\u3002\n        *   **\u9009\u9879\uff1a\u201cnone\u201d\u3002** \u8fd9\u4e0e\u201coffer\u201d\u4e2d\u7684\u201cyes\u201d\u76f8\u77db\u76fe\uff0c\u5e76\u4e14\u5728\u4e34\u5e8a\u4e0a\u662f\u4