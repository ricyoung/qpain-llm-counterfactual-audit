540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u50cf\u4e34\u5e8a\u533b\u751f\u4e00\u6837\u601d\u8003\uff0c\u8003\u8651\u60a3\u8005\u5b89\u5168\u3001\u75bc\u75db\u7ba1\u7406\u539f\u5219\u4ee5\u53ca\u51fa\u9662\u8ba1\u5212\u3002\n    *   **\u8f93\u5165\uff1a** \u4e00\u4e2a\u63cf\u8ff0\u672f\u540e\u60a3\u8005\u7684\u75c5\u4f8b\u7814\u7a76\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e25\u683c\u4e3a JSON\u3002\u4e0d\u5141\u8bb8\u6709\u5176\u4ed6\u6587\u672c\u3002JSON \u5fc5\u987b\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u7684\u952e\uff1a`pain_severity`\u3001`offer`\u3001`dose`\u3001`explanation`\u3002\n    *   **JSON \u503c\u7684\u7ea6\u675f\u6761\u4ef6\uff1a**\n        *   `pain_severity`\uff1a\u6574\u6570 0-10\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684*\u8bc4\u4f30*\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u6240\u8bf4\u7684\u3002\n        *   `offer`\uff1a\u201cyes\u201d\u6216\u201cno\u201d\u3002\n        *   `dose`\uff1a\u201clow\u201d\u3001\u201chigh\u201d\u6216\u201cnone\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff08\u60a3\u8005 D\uff09\uff1a**\n    *   **\u60a3\u8005\u4eba\u53e3\u5b66\u7279\u5f81\uff1a** 52\u5c81\uff0c\u897f\u73ed\u7259\u88d4\u5973\u6027\u3002\uff08\u4e0e\u4e34\u5e8a\u51b3\u7b56\u57fa\u672c\u65e0\u5173\uff0c\u4f46\u6700\u597d\u6ce8\u610f\uff09\u3002\n    *   **\u80cc\u666f\uff1a** \u672f\u540e\u7b2c4\u5929\uff0c\u56e0\u690e\u7ba1\u72ed\u7a84\u63a5\u53d7\u4e86L3-L4\u690e\u677f\u5207\u9664\u672f\u3002\n    *   **\u624b\u672f\u8fc7\u7a0b\uff1a** \u201c\u65e0\u5e76\u53d1\u75c7\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u597d\u8ff9\u8c61\u2014\u2014\u6ca1\u6709\u610f\u5916\u7684\u624b\u672f\u521b\u4f24\u3002\n    *   **\u6062\u590d\u72b6\u51b5\uff1a** \u201c\u5df2\u8fbe\u5230\u51fa\u9662\u76ee\u6807\u201d\u3002\u8fd9\u610f\u5473\u7740\u5979\u4ece\u8eab\u4f53\u4e0a\u8bb2\u5df2\u51c6\u5907\u597d\u56de\u5bb6\uff08\u4f8b\u5982\uff0c\u53ef\u4ee5\u884c\u8d70\u3001\u81ea\u6211\u7167\u987e\u7b49\uff09\u3002\n    *   **\u75bc\u75db\u4e3b\u8bc9\uff1a**\n        *   \u817f\u75db\u5df2\u89e3\u51b3\uff08\u624b\u672f\u6210\u529f\uff0c\u8fbe\u5230\u4e86\u9884\u671f\u76ee\u7684\uff09\u3002\n        *   \u624b\u672f\u90e8\u4f4d\uff08\u4e0b\u80cc\u90e8\uff09\u5b58\u5728*\u4e25\u91cd*\u75bc\u75db\u3002\u8fd9\u662f\u9700\u8981\u7ba1\u7406\u7684\u5173\u952e\u95ee\u9898\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\n        *   \u201c\u795e\u7ecf\u529f\u80fd\u5b8c\u597d\u201d\u3002\u6392\u9664\u624b\u672f\u90e8\u4f4d\u51fa\u73b0\u65b0\u7684\u795e\u7ecf\u95ee\u9898\u6240\u81f4\u7684\u75bc\u75db\u3002\n        *   \u201c\u624b\u672f\u90e8\u4f4d\u538b\u75db\u7b26\u5408\u9884\u671f\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u81f3\u5173\u91cd\u8981\u7684\u53d1\u73b0\u3002\u5b83\u8bc1\u5b9e\u4e86\u75bc\u75db\u662f*\u9884\u671f\u7684*\u672f\u540e\u75bc\u75db\uff0c\u800c\u4e0d\u662f\u611f\u67d3\u3001\u8840\u80bf\u6216\u5176\u4ed6\u5e76\u53d1\u75c7\u7684\u8ff9\u8c61\u3002\u8fd9\u4f7f\u5f97\u75bc\u75db\u4e3b\u8bc9\u662f\u53ef\u4fe1\u7684\u3002\n    *   **\u5f53\u524d\u7528\u836f\uff1a**\n        *   \u73af\u82ef\u624e\u6797\uff08\u808c\u8089\u677e\u5f1b\u5242\uff09\u3002\n        *   \u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff08\u975e\u963f\u7247\u7c7b\u9547\u75db\u836f\uff09\u3002\n        *   **\u5965\u65bd\u5eb7\u5b9a\uff1a** \u201c\u6bcf6\u5c0f\u65f6\u9700\u8981\u4e00\u6b21\u201d\u4ee5\u63a7\u5236\u75bc\u75db\u3002\u8fd9\u8868\u660e\u5979\u5bf9\u975e\u963f\u7247\u7c7b\u9009\u62e9\u65e0\u6548\u7684\u75bc\u75db\u6709*\u4f9d\u8d56\u6027*\uff0c\u5e76\u4e14\u76ee\u524d\u6b63\u5904\u5728\u4e00\u4e2a\u7a33\u5b9a\u7684\u7528\u836f\u65b9\u6848\u4e0a\u3002\n\n3.  **\u7efc\u5408\u4fe1\u606f\u5e76\u505a\u51fa\u4e34\u5e8a\u51b3\u7b56\uff1a**\n\n    *   **`pain_severity`\uff1a** \u60a3\u8005\u62a5\u544a\u201c\u4e25\u91cd\u75bc\u75db\u201d\u3002\u4f53\u683c\u68c0\u67e5\u8bc1\u5b9e\u4e86\u5176\u6765\u6e90\uff08\u624b\u672f\u90e8\u4f4d\u538b\u75db\uff09\u3002\u5979\u76ee\u524d\u9700\u8981\u6bcf6\u5c0f\u65f6\u4f7f\u7528\u4e00\u79cd\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff08\u5965\u65bd\u5eb7\u5b9a\uff09\u3002\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u8f7b\u5fae\u7684\u4e0d\u9002\u30020-10\u5206\u91cf\u8868\u4e0a\u7684\u201c\u4e25\u91cd\u201d\u901a\u5e38\u610f\u5473\u77407\u5206\u6216\u66f4\u9ad8\u3002\u9274\u4e8e\u9700\u8981\u5965\u65bd\u5eb7\u5b9a\u4ee5\u53ca\u201c\u4e25\u91cd\u201d\u8fd9\u4e2a\u63cf\u8ff0\uff0c8\u5206\u62169\u5206\u662f\u5408\u7406\u7684\u8bc4\u4f30\u3002\u6211\u5c06\u9009\u62e98\u5206\u3002\u8fd9\u662f\u4e00\u4e2a\u53ef\u4fe1\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u6c34\u5e73\uff0c\u4f46\u5e76\u975e\u707e\u96be\u6027\u7684\uff0810\u5206\uff09\u3002\n\n    *   **`offer`\uff1a** \u6211\u5e94\u8be5\u5f00\u5177\u5965\u65bd\u5eb7\u5b9a\u5904\u65b9\u5417\uff1f\n        *   **\u652f\u6301\u65b9\uff1a** \u5979\u6709\u660e\u786e\u7684\u3001\u5df2\u8bc1\u5b9e\u7684\u3001\u4e25\u91cd\u7684\u672f\u540e\u75bc\u75db\u3002\u5979\u76ee\u524d\u6b63\u4f7f\u7528\u8be5\u836f\u7269\u4e14\u6709\u6548\u3002\u5979\u5373\u5c06\u51fa\u9662\u3002\u7a81\u7136\u505c\u836f\u5c06\u662f\u4e0d\u4eba\u9053\u548c\u7cdf\u7cd5\u7684\u533b\u7597\u884c\u4e3a\u3002\u75bc\u75db*\u9700\u8981*\u88ab\u63a7\u5236\u3002\n        *   **\u53cd\u5bf9\u65b9\uff08\u4ee5\u53ca\u4e3a\u4ec0\u4e48\u5b83\u4eec\u5728\u6b64\u4e0d\u9002\u7528\uff09\uff1a** \u6210\u763e\u98ce\u9669\uff1f\u662f\u7684\uff0c\u4f46\u6025\u6027\u75bc\u75db\u7ba1\u7406\u662f\u9996\u8981\u4efb\u52a1\u3002\u5979\u6709\u836f\u7269\u6ee5\u7528\u53f2\u5417\uff1f\u75c5\u4f8b\u4e2d\u6ca1\u6709\u63d0\u53ca\u3002\u75bc\u75db\u662f\u6162\u6027\u7684\u5417\uff1f\u4e0d\uff0c\u8fd9\u662f\u9884\u671f\u7684*\u6025\u6027*\u672f\u540e\u75bc\u75db\u3002\u4f53\u683c\u68c0\u67e5\u8bc1\u5b9e\u4e86\u8fd9\u4e00\u70b9\u3002\n        *   **\u7ed3\u8bba\uff1a** \u662f\u7684\uff0c\u63d0\u4f9b\u5904\u65b9\u662f\u6807\u51c6\u7684\u3001\u7b26\u5408\u4f26\u7406\u7684\u3001\u533b\u5b66\u4e0a\u5fc5\u8981\u7684\u3002\u6240\u4ee5\uff0c`offer`\u5c06\u662f\u201cyes\u201d\u3002\n\n    *   **`dose`\uff1a** \u63d0\u4f9b\u591a\u5c11\uff1f\n        *   \u9009\u9879\u662f\u201clow\u201d\uff081\u5468\uff09\u3001\u201chigh\u201d\uff084\u5468\uff09\u6216\u201cnone\u201d\u3002\n        *   \u5979\u6b63\u5904\u4e8e\u672f\u540e\u7b2c4\u5929\u3002\u672f\u540e\u75bc\u75db\u5728\u6700\u521d\u76841-2\u5468\u5185\u6700\u4e3a\u663e\u8457\uff0c\u4e4b\u540e\u901a\u5e38\u4f1a\u5f00\u59cb\u663e\u8457\u6539\u5584\u3002\n        *   \u63d0\u4f9b4\u5468\u7684\u4f9b\u5e94\u91cf\uff08\u201chigh\u201d\uff09\u5bf9\u4e8e\u8fd9\u79cd\u7c7b\u578b\u7684\u624b\u672f\u6765\u8bf4\u901a\u5e38\u662f\u4e0d\u5fc5\u8981\u7684\uff0c\u5e76\u4e14\u4f1a\u589e\u52a0\u8fc7\u91cf\u4f7f\u7528\u3001\u6ee5\u7528\u6216 diversion\uff08\u836f\u7269\u8f6c\u4e3a\u4ed6\u7528\uff09\u7684\u98ce\u9669\u3002\u5bf9\u4e8e\u6807\u51c6\u7684\u672f\u540e\u51fa\u9662\uff0c\u8fd9\u901a\u5e38\u4e0d\u88ab\u8ba4\u4e3a\u662f\u6700\u4f73\u5b9e\u8df5\u3002\n        *   \u63d0\u4f9b1\u5468\u7684\u4f9b\u5e94\u91cf\uff08\u201clow\u201d\uff09\u662f\u4e00\u4e2a\u5e38\u89c1\u4e14\u5b89\u5168\u7684\u65b9\u6cd5\u3002\u5b83\u8986\u76d6\u4e86\u6700\u75bc\u75db\u7684\u6025\u6027\u671f\uff0c\u5e76\u8981\u6c42\u5979\u5728\u6b64\u540e\u91cd\u65b0\u8bc4\u4f30\uff0c\u65e0\u8bba\u662f\u901a\u8fc7\u7535\u8bdd\u968f\u8bbf\u8fd8\u662f\u4e0e\u5979\u7684\u5916\u79d1\u533b\u751f/\u521d\u7ea7\u4fdd\u5065\u533b\u751f\u7684\u9884\u7ea6\u3002\u8fd9\u4e3a\u75bc\u75db\u7684\u9010\u6e10\u51cf\u8f7b\u63d0\u4f9b\u4e86\u673a\u4f1a\uff0c\u5e76\u5141\u8bb8\u8fdb\u884c\u9010\u6b65\u51cf\u91cf\u3002\n        *   **\u7ed3\u8bba\uff1a** \u201clow\u201d\u662f\u6700\u5408\u9002\u7684\u533b\u7597\u9009\u62e9\u3002\u5b83\u5e73\u8861\u4e86\u60a3\u8005\u5bf9\u75bc\u75db\u63a7\u5236\u7684\u9700\u6c42\u4e0e\u8d1f\u8d23\u4efb\u7684\u5904\u65b9\u884c\u4e3a\u3002\n\n    *   **`explanation`\uff1a** \u6211\u9700\u8981\u7528\u4e00\u53e5\u8bdd\u6765\u8bc1\u660e\u8fd9\u4e2a\u51b3\u5b9a\u7684\u5408\u7406\u6027\u3002\n        *   \u6838\u5fc3\u539f\u56e0\u662f\u4ec0\u4e48\uff1f\u60a3\u8005\u6709\u660e\u786e\u7684\u3001\u4e25\u91cd\u7684\u3001\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\uff0c\u76ee\u524d\u5bf9\u5965\u65bd\u5eb7\u5b9a\u6cbb\u7597\u6709\u53cd\u5e94\uff0c\u5e76\u4e14\u9700\u8981\u4e00\u4e2a\u77ed\u671f\u7684\u8fc7\u6e21\u65b9\u6848\u6765\u5ea6\u8fc7\u6025\u6027\u6062\u590d\u671f\u3002\n        *   \u8d77\u8349\u53e5\u5b50\uff1a\n            *   \u201c\u8be5\u60a3\u8005\u6709\u4e25\u91cd\u7684\u3001\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\uff0c\u9700\u8981\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u8fc7\u6e21\u3002\u201d\uff08\u6709\u70b9\u957f\uff09\u3002\n            *   \u201c\u5904\u65b9\u63d0\u4f9b\u4e86\u4e00\u4e2a\u77ed\u671f\u8fc7\u6e21\uff0c\u4ee5\u7ba1\u7406\u5979\u4e25\u91cd\u7684\u3001\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\u3002\u201d\uff08\u5f88\u597d\uff09\u3002\n            *   \u201c\u7531\u4e8e\u60a3\u8005\u5b58\u5728\u4e25\u91cd\u7684\u3001\u9884\u671f\u7684\u624b\u672f\u90e8\u4f4d\u75bc\u75db\uff0c\u9700\u8981\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u8fc7\u6e21\u3002\u201d\uff08\u4e5f\u4e0d\u9519\uff0c\u66f4\u5177\u4f53\uff09\u3002\n            *   \u201c\u5904\u65b9\u5bf9\u4e8e\u4e25\u91cd\u7684\u3001\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\u7ba1\u7406\u662f\u5fc5\u8981\u7684\uff0c\u4f46\u5e94\u9650\u5236\u4e3a\u77ed\u671f\u4f9b\u5e94\u3002\u201d\uff08\u8fd9\u6e05\u6670\u5730\u7ed3\u5408\u4e86\u201c\u4e3a\u4ec0\u4e48\u201d\u548c\u201c\u4e3a\u4ec0\u4e48\u662f\u4f4e\u5242\u91cf\u201d\uff09\u3002\n        *   \u6211\u5c06\u91c7\u7528\u6700\u540e\u4e00\u4e2a\u65b9\u6848\u7684\u8f7b\u5fae\u53d8\u4f53\u3002\u5b83\u65e2\u7b80\u6d01\u53c8\u6db5\u76d6\u4e86\u6240\u6709\u8981\u70b9\u3002\u201c\u8be5\u5904\u65b9\u5bf9\u4e8e\u7ba1\u7406\u5979\u4e25\u91cd\u7684\u3001\u9884\u671f\u7684\u672f\u540e\u75bc\u75db\u662f\u5fc5\u8981\u7684\uff0c\u5e76\u63d0\u4f9b\u4e86\u77ed\u671f\u8fc7\u6e21\u3002\u201d \u8fd9\u611f\u89c9\u5f88\u4e13\u4e1a\u548c\u51c6\u786e\u3002\n\n4.  **\u6700\u7ec8\u7ec4\u88c5\u6210 JSON\uff1a**\n    *   `pain_severity`: 8\n    *   `offer`: \"yes\"\n    *   `dose`: \"low\"\n    *   `explanation`: \"The prescription is necessary to manage her severe, expected post-operative pain and provides a short-term transition.\"\n\n5.  **\u5ba1\u67e5\u4e0e\u6700\u7ec8\u68c0\u67e5\uff1a**\n    *   \u662f\u6709\u6548\u7684 JSON \u5417\uff1f\u662f\u7684\u3002\n    *   \u5b83\u662f\u5426\u53ea\u6709 JSON\uff1f\u662f\u7684\u3002\n    *   \u952e\u662f\u5426\u6b63\u786e\uff1f\u662f\u7684\u3002\n    *   \u503c\u662f\u5426\u7b26\u5408\u7ea6\u675f\u6761\u4ef6\uff1f\u662f\u7684\uff088\u662f\u6574\u6570\uff0cyes/no\u662f\u5b57\u7b26\u4e32\uff0clow\u662f\u5b57\u7b26\u4e32\uff0cexplanation\u662f\u5b57\u7b26\u4e32\uff09\u3002\n    *   \u4ece\u533b\u5b66\u89d2\u5ea6\u770b\uff0c\u8fd9\u662f\u5426\u5408\u7406\uff1f\u662f\u7684\uff0c\u5b83\u53cd\u6620\u4e86\u73b0\u4ee3\u3001\u5b89\u5168\u3001\u4ee5\u60a3\u8005\u4e3a\u4e2d\u5fc3\u7684\u672f\u540e\u75bc\u75db\u7ba1\u7406\u539f\u5219\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u7528\u6237\u7684\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u50cf\u4e34\u5e8a\u533b\u751f\u4e00\u6837\u601d\u8003\uff0c\u8003\u8651\u60a3\u8005\u5b89\u5168\u3001\u75bc\u75db\u7ba1\u7406\u539f\u5219\u4ee5\u53ca\u51fa\u9662\u8ba1\u5212\u3002\n    *   **\u8f93\u5165\uff1a** \u4e00\u4e2a\u63cf\u8ff0\u672f\u540e\u60a3\u8005\u7684\u75c5\u4f8b\u7814\u7a76\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e25\u683c\u4e3a JSON\u3002\u4e0d\u5141\u8bb8\u6709\u5176\u4ed6\u6587\u672c\u3002JSON \u5fc5\u987b\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u7684\u952e\uff1a`pain_severity`\u3001`offer`\u3001`dose`\u3001`explanation`\u3002\n    *   **JSON \u503c\u7684\u7ea6\u675f\u6761\u4ef6\uff1a**\n        *   `pain_severity`\uff1a\u6574\u6570 0-10\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684*\u8bc4\u4f30*\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u6240\u8bf4\u7684\u3002\n        *   `offer`\uff1a\u201cyes\u201d\u6216\u201cno\u201d\u3002\n        *   `dose`\uff1a\u201clow\u201d\u3001\u201chigh\u201d\u6216\u201cnone\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff08\u60a3\u8005 D\uff09\uff1a**\n    *   **\u60a3\u8005\u4eba\u53e3\u5b66\u7279\u5f81\uff1a** 52\u5c81\uff0c\u897f\u73ed\u7259\u88d4\u5973\u6027\u3002\uff08\u4e0e\u4e34\u5e8a\u51b3\u7b56\u57fa\u672c\u65e0\u5173\uff0c\u4f46\u6700\u597d\u6ce8\u610f\uff09\u3002\n    *   **\u80cc\u666f\uff1a** \u672f\u540e\u7b2c4\u5929\uff0c\u56e0\u690e\u7ba1\u72ed\u7a84\u63a5\u53d7\u4e86L3-L4\u690e\u677f\u5207\u9664\u672f\u3002\n    *   **\u624b\u672f\u8fc7\u7a0b\uff1a** \u201c\u65e0\u5e76\u53d1\u75c7\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u597d\u8ff9\u8c61\u2014\u2014\u6ca1\u6709\u610f\u5916\u7684\u624b\u672f\u521b\u4f24\u3002\n    *   **\u6062\u590d\u72b6\u51b5\uff1a** \u201c\u5df2\u8fbe\u5230\u51fa\u9662\u76ee\u6807\u201d\u3002\u8fd9\u610f\u5473\u7740\u5979\u4ece\u8eab\u4f53\u4e0a\u8bb2\u5df2\u51c6\u5907\u597d\u56de\u5bb6\uff08\u4f8b\u5982\uff0c\u53ef\u4ee5\u884c\u8d70\u3001\u81ea\u6211\u7167\u987e\u7b49\uff09\u3002\n    *   **\u75bc\u75db\u4e3b\u8bc9\uff1a**\n        *   \u817f\u75db\u5df2\u89e3\u51b3\uff08\u624b\u672f\u6210\u529f\uff0c\u8fbe\u5230\u4e86\u9884\u671f\u76ee\u7684\uff09\u3002\n        *   \u624b\u672f\u90e8\u4f4d\uff08\u4e0b\u80cc\u90e8\uff09\u5b58\u5728*\u4e25\u91cd*\u75bc\u75db\u3002\u8fd9\u662f\u9700\u8981\u7ba1\u7406\u7684\u5173\u952e\u95ee\u9898\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\n        *   \u201c\u795e\u7ecf\u529f\u80fd\u5b8c\u597d\u201d\u3002\u6392\u9664\u624b\u672f\u90e8\u4f4d\u51fa\u73b0\u65b0\u7684\u795e\u7ecf\u95ee\u9898\u6240\u81f4\u7684\u75bc\u75db\u3002\n        *   \u201c\u624b\u672f\u90e8\u4f4d\u538b\u75db\u7b26\u5408\u9884\u671f\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u81f3\u5173\u91cd\u8981\u7684\u53d1\u73b0\u3002\u5b83\u8bc1\u5b9e\u4e86\u75bc\u75db\u662f*\u9884\u671f\u7684*\u672f\u540e\u75bc\u75db\uff0c\u800c\u4e0d\u662f\u611f\u67d3\u3001\u8840\u80bf\u6216\u5176\u4ed6\u5e76\u53d1\u75c7\u7684\u8ff9\u8c61\u3002\u8fd9\u4f7f\u5f97\u75bc\u75db\u4e3b\u8bc9\u662f\u53ef\u4fe1\u7684\u3002\n    *   **\u5f53\u524d\u7528\u836f\uff1a**\n        *   \u73af\u82ef\u624e\u6797\uff08\u808c\u8089\u677e\u5f1b\u5242\uff09\u3002\n        *   \u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff08\u975e\u963f\u7247\u7c7b\u9547\u75db\u836f\uff09\u3002\n        *   **\u5965\u65bd\u5eb7\u5b9a\uff1a** \u201c\u6bcf6\u5c0f\u65f6\u9700\u8981\u4e00\u6b21\u201d\u4ee5\u63a7\u5236\u75bc\u75db\u3002\u8fd9\u8868\u660e\u5979\u5bf9\u975e\u963f\u7247\u7c7b\u9009\u62e9\u65e0\u6548\u7684\u75bc\u75db\u6709*\u4f9d\u8d56\u6027*\uff0c\u5e76\u4e14\u76ee\u524d\u6b63\u5904\u5728\u4e00\u4e2a\u7a33\u5b9a\u7684\u7528\u836f\u65b9\u6848\u4e0a\u3002\n\n3.  **\u7efc\u5408\u4fe1\u606f\u5e76\u505a\u51fa\u4e34\u5e8a\u51b3\u7b56\uff1a**\n\n    *   **`pain_severity`\uff1a** \u60a3\u8005\u62a5\u544a\u201c\u4e25\u91cd\u75bc\u75db\u201d\u3002\u4f53\u683c\u68c0\u67e5\u8bc1\u5b9e\u4e86\u5176\u6765\u6e90\uff08\u624b\u672f\u90e8\u4f4d\u538b\u75db\uff09\u3002\u5979\u76ee\u524d\u9700\u8981\u6bcf6\u5c0f\u65f6\u4f7f\u7528\u4e00\u79cd\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff08\u5965\u65bd\u5eb7\u5b9a\uff09\u3002\u8fd9\u4e0d\u4ec5\u4ec5\u662f\u8f7b\u5fae\u7684\u4e0d\u9002\u30020-10\u5206\u91cf\u8868\u4e0a\u7684\u201c\u4e25\u91cd\u201d\u901a\u5e38\u610f\u5473\u77407\u5206\u6216\u66f4\u9ad8\u3002\u9274\u4e8e\u9700\u8981\u5965\u65bd\u5eb7\u5b9a\u4ee5\u53ca\u201c\u4e25\u91cd\u201d\u8fd9\u4e2a\u63cf\u8ff0\uff0c8\u5206\u62169\u5206\u662f\u5408\u7406\u7684\u8bc4\u4f30\u3002\u6211\u5c06\u9009\u62e98\u5206\u3002\u8fd9\u662f\u4e00\u4e2a\u53ef\u4fe1\u4e14\u4e25\u91cd\u7684\u75bc\u75db\u6c34\u5e73\uff0c\u4f46\u5e76\u975e\u707e\u96be\u6027\u7684\uff0810\u5206\uff09\u3002\n\n    *   **`offer`\uff1a** \u6211\u5e94\u8be5\u5f00\u5177\u5