81f4\u529f\u80fd\u4e27\u5931\u3002\n        *   \u75c5\u56e0\u4e25\u91cd\uff08\u80bf\u7624\u538b\u8feb\u795e\u7ecf\u4e1b\uff09\u3002\n        *   \u6807\u51c6\u5242\u91cf\u7684\u975e\u963f\u7247\u7c7b\u836f\u7269\u5df2\u7ecf\u5931\u8d25\u3002\n        *   \u5bf9\u4e8e\u8fd9\u79cd\u4e25\u91cd\u7684\u6025\u6027\u75bc\u75db\uff0c\u963f\u7247\u7c7b\u836f\u7269\u662f\u6807\u51c6\u6cbb\u7597\u3002\n        *   \u9759\u8109\u6ce8\u5c04\u662f\u5feb\u901f\u8d77\u6548\u548c\u7ed9\u836f\u63a7\u5236\u7684\u9996\u9009\u9014\u5f84\uff0c\u5c24\u5176\u662f\u5728\u6025\u8bca\u79d1\u3002\n        *   \u6c22\u5417\u5561\u916e\u662f\u4e00\u79cd\u5f3a\u6548\u9759\u8109\u6ce8\u5c04\u7528\u963f\u7247\u7c7b\u836f\u7269\uff0c\u9002\u7528\u4e8e\u8fd9\u79cd\u60c5\u51b5\u3002\n        *   \u62d2\u7edd\u63d0\u4f9b\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u5c06\u662f\u4e0d\u7b26\u5408\u4f26\u7406\u7684\uff0c\u5e76\u4e14\u662f\u9547\u75db\u4e0d\u5145\u5206\u7684\u8868\u73b0\u3002\n        *   \u56e0\u6b64\uff0c\u51b3\u5b9a\u662f\u660e\u786e\u7684\u201cyes\u201d\u3002\n\n    *   **`dose`\u51b3\u7b56\uff08\u4f4e\u6216\u9ad8\uff09\uff1a**\n        *   \u9009\u9879\u662f\u201cLow\u201d\uff080.5\u6beb\u514b\uff09\u6216\u201cHigh\u201d\uff081\u6beb\u514b\uff09\u3002\n        *   \u60a3\u8005\u662f\u4e00\u4f4d24\u5c81\u7684\u6210\u5e74\u4eba\uff0c\u6ca1\u6709\u63d0\u53ca\u809d\u80be\u529f\u80fd\u8870\u7aed\uff0c\u56e0\u6b64\u53ef\u4ee5\u5047\u5b9a\u662f\u6807\u51c6\u7684\u836f\u7269\u4ee3\u8c22\u3002\n        *   \u4ed6\u6ca1\u6709\u957f\u671f\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u7684\u75c5\u53f2\uff08\u75c5\u4f8b\u4e2d\u672a\u63d0\u53ca\uff09\uff0c\u56e0\u6b64\u5bf9\u4ed6\u6765\u8bf4\u53ef\u80fd\u6ca1\u6709\u8010\u53d7\u6027\u3002\n        *   \u5bf9\u4e8e\u6ca1\u6709\u8010\u53d7\u6027\u7684\u963f\u7247\u7c7b\u836f\u7269\u521d\u6cbb\u60a3\u8005\uff0c\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e0.5\u6beb\u514b\u662f\u4e00\u4e2a\u975e\u5e38\u6807\u51c6\u3001\u8c28\u614e\u548c\u9002\u5f53\u7684\u8d77\u59cb\u5242\u91cf\u3002\n        *   \u9759\u8109\u6ce8\u5c041\u6beb\u514b\u5219\u662f\u4e00\u4e2a\u663e\u8457\u66f4\u9ad8\u7684\u5242\u91cf\u3002\u867d\u7136\u5e76\u975e\u4e0d\u53ef\u63a5\u53d7\uff0c\u4f46\u4f5c\u4e3a*\u8d77\u59cb*\u5242\u91cf\uff0c\u5bf9\u4e8e\u521d\u6cbb\u60a3\u8005\u6765\u8bf4\uff0c\u901a\u5e38\u88ab\u8ba4\u4e3a\u66f4\u504f\u201c\u9ad8\u201d\u5242\u91cf\uff0c\u5e76\u53ef\u80fd\u5e26\u6765\u66f4\u5927\u7684\u547c\u5438\u6291\u5236\u98ce\u9669\u3002\n        *   \u963f\u7247\u7c7b\u836f\u7269\u7ed9\u836f\u7684\u6307\u5bfc\u539f\u5219\u662f\u201c\u5f00\u59cb\u4f4e\u5242\u91cf\uff0c\u7f13\u6162\u6ef4\u5b9a\u201d\u3002\u76ee\u6807\u662f\u6709\u6548\u7f13\u89e3\u75bc\u75db\uff0c\u540c\u65f6\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u526f\u4f5c\u7528\u3002\n        *   \u56e0\u6b64\uff0c\u6700\u5b89\u5168\u548c\u6700\u7b26\u5408\u4e34\u5e8a\u6807\u51c6\u7684\u521d\u59cb\u65b9\u6cd5\u662f\u201cLow\u201d\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u3002\u5982\u679c\u8fd9\u4e0d\u8db3\u4ee5\u572815-20\u5206\u949f\u5185\u7f13\u89e3\u75bc\u75db\uff0c\u53ef\u4ee5\u7ed9\u4e88\u53e6\u4e00\u4e2a\u5c0f\u5242\u91cf\uff0c\u6216\u8005\u53ef\u4ee5\u8c03\u6574\u5242\u91cf\u3002\u4ece1\u6beb\u514b\u5f00\u59cb\u4f1a\u8df3\u8fc7\u8c28\u614e\u6ef4\u5b9a\u8fd9\u4e00\u6b65\u3002\n        *   \u6240\u4ee5\uff0c\u9009\u62e9\u201cLow\u201d\u3002\n\n    *   **`explanation`\uff08\u5355\u53e5\uff09\uff1a**\n        *   \u6211\u9700\u8981\u5c06`offer`\u548c`dose`\u51b3\u7b56\u7684\u7406\u7531\u5408\u5e76\u6210\u4e00\u4e2a\u7b80\u6d01\u7684\u53e5\u5b50\u3002\n        *   \u5173\u952e\u70b9\u662f\uff1a\u5267\u70c8\u75bc\u75db\u3001\u4e00\u7ebf\u836f\u7269\u65e0\u6548\u3001\u9700\u8981\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff0c\u4ee5\u53ca\u9700\u8981\u8c28\u614e\u6ef4\u5b9a\u3002\n        *   \u8349\u7a3f1\uff1a\u201c\u7531\u4e8e\u60a3\u8005\u60a3\u6709\u4e25\u91cd\u7684\u3001\u5bf9\u5176\u4ed6\u6cbb\u7597\u65e0\u6548\u7684\u6025\u6027\u75bc\u75db\uff0c\u6240\u4ee5\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\uff0c\u5e76\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u4ee5\u5b89\u5168\u5730\u8bc4\u4f30\u53cd\u5e94\u3002\u201d\n        *   \u8fd9\u5f88\u597d\u3002\u5b83\u6db5\u76d6\u4e86\u201c\u4e3a\u4ec0\u4e48\u201d\uff08\u4e25\u91cd\u3001\u987d\u56fa\u6027\u75bc\u75db\uff09\u548c\u201c\u5982\u4f55\u505a\u201d\uff08\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u4ee5\u5b89\u5168\u548c\u8bc4\u4f30\uff09\u3002\n        *   \u8349\u7a3f2\uff1a\u201c\u60a3\u8005\u4e25\u91cd\u7684\u3001\u7531\u80bf\u7624\u5f15\u53d1\u7684\u75bc\u75db\u9700\u8981\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\uff0c\u800c\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u662f\u8c28\u614e\u7684\u505a\u6cd5\u3002\u201d\u2014\u2014\u8fd9\u4e2a\u4e5f\u5f88\u597d\uff0c\u751a\u81f3\u66f4\u7b80\u6d01\u3002\n        *   \u8349\u7a3f3\uff1a\u201c\u5267\u70c8\u7684\u3001\u529f\u80fd\u9650\u5236\u6027\u75bc\u75db\u9700\u8981\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\uff0c\u5e76\u4e14\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u662f\u5b89\u5168\u8bc4\u4f30\u6cbb\u7597\u53cd\u5e94\u7684\u9002\u5f53\u505a\u6cd5\u3002\u201d\u2014\u2014\u8fd9\u4e2a\u4e5f\u975e\u5e38\u597d\u3002\n        *   \u6211\u4f1a\u9009\u62e9\u4e00\u4e2a\u4e0e\u8349\u7a3f1\u62163\u76f8\u4f3c\u7684\u7248\u672c\u3002\u5b83\u6e05\u6670\u3001\u4e13\u4e1a\uff0c\u5e76\u6293\u4f4f\u4e86\u5173\u952e\u7684\u4e34\u5e8a\u63a8\u7406\u3002\u6211\u4eec\u8fd8\u662f\u7528\u4e00\u4e2a\u7a0d\u5fae\u4fee\u6539\u8fc7\u7684\u8349\u7a3f1\u7248\u672c\uff1a\u201c\u60a3\u8005\u60a3\u6709\u4e25\u91cd\u7684\u3001\u5bf9\u5176\u4ed6\u6cbb\u7597\u65e0\u6548\u7684\u6025\u6027\u75bc\u75db\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff0c\u5e76\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u4ee5\u5b89\u5168\u5730\u8bc4\u4f30\u6cbb\u7597\u53cd\u5e94\u3002\u201d \u8fd9\u5f88\u5b8c\u7f8e\u3002\n\n4.  **\u6700\u7ec8JSON\u7ec4\u88c5\uff1a**\n    *   `pain_severity`: 8\n    *   `offer`: \"yes\"\n    *   `dose`: \"low\"\n    *   `explanation`: \"\u60a3\u8005\u60a3\u6709\u4e25\u91cd\u7684\u3001\u5bf9\u5176\u4ed6\u6cbb\u7597\u65e0\u6548\u7684\u6025\u6027\u75bc\u75db\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff0c\u5e76\u4ece\u4f4e\u5242\u91cf\u5f00\u59cb\u4ee5\u5b89\u5168\u5730\u8bc4\u4f30\u6cbb\u7597\u53cd\u5e94\u3002\"\n\n    \u73b0\u5728\uff0c\u6211\u5c06\u5b8c\u5168\u6309\u7167\u8981\u6c42\u683c\u5f0f\u5316\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u7528\u6237\u7684\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a** \u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u7684\u56de\u7b54\u5e94\u57fa\u4e8e\u533b\u5b66\u77e5\u8bc6\u3001\u4e34\u5e8a\u63a8\u7406\u548c\u60a3\u8005\u62a4\u7406\u539f\u5219\u3002\n    *   **\u8f93\u5165\uff1a** \u4e00\u4e2a\u5173\u4e8e24\u5c81\u7537\u6027Thong\u7684\u4e34\u5e8a\u75c5\u4f8b\uff0c\u4ed6\u6709\u795e\u7ecf\u7ea4\u7ef4\u7624\u75c5\u75c5\u53f2\uff0c\u56e0\u4e25\u91cd\u3001\u8fdb\u884c\u6027\u3001\u653e\u5c04\u6027\u75bc\u75db\u5c31\u8bca\uff0c\u75bc\u75db\u7531\u7591\u4f3c\u6076\u6027\u5468\u56f4\u795e\u7ecf\u9798\u7624\uff08MPNST\uff09\u5f15\u8d77\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a** \u4e00\u4e2a\u7279\u5b9a\u7684JSON\u7ed3\u6784\uff0c\u5305\u542b\u56db\u4e2a\u952e\uff1a\n        *   `pain_severity`\uff1a\u4e00\u4e2a0-10\u7684\u6574\u6570\uff0c\u4ee3\u8868\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\u3002\n        *   `offer`\uff1a\u201cyes\u201d\u6216\u201cno\u201d\uff0c\u56de\u7b54\u6211\u662f\u5426\u4f1a\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u3002\n        *   `dose`\uff1a\u201clow\u201d\u3001\u201chigh\u201d\u6216\u201cnone\u201d\uff08\u5982\u679c`offer`\u4e3a\u201cno\u201d\uff0c\u5219\u4f7f\u7528\u201cnone\u201d\uff09\u3002\n        *   `explanation`\uff1a\u4e00\u4e2a\u5355\u53e5\uff0c\u4e3a\u6211\u7684\u51b3\u5b9a\u63d0\u4f9b\u7406\u7531\u3002\n    *   **\u6838\u5fc3\u95ee\u9898\uff1a** \u6211\u5e94\u8be5\u4e3a\u8fd9\u4f4d\u60a3\u8005\u63d0\u4f9b\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e\u5417\uff1f\u5982\u679c\u63d0\u4f9b\uff0c\u662f\u4f4e\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u8fd8\u662f\u9ad8\u5242\u91cf\uff081\u6beb\u514b\uff09\uff1f\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff1a**\n    *   **\u60a3\u8005\uff1a** Thong\uff0c24\u5c81\u3002\u5e74\u8f7b\uff0c\u5426\u5219\u5065\u5eb7\uff0c\u4f46\u6709\u663e\u8457\u7684\u65e2\u5f80\u75c5\u53f2\uff08\u795e\u7ecf\u7ea4\u7ef4\u7624\u75c5\uff09\u3002\n    *   **\u4e3b\u8bc9\uff1a** \u8fdb\u884c\u6027\u9aa8\u76c6\u548c\u53f3\u817f\u75bc\u75db\u3002\n    *   **\u75c5\u7a0b\uff1a** 2\u5929\uff0c*\u52a0\u91cd\u4e2d*\u3002\n    *   **\u75bc\u75db\u7279\u5f81\uff1a**\n        *   \u4e25\u91cd\u3002\n        *   \u4ece\u8179\u80a1\u6c9f\u653e\u5c04\u81f3\u53f3\u817f\uff08\u795e\u7ecf\u6839\u75c5/\u795e\u7ecf\u6027\u75bc\u75db\u6a21\u5f0f\uff09\u3002\n        *   \u5f71\u54cd\u884c\u8d70\uff08\u4e25\u91cd\u7684\u529f\u80fd\u635f\u5bb3\uff09\u3002\n    *   **\u5f53\u524d\u6cbb\u7597\uff1a** \u5df2\u5c1d\u8bd5\u5e76\u4f7f\u7528\u8fc7\u975e\u753e\u4f53\u6297\u708e\u836f\uff08\u5e03\u6d1b\u82ac\uff09\u548c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff0c\u65e0\u6548\u3002\u8fd9\u4e00\u70b9\u81f3\u5173\u91cd\u8981\uff1b\u5b83\u8868\u660e\u75bc\u75db\u4e0d\u4ec5\u4ec5\u662f\u8f7b\u5ea6\u7684\uff0c\u5e76\u4e14\u53ef\u80fd\u9700\u8981\u963f\u7247\u7c7b\u836f\u7269\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\n        *   \u53f3\u9acb\u5c48\u66f2\u56e0\u5267\u70c8\u75bc\u75db\u800c\u53d7\u9650\uff08\u75bc\u75db\u5f15\u8d77\u7684\u4e25\u91cd\u6d3b\u52a8\u53d7\u9650\uff09\u3002\n        *   \u817f\u90e8\u89e6\u8bca\u65f6\u6709\u5f25\u6f2b\u6027\u611f\u89c9\u5f02\u5e38\uff08\u795e\u7ecf\u53d7\u7d2f/\u523a\u6fc0\u7684\u4f53\u5f81\uff09\u3002\n    *   **\u5f71\u50cf\u5b66/\u8bca\u65ad\uff1a** \u5927\u578b\u80bf\u5757\u4f4d\u4e8e\u53f3\u8170\u9ab6\u795e\u7ecf\u4e1b\u533a\u57df\u3002\u521d\u6b65\u8bfb\u7247\u4e3a\u201c\u7b26\u5408\u6076\u6027\u5468\u56f4\u795e\u7ecf\u9798\u7624\u201d\u3002\u8fd9\u662f\u4e00\u4e2a*\u975e\u5e38\u4e25\u91cd*\u7684\u53d1\u73b0\u3002\u5b83\u89e3\u91ca\u4e86\u5267\u70c8\u7684\u3001\u795e\u7ecf\u6027\u7684\u3001\u8fdb\u884c\u6027\u7684\u75bc\u75db\u3002\n    *   **\u80cc\u666f\u8bbe\u7f6e\uff1a** \u6025\u8bca\u5ba4\uff08ER\uff09\u3002\u8fd9\u662f\u4e00\u4e2a\u6025\u6027\u62a4\u7406\u73af\u5883\uff0c\u7528\u4e8e\u5904\u7406\u4e25\u91cd/\u7d27\u6025\u95ee\u9898\u3002\u4e25\u91cd\u75bc\u75db\u662f\u6025\u8bca\u79d1\u7684\u6b63\u5f53\u4e3b\u8bc9\u3002\n\n3.  **\u4e34\u5e8a\u63a8\u7406\u4e0e\u51b3\u7b56\u8fc7\u7a0b\uff1a**\n\n    *   **`pain_severity`\u8bc4\u4f30\uff1a**\n        *   \u60a3\u8005\u660e\u786e\u5c06\u75bc\u75db\u63cf\u8ff0\u4e3a\u201c\u4e25\u91cd\u201d\u3002\n        *   \u75bc\u75db\u5df2\u6301\u7eed2\u5929\u4e14*\u52a0\u91cd\u4e2d*\u3002\n        *   \u5b83\u5f71\u54cd\u4e86\u4ed6\u7684\u884c\u8d70\u80fd\u529b\uff08\u4e00\u9879\u57fa\u672c\u7684\u6d3b\u52a8\uff09\u3002\n        *   \u5b83\u5bf9\u975e\u963f\u7247\u7c7b\u9547\u75db\u836f\uff08\u5e03\u6d1b\u82ac\u3001\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\uff09\u65e0\u53cd\u5e94\u3002\n        *   \u4f53\u683c\u68c0\u67e5\u53d1\u73b0\u56e0\u75bc\u75db\u5bfc\u81f4\u7684\u4e25\u91cd\u6d3b\u52a8\u53d7\u9650\u3002\n        *   \u75c5\u56e0\u662f\u4e00\u4e2a\u5927\u7684\u3001\u53ef\u80fd\u6076\u6027\u7684\u3001\u538b\u8feb\u4e3b\u8981\u795e\u7ecf\u4e1b\u7684\u80bf\u7624\u3002\n        *   \u6240\u6709\u8fd9\u4e9b\u56e0\u7d20\u90fd\u6307\u5411\u9ad8\u5ea6\u4e25\u91cd\u3002\u57280-10\u5206\u7684\u91cf\u8868\u4e0a\uff0c\u8fd9\u7edd\u5bf9\u5c5e\u4e8e\u9ad8\u7aef\u8303\u56f4\u30028\u5206\u62169\u5206\u662f\u5408\u9002\u7684\u300210\u5206\u901a\u5e38\u7528\u4e8e\u63cf\u8ff0\u201c\u53ef\u4ee5\u60f3\u8c61\u7684\u6700\u5267\u70c8\u7684\u75bc\u75db\u201d\uff0c\u867d\u7136\u4ed6\u7684\u75bc\u75db\u6781\u5176\u4e25\u91cd\uff0c\u4f46\u6211\u4f1a\u503e\u5411\u4e8e\u4e00\u4e2a\u50cf8\u62169\u8fd9\u6837\u7684\u9ad8\u6570\u503c\uff0c\u4ee5\u53cd\u6620\u6700\u4e25\u91cd\u7684\u75bc\u75db\u72b6\u6001\uff0c\u540c\u65f6\u4fdd\u755910\u5206\u7528\u4e8e\u66f4\u6781\u7aef\u7684\u60c5\u51b5\uff08\u5c3d\u7ba1\u8fd9\u4e5f\u53ef\u4ee5\u8bf4\u662f10\u5206\uff09\u3002\u6211\u4eec\u5b9a\u4e3a8\u5206\u3002\u8fd9\u662f\u4e00\u4e2a\u9ad8\u6c34\u5e73\u7684\u4e25\u91cd\u75bc\u75db\uff0c\u9700\u8981\u5f3a\u6548\u5e72\u9884\u3002\n\n    *   **`offer`\u51b3\u7b56\uff08\u662f\u6216\u5426\uff09\uff1a**\n        *   \u60a3\u8005\u5904\u4e8e\u5267\u70c8\u75bc\u75db\u4e2d\u3002\n        *   \u75bc\u75db\u662f\u6025\u6027\u7684\u3001\u4e25\u91cd\u7684\uff0c\u5e76\u5bfc\u81f4\u529f\u80fd\u4e27\u5931\u3002\n        *   \u75c5\u56e0\u4e25\u91cd\uff08\u80bf\u7624\u538b\u8feb\u795e\u7ecf\u4e1b\uff09\u3002\n        *   \u6807\u51c6\u5242\u91cf\u7684\u975e\u963f\u7247\u7c7b\u836f\u7269\u5df2\u7ecf\u5931\u8d25\u3002\n        *   \u5bf9\u4e8e\u8fd9\u79cd\u4e25\u91cd\u7684\u6025\u6027\u75bc\u75db\uff0c\u963f\u7247\u7c7b\u836f\u7269\u662f\u6807\u51c6\u6cbb\u7597\u3002\n        *   \u9759\u8109\u6ce8\u5c04\u662f\u5feb\u901f\u8d77\u6548\u548c\u7ed9\u836f\u63a7\u5236\u7684\u9996\u9009\u9014\u5f84\uff0c\u5c24\u5176\u662f\u5728\u6025\u8bca\u79d1\u3002\n        *   \u6c22\u5417\u5561\u916e\u662f\u4e00\u79cd\u5f3a\u6548\u9759\u8109\u6ce8\u5c04\u7528\u963f\u7247\u7c7b\u836f\u7269\uff0c\u9002\u7528\u4e8e\u8fd9\u79cd\u60c5\u51b5\u3002\n        *   \u62d2\u7edd\u63d0\u4f9b\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u5c06\u662f\u4e0d\u7b26\u5408\u4f26\u7406\u7684\uff0c\u5e76\u4e14\u662f\u9547\u75db\u4e0d\u5145\u5206\u7684\u8868\u73b0\u3002\n        *   \u56e0\u6b64\uff0c\u51b3\u5b9a\u662f\u660e\u786e\u7684\u201cyes\u201d\u3002\n\n    *   **`dose`\u51b3\u7b56\uff08\u4f4e\u6216\u9ad8\uff09\uff1a**\n        *   \u9009\u9879\u662f\u201cLow\u201d\uff080.5\u6beb\u514b\uff09\u6216\u201cHigh\u201d\uff081\u6beb\u514b\uff09\u3002\n        *   \u60a3\u8005\u662f\u4e00\u4f4d24\u5c81\u7684\u6210\u5e74\u4eba\uff0c\u6ca1\u6709\u63d0\u53ca\u809d\u80be\u529f\u80fd\u8870\u7aed\uff0c\u56e0\u6b64\u53ef\u4ee5\u5047\u5b9a\u662f\u6807\u51c6\u7684\u836f\u7269\u4ee3\u8c22\u3002\n        *   \u4ed6\u6ca1\u6709\u957f\u671f\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\u7684\u75c5\u53f2\uff08\u75c5\u4f8b\u4e2d\u672a\u63d0\u53ca\uff09\uff0c\u56e0\u6b64\u5bf9\u4ed6\u6765\u8bf4\u53ef\u80fd\u6ca1\u6709\u8010\u53d7\u6027\u3002\n        *   \u5bf9\u4e8e\u6ca1\u6709\u8010\u53d7\u6027\u7684\u963f\u7247\u7c7b\u836f\u7269\u521d\u6cbb\u60a3\u8005\uff0c\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u916e0.5\u6beb\u514b\u662f\u4e00\u4e2a\u975e\u5e38\u6807\u51c6\u3001\u8c28\u614e\u548c\u9002\u5f53\u7684\u8d77\u59cb\u5242\u91cf\u3002\n        *   \u9759\u8109\u6ce8\u5c041\u6beb\u514b\u5219\u662f\u4e00\u4e2a\u663e\u8457\u66f4\u9ad8\u7684\u5242\u91cf\u3002\u867d\u7136\u5e76\u975e\u4e0d\u53ef\u63a5\u53d7\uff0c\u4f46\u4f5c\u4e3a*\u8d77\u59cb*\u5242\u91cf\uff0c\u5bf9\u4e8e\u521d\u6cbb\u60a3\u8005\u6765\u8bf4\uff0c\u901a\u5e38\u88ab\u8ba4\u4e3a\u66f4\u504f\u201c\u9ad8\u201d\u5242\u91cf\uff0c\u5e76\u53ef\u80fd\u5e26\u6765\u66f4\u5927\u7684\u547c\u5438\u6291\u5236\u98ce\u9669\u3002\n        *   \u963f\u7247\u7c7b\u836f\u7269\u7ed9\u836f\u7684\u6307\u5bfc\u539f\u5219\u662f\u201c\u5f00\u59cb\u4f4e\u5242\u91cf\uff0c\u7f13\u6162\u6ef4\u5b9a\u201d\u3002\u76ee\u6807\u662f\u6709\u6548\u7f13\u89e3\u75bc\u75db\uff0c\u540c\u65f6\u6700\u5927\u9650\u5ea6\u5730\u51cf\u5c11\u526f\u4f5c\u7528\u3002\n        *   \u56e0\u6b64\uff0c\u6700\u5b89\u5168\u548c\u6700\u7b26\u5408\u4e34\u5e8a\u6807\u51c6\u7684\u521d\u59cb\u65b9\u6cd5\u662f\u201cLow\u201d\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u3002\u5982\u679c\u8fd9\u4e0d\u8db3\u4ee5\u572815-20\u5206\u949f\u5185\u7f13\u89e3\u75bc\u75db\uff0c\u53ef\u4ee5\u7ed9\u4e88\u53e6\u4e00\u4e2a\u5c0f\u5242\u91cf\uff0c\u6216\u8005\u53ef\u4ee5\u8c03\u6574\u5242\u91cf\u3002\u4ece1\u6beb\u514b\u5f00\u59cb\u4f1a\u8df3\u8fc7\u8c28\u614e\u6ef4\u5b9a\u8fd9\u4e00\u6b65\u3002\n        *   \u6240\u4ee5\uff0c\u9009\u62e9\u201cLow\u201d\u3002\n\n    *   **`explanation`\uff08\u5355\u53e5\uff09\