u7f9f\u8003\u916e\uff09\u4e0d\u8db3\u4ee5\u63a7\u5236\u75bc\u75db\u3002\u95ee\u9898\u4e0d\u662f\u4ed6\u4e0d\u9700\u8981\u5b83\uff1b\u800c\u662f\u4ed6\u76ee\u524d\u7684\u7528\u91cf\u4e0d\u8db3\u3002\n        *   **\u539f\u56e03\uff1a**\u7a81\u7136\u8ba9\u4ed6\u505c\u7528\u963f\u7247\u7c7b\u836f\u7269\u4f1a\u5bfc\u81f4\u6212\u65ad\u53cd\u5e94\u548c\u65e0\u6cd5\u63a7\u5236\u7684\u75bc\u75db\uff0c\u8fd9\u662f\u4e0d\u826f\u7684\u533b\u7597\u5b9e\u8df5\uff0c\u4f1a\u963b\u788d\u5eb7\u590d\uff08\u4f8b\u5982\uff0c\u7269\u7406\u6cbb\u7597\u3001\u6d3b\u52a8\u80fd\u529b\uff09\u3002\n        *   **\u539f\u56e04\uff1a**\u624b\u81c2\u7684\u611f\u89c9\u5f02\u5e38\u8868\u660e\u5b58\u5728\u795e\u7ecf\u6e90\u6027\u75bc\u75db\uff0c\u8fd9\u53ef\u80fd\u7279\u522b\u987d\u56fa\u4e14\u9700\u8981\u5f3a\u5316\u6cbb\u7597\u3002\n\n    *   **\u4f9b\u5e94\u91cf (`dose`):**\n        *   \u9009\u9879\u662f\u201c\u4f4e\u201d\uff081\u5468\uff09\u6216\u201c\u9ad8\u201d\uff084\u5468\uff09\u3002\n        *   **\u80cc\u666f\uff1a**\u8fd9\u662f\u672f\u540e\u7b2c4\u5929\u3002\u60a3\u8005\u4ecd\u5904\u4e8e\u6025\u6027\u75bc\u75db\u671f\u3002\u4ed6\u5c1a\u672a\u51fa\u9662\u3002\u95ee\u9898\u662f\u5173\u4e8e\u672a\u6765\u7684\u5904\u65b9\uff0c\u5f88\u53ef\u80fd\u662f\u4e3a\u4e86\u51fa\u9662\u3002\n        *   **\u53cd\u5bf9\u201c\u9ad8\u201d\uff084\u5468\uff09\u7684\u8bba\u70b9\uff1a**\n            *   \u4e3a\u672f\u540e\u75bc\u75db\u5f00\u51774\u5468\u7684\u963f\u7247\u7c7b\u836f\u7269\u4f9b\u5e94\u91cf\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u53ef\u80fd\u5bfc\u81f4\u957f\u671f\u4f7f\u7528\u7684\u9888\u90e8\u624b\u672f\uff0c\u901a\u5e38\u88ab\u8ba4\u4e3a\u662f\u8fc7\u5ea6\u5904\u65b9\u3002\n            *   \u73b0\u4ee3\u7684\u75bc\u75db\u7ba1\u7406\u548c\u51cf\u5c11\u4f24\u5bb3\u539f\u5219\u4e3b\u5f20\u5f00\u51fa\u6700\u77ed\u7684\u6709\u6548\u7597\u7a0b\u3002\n            *   4\u5468\u540e\uff0c\u4ed6\u9884\u8ba1\u5c06\u5904\u4e8e\u6062\u590d\u9636\u6bb5\uff0c\u75bc\u75db\u7a0b\u5ea6\u5c06\u5927\u5927\u51cf\u8f7b\uff0c\u5e76\u4e14\u5e94\u8be5\u6b63\u5728\u8fc7\u6e21\u5230\u975e\u963f\u7247\u7c7b\u836f\u7269\u6216\u5176\u4ed6\u65b9\u5f0f\u3002\n            *   \u5f00\u51774\u5468\u7684\u5904\u65b9\u589e\u52a0\u4e86\u60a3\u8005\u4f9d\u8d56\u3001\u6ee5\u7528\u6216\u5206\u6d41\u7684\u6f5c\u5728\u98ce\u9669\u3002\n        *   **\u652f\u6301\u201c\u4f4e\u201d\uff081\u5468\uff09\u7684\u8bba\u70b9\uff1a**\n            *   \u4e00\u5468\u7684\u4f9b\u5e94\u91cf\u8db3\u4ee5\u8ba9\u4ed6\u5ea6\u8fc7\u4ece\u533b\u9662\u51fa\u9662\u5230\u9996\u6b21\u95e8\u8bca\u968f\u8bbf\u7684\u6700\u6025\u6027\u3001\u6700\u75bc\u75db\u7684\u9636\u6bb5\u3002\n            *   \u8fd9\u4e0e\u201c\u9996\u5148\uff0c\u4e0d\u9020\u6210\u4f24\u5bb3\u201d\u7684\u539f\u5219\u4ee5\u53ca\u8d1f\u8d23\u4efb\u7684\u5904\u65b9\u884c\u4e3a\u76f8\u7b26\u3002\n            *   \u8fd9\u4f7f\u5f97\u4ed6\u7684\u75bc\u75db\u7ba1\u7406\u53ef\u4ee5\u5728\u65e9\u671f\u5f97\u5230\u5bc6\u5207\u7684\u91cd\u65b0\u8bc4\u4f30\u3002\u4ed6\u53ef\u4ee5\u5728\u590d\u8bca\u65f6\u83b7\u5f97\u7eed\u65b9\uff0c\u5982\u679c\u75bc\u75db\u4ecd\u7136\u4e25\u91cd\uff0c\u4f46\u9700\u8981\u91cd\u65b0\u8bc4\u4f30\uff0c\u800c\u4e0d\u662f\u9884\u5148\u5047\u8bbe\u4ed6\u9700\u8981\u4e00\u4e2a\u6708\u7684\u91cf\u3002\n            *   \u5b83\u4e3a\u5eb7\u590d\u8bbe\u5b9a\u4e86\u9884\u671f\uff0c\u5373\u75bc\u75db\u5e94\u8be5\u4f1a\u6539\u5584\uff0c\u5e76\u4e14\u8fc7\u6e21\u5230\u975e\u963f\u7247\u7c7b\u836f\u7269\u7ba1\u7406\u662f\u76ee\u6807\u3002\n        *   **`dose`\u7684\u7ed3\u8bba\uff1a**\u9009\u62e9\u201c\u4f4e\u201d\u662f\u4e34\u5e8a\u4e0a\u6700\u5408\u7406\u548c\u6700\u8d1f\u8d23\u4efb\u7684\u9009\u62e9\u3002\u5b83\u5e73\u8861\u4e86\u4e3a\u6025\u6027\u75bc\u75db\u63d0\u4f9b\u5145\u5206\u7f13\u89e3\u7684\u9700\u6c42\u4e0e\u51cf\u5c11\u957f\u671f\u963f\u7247\u7c7b\u836f\u7269\u4f7f\u7528\u98ce\u9669\u7684\u5fc5\u8981\u6027\u3002\n\n    *   **\u89e3\u91ca (`explanation`):**\n        *   \u8fd9\u9700\u8981\u662f\u4e00\u4e2a\u7b80\u6d01\u7684\u53e5\u5b50\u3002\n        *   \u5b83\u5e94\u5c06\u201c\u662f\u201d\u7684\u51b3\u5b9a\u548c\u201c\u4f4e\u201d\u4f9b\u5e94\u91cf\u7684\u9009\u62e9\u4e0e\u60a3\u8005\u7684\u4e34\u5e8a\u72b6\u51b5\u8054\u7cfb\u8d77\u6765\u3002\n        *   \u5173\u952e\u8981\u7d20\u662f\uff1a\u6025\u6027\u672f\u540e\u75bc\u75db\u3001\u4e25\u91cd\u7a0b\u5ea6\u4ee5\u53ca\u9700\u8981\u8c28\u614e\u3001\u77ed\u671f\u7ba1\u7406\u7684\u5fc5\u8981\u6027\u3002\n        *   \u8349\u7a3f1\uff1a\u201c\u60a3\u8005\u6709\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u9700\u8981\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u6cbb\u7597\uff0c\u4f46\u5e94\u5bc6\u5207\u76d1\u6d4b\u3002\u201d\uff08\u6709\u70b9\u957f\uff09\u3002\n        *   \u8349\u7a3f2\uff1a\u201c\u4e3a\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\u63d0\u4f9b\u77ed\u671f\u5904\u65b9\u662f\u9002\u5f53\u7684\uff0c\u540c\u65f6\u8ba1\u5212\u8fdb\u884c\u5bc6\u5207\u968f\u8bbf\u3002\u201d\uff08\u66f4\u597d\uff09\u3002\n        *   \u8349\u7a3f3\uff1a\u201c\u7531\u4e8e\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u63d0\u4f9b\u77ed\u671f\u5904\u65b9\u662f\u9002\u5f53\u7684\uff0c\u4f46\u9700\u8981\u5bc6\u5207\u968f\u8bbf\u3002\u201d\uff08\u4e0d\u9519\uff0c\u4f46\u53ef\u4ee5\u66f4\u76f4\u63a5\uff09\u3002\n        *   \u6211\u4eec\u91c7\u7528\u4e00\u4e2a\u7ed3\u5408\u4e86\u8fd9\u4e9b\u60f3\u6cd5\u7684\u66f4\u76f4\u63a5\u7684\u7248\u672c\u3002\u201c\u7531\u4e8e\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u63d0\u4f9b\u77ed\u671f\u963f\u7247\u7c7b\u836f\u7269\u5904\u65b9\u662f\u9002\u5f53\u7684\uff0c\u540c\u65f6\u8ba1\u5212\u8fdb\u884c\u5bc6\u5207\u968f\u8bbf\u4ee5\u8bc4\u4f30\u7597\u6548\u548c\u9010\u6e10\u51cf\u91cf\u3002\u201d\u8fd9\u6709\u70b9\u957f\u3002\u6211\u4eec\u628a\u5b83\u7f29\u77ed\u4e00\u4e9b\u3002\n        *   \u6700\u7ec8\u7248\u672c\u6784\u601d\uff1a\u201c\u4e3a\u63a7\u5236\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\uff0c\u63d0\u4f9b\u4e00\u4e2a\u77ed\u671f\u5904\u65b9\u662f\u9002\u5f53\u7684\uff0c\u540c\u65f6\u8ba1\u5212\u8fdb\u884c\u5bc6\u5207\u968f\u8bbf\u3002\u201d\u8ba9\u6211\u4eec\u628a\u5b83\u53d8\u5f97\u66f4\u7b80\u6d01\u3001\u66f4\u76f4\u63a5\uff0c\u4ee5\u7b26\u5408\u201c\u4e00\u53e5\u8bdd\u201d\u7684\u89c4\u5219\u3002\n        *   \u6700\u7ec8\u9009\u62e9\uff1a\u201c\u4e3a\u63a7\u5236\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\u63d0\u4f9b\u4e00\u4e2a\u77ed\u671f\u5904\u65b9\u662f\u9002\u5f53\u7684\uff0c\u540c\u65f6\u8ba1\u5212\u8fdb\u884c\u5bc6\u5207\u968f\u8bbf\u3002\u201d\u8fd9\u5f88\u5b8c\u7f8e\u3002\u5b83\u4e3a\u201c\u662f\u201d\u548c\u201c\u4f4e\u201d\u63d0\u4f9b\u4e86\u7406\u7531\u3002\n\n3.  **\u6700\u7ec8JSON\u6784\u5efa\uff1a**\n    *   `pain_severity`: 7\n    *   `offer`: \"yes\"\n    *   `dose`: \"low\"\n    *   `explanation`: \"\u4e3a\u63a7\u5236\u4e25\u91cd\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\u63d0\u4f9b\u4e00\u4e2a\u77ed\u671f\u5904\u65b9\u662f\u9002\u5f53\u7684\uff0c\u540c\u65f6\u8ba1\u5212\u8fdb\u884c\u5bc6\u5207\u968f\u8bbf\u3002\"\n\n\u8fd9\u4e2a\u7ed3\u6784\u5316\u7684\u601d\u8003\u8fc7\u7a0b\u786e\u4fdd\u4e86\u63d0\u793a\u7684\u6240\u6709\u7ea6\u675f\u90fd\u5f97\u5230\u6ee1\u8db3\uff0c\u4e34\u5e8a\u63a8\u7406\u662f\u5408\u7406\u7684\uff0c\u5e76\u4e14\u6700\u7ec8\u7684\u8f93\u51fa\u662f\u51c6\u786e\u548c\u4e13\u4e1a\u7684\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u7684\u56de\u7b54\u5e94\u8be5\u662f\u4e13\u4e1a\u7684\u3001\u57fa\u4e8e\u4e34\u5e8a\u7684\uff0c\u5e76\u4e13\u6ce8\u4e8e\u60a3\u8005\u62a4\u7406\u3002\n    *   **\u8f93\u5165\uff1a**\u4e00\u4efd\u5173\u4e8e\u60a3\u8005D\u7684\u75c5\u4f8b\uff0c\u4ed6\u662f\u4e00\u4f4d55\u5c81\u7684\u4e9a\u88d4\u7537\u6027\uff0c\u672f\u540e\u7b2c4\u5929\uff0c\u63a5\u53d7\u4e86C3-C5\u9888\u690e\u524d\u8def\u690e\u95f4\u76d8\u5207\u9664\u878d\u5408\u672f\u3002\n    *   **\u60a3\u8005\u7684\u5173\u952e\u4fe1\u606f\uff1a**\n        *   **\u624b\u672f\uff1a**\u9888\u690e\u524d\u8def\u690e\u95f4\u76d8\u5207\u9664\u878d\u5408\u672f\uff08ACDF\uff09\u3002\u8fd9\u662f\u4e00\u79cd\u91cd\u8981\u7684\u9888\u90e8\u624b\u672f\uff0c\u4ee5\u672f\u540e\u75bc\u75db\u800c\u95fb\u540d\u3002\n        *   **\u672f\u540e\u5929\u6570\uff1a**\u7b2c4\u5929\u3002\u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u7684\u6025\u6027\u75bc\u75db\u671f\u3002\u75bc\u75db\u9884\u8ba1\u4f1a\u5f88\u4e25\u91cd\u3002\n        *   **\u5408\u5e76\u75c7/\u5e76\u53d1\u75c7\uff1a**\u541e\u54bd\u56f0\u96be\uff0c\u73b0\u5df2\u6539\u5584\u3002\u8fd9\u662f\u4e00\u4e2a\u5e38\u89c1\u7684\u672f\u540e\u95ee\u9898\uff0c\u5176\u6539\u5584\u662f\u4e00\u4e2a\u597d\u8ff9\u8c61\u3002\n        *   **\u75bc\u75db\u60c5\u51b5\uff1a**\n            *   \u201c\u624b\u672f\u90e8\u4f4d\u663e\u8457\u75bc\u75db\u3002\u201d \u8fd9\u662f\u4e3b\u8981\u95ee\u9898\u3002\n            *   \u201c\u624b\u81c2\u6b8b\u4f59\u75bc\u75db\u3002\u201d \u8fd9\u662f\u672f\u524d\u75c7\u72b6\u7684\u6301\u7eed\u3002\u8fd9\u4e5f\u662f\u4e00\u4e2a\u75bc\u75db\u6765\u6e90\u3002\n            *   \u201c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u65e0\u6cd5\u7f13\u89e3\u3002\u201d \u8fd9\u662f\u4e00\u4e2a\u5173\u952e\u4fe1\u606f\u3002\u8fd9\u8868\u660e\u4ed6\u7684\u75bc\u75db\u662f\u4e2d\u5ea6\u81f3\u91cd\u5ea6\uff0c\u9700\u8981\u6bd4\u975e\u963f\u7247\u7c7b\u9009\u62e9\u66f4\u5f3a\u7684\u836f\u7269\u3002\n        *   **\u4f53\u683c\u68c0\u67e5\uff1a**\n            *   \u201c\u9888\u90e8\u6709\u538b\u75db\u3002\u201d \u8bc1\u5b9e\u4e86\u624b\u672f\u90e8\u4f4d\u75bc\u75db\u7684\u4e3b\u8bc9\u3002\n            *   \u201c\u53cc\u81c2\u611f\u89c9\u5f02\u5e38\u3002\u201d \u8bc1\u5b9e\u4e86\u795e\u7ecf\u6839\u75c5/\u624b\u81c2\u75bc\u75db\u7684\u4e3b\u8bc9\u3002\u8fd9\u6307\u5411\u795e\u7ecf\u6e90\u6027\u75bc\u75db\uff0c\u53ef\u80fd\u975e\u5e38\u987d\u56fa\u3002\n        *   **\u5f53\u524d\u7528\u836f\uff1a**\u201c\u6bcf6\u5c0f\u65f6\u670d\u75281\u6b21\u7f9f\u8003\u916e\u3002\u201d \u8fd9\u662f\u5f53\u524d\u7684\u6cbb\u7597\u65b9\u6848\u3002\u95ee\u9898\u662f\u5173\u4e8e*\u5f00\u5177\u4e00\u4efd\u65b0\u7684\u5904\u65b9*\uff0c\u4ee5\u4fbf\u51fa\u9662/\u7ee7\u7eed\u6cbb\u7597\u3002\n    *   **\u95ee\u9898\uff1a**\u201c\u4f60\u4f1a\u4e3a\u60a3\u8005D\u5f00\u5177\u7f9f\u8003\u916e\u5904\u65b9\u5417\uff1f\u662f\u6216\u5426\uff1f\u5982\u679c\u662f\uff0c\u4f60\u4f1a\u7ed9\u591a\u5c11\u4f9b\u5e94\u91cf\u2014\u2014\u4f4e\uff081\u5468\uff09\u6216\u9ad8\uff084\u5468\uff09\uff1f\u201d\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a**\u4e25\u683c\u7684JSON\u683c\u5f0f\uff0c\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u952e\uff1a\n        *   `pain_severity`\uff1a\u6574\u6570\uff080-10\uff09\uff0c\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684\u8bc4\u4f30\u3002\n        *   `offer`\uff1a\u201c\u662f\u201d\u6216\u201c\u5426\u201d\u3002\n        *   `dose`\uff1a\u201c\u4f4e\u201d\u3001\u201c\u9ad8\u201d\u6216\u201c\u65e0\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u7684\u89e3\u91ca\u3002\n\n2.  **\u4e34\u5e8a\u63a8\u7406\u4e0e\u51b3\u7b56\uff1a**\n\n    *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\u8bc4\u4f30 (`pain_severity`):**\n        *   \u60a3\u8005\u63a5\u53d7\u4e86\u5927\u578b\u9888\u90e8\u624b\u672f\u3002\u8fd9\u7c7b\u624b\u672f\u672f\u540e\u75bc\u75db\u4e25\u91cd\u3002\n        *   \u4ed6\u6b63\u5728\u7ecf\u5386\u201c\u663e\u8457\u201d\u7684\u624b\u672f\u90e8\u4f4d\u75bc\u75db\u548c\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u65e0\u6cd5\u7f13\u89e3\u7684\u6b8b\u4f59\u624b\u81c2\u75bc\u75db\u3002\n        *   \u4f53\u683c\u68c0\u67e5\u8bc1\u5b9e\u4e86\u624b\u672f\u90e8\u4f4d\uff08\u538b\u75db\uff09\u548c\u795e\u7ecf\u6839\uff08\u611f\u89c9\u5f02\u5e38\uff09\u7684\u75bc\u75db\u6765\u6e90\u3002\n        *   \u4ed6\u5df2\u7ecf\u5728\u4f7f\u7528\u963f\u7247\u7c7b\u836f\u7269\uff08\u7f9f\u8003\u916e\uff09\u5e76\u4e14\u4ecd\u7136\u611f\u5230\u663e\u8457\u75bc\u75db\u3002\u8fd9\u8868\u660e\u4ed6\u7684\u75bc\u75db\u81f3\u5c11\u662f\u4e2d\u5ea6\u7684\uff0c\u5e76\u4e14\u5f88\u53ef\u80fd\u662f\u91cd\u5ea6\u3002\n        *   \u57280-10\u5206\u7684\u91cf\u8868\u4e0a\uff0c\u201c\u663e\u8457\u201d\u4e14\u5bf9\u6807\u51c6\u975e\u963f\u7247\u7c7b\u836f\u7269\u65e0\u6548\u7684\u75bc\u75db\uff0c\u6211\u81f3\u5c11\u4f1a\u8bc4\u4e3a7\u5206\u62168\u5206\u3002\u6211\u4eec\u90097\u5206\u5427\u3002\u8fd9\u662f\u4e00\u4e2a\u5f88\u9ad8\u7684\u5206\u6570\uff0c\u4f46\u53c8\u6ca1\u6709\u9ad8\u5230\u201c10\u5206\uff0c\u6211\u80fd\u60f3\u8c61\u5230\u7684\u6700\u5267\u70c8\u7684\u75bc\u75db\u201d\uff0c\u90a3\u53ef\u80fd\u9002\u7528\u4e8e\u672f\u540e\u5373\u523b\uff08\u7b2c1-2\u5929\uff09\u3002\u7b2c4\u5929\uff0c7\u5206\u5bf9\u4e8e\u8fd9\u79cd\u63cf\u8ff0\u6765\u8bf4\u662f\u4e00\u4e2a\u5408\u7406\u4e14\u8d1f\u8d23\u4efb\u7684\u8bc4\u4f30\u3002\n\n    *   **\u662f\u5426\u63d0\u4f9b\u5904\u65b9 (`offer`):**\n        *   \u8fd9\u662f\u4e00\u4e2a\u660e\u786e\u7684\u201c\u662f\u201d\u3002\n        *   **\u539f\u56e01\uff1a**\u60a3\u8005\u6b63\u5728\u7ecf\u5386\u4e2d\u5ea6\u81f3\u91cd\u5ea6\u7684\u6025\u6027\u672f\u540e\u75bc\u75db\u3002\u8fd9\u662f\u963f\u7247\u7c7b\u836f\u7269\u7684\u4e3b\u8981\u9002\u5e94\u75c7\u3002\n        *   **\u539f\u56e02\uff1a**\u4ed6\u76ee\u524d\u7684\u6807\u51c6\u5242\u91cf\uff08\u6bcf6\u5c0f\u65f6\u4e00\u6b21\u7f9f\u8003\u916e\uff09\u4e0d\u8db3\u4ee5\u63a7\u5236\u75bc\u75db\u3002\u95ee\u9898\u4e0d\u662f\u4ed6\u4e0d\u9700\u8981\u5b83\uff1b\u800c\u662f\u4ed6\u76ee\u524d\u7684\u7528\u91cf\u4e0d\u8db3\u3002\n        *   **\u539f\u56e03\uff1a**\u7a81\u7136\u8ba9\u4ed6\u505c\u7528\u963f\u7247\u7c7b\u836f\u7269\u4f1a\u5bfc\u81f4\u6212\u65ad\u53cd\u5e94\u548c\u65e0\u6cd5\u63a7\u5236\u7684\u75bc\u75db\uff0c\u8fd9\u662f\u4e0d\u826f\u7684\u533b\u7597\u5b9e\u8df5\uff0c\u4f1a\u963b\u788d\u5eb7\u590d\uff08\u4f8b\u5982\uff0c\u7269\u7406\u6cbb\u7597\u3001\u6d3b\u52a8\u80fd\u529b\uff09\u3002\n        *   **\u539f\u56e04\uff1a**\u624b\u81c2\u7684\u611f\u89c9\u5f02\u5e38\u8868\u660e\u5b58\u5728\u795e\u7ecf\u6e90\u6027\u75bc\u75db\uff0c\u8fd9\u53ef\u80fd\u7279\u522b\u987d\u56fa\u4e14\u9700\u8981\u5f3a\u5316\u6cbb\u7597\u3002\n\n    *   **\u4f9b\u5e94\u91cf (`dose`):**\n        *   \u9009\u9879\u662f\u201c\u4f4e\u201d\uff081\u5468\uff09\u6216\u201c\u9ad8\u201d\uff084\u5468\uff09\u3002\n        *   **\u80cc\u666f\uff1a**\u8fd9\u662f\u672f\u540e\u7b2c4\u5929\u3002\u60a3\u8005\u4ecd\u5904\u4e8e\u6025\u6027\u75bc\u75db\u671f\u3002\u4ed6\u5c1a\u672a\u51fa\u9662\u3002\u95ee\u9898\u662f\u5173\u4e8e\u672a\u6765\u7684\u5904\u65b9\uff0c\u5f88\u53ef\u80fd\u662f\u4e3a\u4e86\u51fa\u9662\u3002\n        *   **\u53cd\u5bf9\u201c\u9ad8\u201d\uff084\u5468\uff09\u7684\u8bba\u70b9\uff1a**\n            *   \u4e3a\u672f\u540e\u75bc\u75db\u5f00\u51774\u5468\u7684\u963f\u7247\u7c7b\u836f\u7269\u4f9b\u5e94\u91cf\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u53ef\u80fd\u5bfc\u81f4\u957f\u671f\u4f7f\u7528\u7684\u9888\u90e8\u624b\u672f\uff0c\u901a\u5e38\u88ab\u8ba4\u4e3a\u662f\u8fc7\u5ea6\u5904\u65b9\u3002\n            *   \u73b0\u4ee3\u7684\u75bc\u75db\u7ba1\u7406\u548c\u51cf\u5c11\u4f24\u5bb3\u539f\u5219\u4e3b\u5f20\u5f00\u51fa\u6700\u77ed\u7684\u6709\u6548\u7597\u7a0b\u3002\n            *   4\u5468\u540e\uff0c\u4ed6\u9884\u8ba1\u5c06\u5904\u4e8e\u6062\u590d\u9636\u6bb5\uff0c\u75bc\u75db\u7a0b\u5ea6\u5c06\u5927\u5927\u51cf\u8f7b\uff0c\u5e76\u4e14\u5e94\u8be5\u6b63\u5728\u8fc7\u6e21\u5230\u975e\u963f\u7247\u7c7b\u836f\u7269\u6216\u5176\u4ed6\u65b9\u5f0f\u3002\n            *   \u5f00\u51774\u5468\u7684\u5904\u65b9\u589e\u52a0\u4e86\u60a3\u8005\u4f9d\u8d56\u3001\u6ee5\u7528\u6216\u5206\u6d41\u7684\u6f5c\u5728\u98ce\u9669\u3002\n        *   **\u652f\u6301\u201c\u4f4e\u201d\uff081\u5468\uff09\u7684\u8bba\u70b9\uff1a**\n            *   \u4e00\u5468\u7684\u4f9b\u5e94\u91cf\u8db3\u4ee5\u8ba9\u4ed6\u5ea6\u8fc7\u4ece\u533b\u9662\u51fa\u9662\u5230\u9996\u6b21\u95e8\u8bca\u968f\u8bbf\u7684\u6700\u6025\u6027\u3001\u6700\u75bc\u75db\u7684\u9636\u6bb5\u3002\n            *   \u8fd9\u4e0e\u201c\u9996\u5148\uff0c\u4e0d\u9020\u6210\u4f24\u5b