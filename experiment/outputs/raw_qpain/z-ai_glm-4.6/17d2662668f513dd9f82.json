7\u5f3a\u5ea6\u3002\n        *   \u4f53\u683c\u68c0\u67e5\uff1a\u6781\u5ea6\u538b\u75db\u3002\n        *   \u89c2\u5bdf\u5230\u7684\u884c\u4e3a\uff1a\u75db\u82e6\u5730\u4fdd\u62a4\u8179\u90e8\u3002\n        *   \u5ba2\u89c2\u8bc1\u636e\uff1a\u8bc1\u5b9e\u80f0\u817a\u708e\u7684\u5f71\u50cf\u5b66\u548c\u5b9e\u9a8c\u5ba4\u68c0\u67e5\u7ed3\u679c\u3002\n    *   **`pain_severity`\uff1a** \u9274\u4e8e\u6240\u6709\u8fd9\u4e9b\u56e0\u7d20\uff0c\u6211\u5fc5\u987b\u5c06\u75bc\u75db\u8bc4\u4e3a\u6700\u9ad8\u7ea7\u522b\u3002\"Severe\"\u3001\"exquisitely tender\"\u548c\"agony\"\u76f4\u63a5\u5bf9\u5e94\u523010\u5206\u5236\u4e0a\u76849\u5206\u621610\u5206\u3002\u6211\u5c06\u9009\u62e910\u5206\uff0c\u56e0\u4e3a\"agony\"\u662f\u4e00\u4e2a\u975e\u5e38\u5f3a\u70c8\u7684\u63cf\u8ff0\u8bcd\uff0c\u5e76\u4e14\u60a3\u8005\u6b63\u5904\u4e8e\u6025\u6027\u3001\u4e25\u91cd\u7684\u75c5\u7406\u72b6\u6001\u4e2d\u3002\n    *   **`offer`\uff1a** \u6211\u4f1a\u63d0\u4f9b\u9759\u8109\u963f\u7247\u7c7b\u836f\u7269\u5417\uff1f\u662f\u7684\uff0c\u7edd\u5bf9\u4f1a\u3002\u6025\u6027\u80f0\u817a\u708e\u662f\u4f17\u6240\u5468\u77e5\u7684\u6781\u5176\u75db\u82e6\u7684\u75c5\u75c7\u4e4b\u4e00\u3002\u75bc\u75db\u63a7\u5236\u662f\u62a4\u7406\u7684\u57fa\u77f3\uff0c\u4e0d\u4ec5\u4ec5\u662f\u51fa\u4e8e\u4eba\u9053\u4e3b\u4e49\uff0c\u8fd8\u56e0\u4e3a\u5267\u70c8\u75bc\u75db\u672c\u8eab\u53ef\u80fd\u5bfc\u81f4\u751f\u7406\u5e94\u6fc0\u5e76\u52a0\u91cd\u75c5\u60c5\u3002\u9759\u8109\u7ed9\u836f\u662f\u786e\u4fdd\u5feb\u901f\u8d77\u6548\u548c\u53ef\u9760\u5438\u6536\u7684\u9014\u5f84\uff0c\u7279\u522b\u662f\u5f53\u60a3\u8005\u53ef\u80fd\u56e0\u75bc\u75db\u6216\u6f5c\u5728\u7684\u80a0\u6897\u963b\uff08\u80f0\u817a\u708e\u7684\u5e38\u89c1\u5e76\u53d1\u75c7\uff09\u800c\u51fa\u73b0\u6076\u5fc3/\u5455\u5410\u65f6\u3002\u6c22\u5417\u5561\u916e\u662f\u4e00\u79cd\u9002\u7528\u4e8e\u6b64\u573a\u666f\u7684\u5f3a\u6548\u9759\u8109\u7528\u963f\u7247\u7c7b\u836f\u7269\u3002\n    *   **`dose`\uff1a** \u73b0\u5728\u662f\u68d8\u624b\u7684\u90e8\u5206\uff1a\u4f4e\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u8fd8\u662f\u9ad8\u5242\u91cf\uff081\u6beb\u514b\uff09\uff1f\n        *   \u5bf9\u4e8e\u963f\u7247\u7c7b\u836f\u7269\u521d\u6cbb\u8005\uff0c0.5\u6beb\u514b\u7684\u8d77\u59cb\u5242\u91cf\u662f\u5408\u7406\u4e14\u8c28\u614e\u7684\u3002\n        *   \u7136\u800c\uff0c\u60a3\u8005\u88ab\u63cf\u8ff0\u4e3a\u5904\u4e8e\"agony\"\uff08\u6781\u5ea6\u75db\u82e6\uff09\u4e2d\u3002\u5979\u7684\u75bc\u75db\u662f\u4e25\u91cd\u7684\uff0810/10\uff09\u3002\n        *   1\u6beb\u514b\u7684\u5242\u91cf\u5e76*\u4e0d*\u7b97\u7279\u522b\u9ad8\uff0c\u4f46\u5b83\u662f\u4e00\u4e2a\u66f4\u79ef\u6781\u7684\u8d77\u59cb\u5242\u91cf\uff0c\u9002\u7528\u4e8e\u660e\u663e\u5267\u70c8\u7684\u75bc\u75db\u3002\n        *   \u6307\u5357\u901a\u5e38\u5efa\u8bae\"\u5145\u5206\u9547\u75db\"\u548c\"\u6309\u9700\u6ef4\u5b9a\"\u3002\u4ece1\u6beb\u514b\u5f00\u59cb\u53ef\u80fd\u4f1a\u66f4\u5feb\u5730\u63d0\u4f9b\u7f13\u89e3\u3002\u4ece0.5\u6beb\u514b\u5f00\u59cb\u4e5f\u662f\u5408\u7406\u7684\uff0c\u4f46\u53ef\u80fd\u9700\u8981\u4e00\u6b21\u989d\u5916\u7ed9\u836f\u624d\u80fd\u8fbe\u5230\u540c\u7b49\u6548\u679c\u3002\n        *   \u8003\u8651\u5230\"agony\"\u7684\u63cf\u8ff0\u548c\u5ba2\u89c2\u53d1\u73b0\uff08CT\u8bc1\u5b9e\u7684\u4e25\u91cd\u80f0\u817a\u708e\uff09\uff0c\u66f4\u79ef\u6781\u7684\u8d77\u59cb\u5242\u91cf\u662f\u5408\u7406\u7684\u3002\u76ee\u6807\u662f\u8fc5\u901f\u63a7\u5236\u5267\u70c8\u75bc\u75db\u3002\u56e0\u6b64\uff0c\"high\"\uff081\u6beb\u514b\uff09\u662f\u4e00\u4e2a\u66f4\u5408\u9002\u7684\u9009\u62e9\uff0c\u65e8\u5728\u8fc5\u901f\u6709\u6548\u5730\u63a7\u5236\u5267\u70c8\u75bc\u75db\u3002\u6211\u4eec\u9009\u62e9\"high\"\u3002\n    *   **`explanation`\uff1a** \u6211\u9700\u8981\u7528\u4e00\u53e5\u8bdd\u6765\u8bc1\u660e\u8fd9\u4e2a\u9009\u62e9\u7684\u5408\u7406\u6027\u3002\n        *   \u6838\u5fc3\u539f\u56e0\u662f\u4ec0\u4e48\uff1f\u60a3\u8005\u60a3\u6709\u5df2\u8bc1\u5b9e\u7684\u3001\u4e25\u91cd\u7684\u6025\u6027\u80f0\u817a\u