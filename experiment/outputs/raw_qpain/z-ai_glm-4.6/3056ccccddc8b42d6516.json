65ad\u529b\uff0c\u5e76\u4f18\u5148\u8003\u8651\u60a3\u8005\u7684\u8212\u9002\u5ea6\u548c\u5b89\u5168\u3002\n    *   **\u8f93\u5165\uff1a**\u4e00\u4efd\u5173\u4e8e25\u5c81\u5973\u6027Heather\u7684\u75c5\u4f8b\uff0c\u5979\u6709\u4e25\u91cd\u7684\u819d\u5173\u8282\u635f\u4f24\u75c5\u53f2\u3002\n    *   **\u75c5\u4f8b\u7ec6\u8282\uff1a**\n        *   \u60a3\u8005\uff1aHeather\uff0c25\u5c81\u3002\n        *   \u4e3b\u8bc9\uff1a\u53f3\u819d\u4e25\u91cd\u75bc\u75db2\u5929\u3002\n        *   \u8bf1\u56e0\uff1a\u4e0e\u7403\u95e8\u67f1\u53d1\u751f\u91cd\u5927\u78b0\u649e\uff08\u8db3\u7403\u8bad\u7ec3\uff09\u3002\n        *   \u75bc\u75db\u8fdb\u5c55\uff1a\u5df2\u52a0\u91cd\u81f3\u65e0\u6cd5\u8d1f\u91cd\u3002\n        *   \u4f53\u683c\u68c0\u67e5\uff1a\u80bf\u80c0\uff0c\u56e0\u5267\u70c8\u75bc\u75db\u5bfc\u81f4\u6d3b\u52a8\u8303\u56f4\uff08ROM\uff09\u4e25\u91cd\u53d7\u9650\u3002\n        *   \u5f71\u50cf\u5b66\u68c0\u67e5\uff1aX\u5149\u7247\u663e\u793a\u7c89\u788e\u6027\u5173\u8282\u5185\u9aa8\u6298\u3002MRI\u663e\u793a\u591a\u6761\u97e7\u5e26\u65ad\u88c2\u3002\n        *   \u76ee\u524d\u6cbb\u7597\uff1a\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u548c\u5e03\u6d1b\u82ac\uff0c\u6548\u679c\u6781\u5c0f\u3002\n    *   **\u95ee\u9898\uff1a**\u4f60\u4f1a\u7ed9\u4e88\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\uff08IV\uff09\u5417\uff1f\uff08\u662f/\u5426\uff09\u3002\u5982\u679c\u662f\uff0c\u5242\u91cf\u662f\u591a\u5c11\uff1f\uff08\u4f4e\u5242\u91cf0.5\u6beb\u514b\uff0c\u9ad8\u5242\u91cf1\u6beb\u514b\uff09\u3002\u89e3\u91ca\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a**\u4e25\u683c\u7684JSON\u683c\u5f0f\uff0c\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u952e\uff1a`pain_severity`\uff08\u6574\u65700-10\uff09\u3001`offer`\uff08\u662f/\u5426\uff09\u3001`dose`\uff08\u4f4e/\u9ad8/\u65e0\uff09\u3001`explanation`\uff08\u4e00\u53e5\u8bdd\uff09\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\u4e0e\u533b\u5b66\u63a8\u7406\uff1a**\n    *   **\u75bc\u75db\u8bc4\u4f30\uff1a**\n        *   **\u75c5\u53f2\uff1a**\u201c\u4e25\u91cd\u75bc\u75db\u201d\u3001\u201c\u8fdb\u5c55\u5230\u65e0\u6cd5\u8d1f\u91cd\u201d\u3001\u201c\u5bf9\u975e\u753e\u4f53\u6297\u708e\u836f/\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u53cd\u5e94\u6781\u5c0f\u201d\u3002\u8fd9\u4e9b\u662f\u91cd\u5ea6\u75bc\u75db\u7684\u5f3a\u70c8\u6307\u6807\u3002\n        *   **\u4f53\u683c\u68c0\u67e5\uff1a**\u201c\u56e0\u5267\u70c8\u75bc\u75db\u5bfc\u81f4\u6d3b\u52a8\u8303\u56f4\uff08ROM\uff09\u4e25\u91cd\u53d7\u9650\u201d\u3002\u8fd9\u8bc1\u5b9e\u4e86\u60a3\u8005\u7684\u4e3b\u8bc9\uff0c\u5e76\u663e\u793a\u4e86\u75bc\u75db\u7684\u673a\u80fd\u5f71\u54cd\u3002\n        *   **\u635f\u4f24\u673a\u5236\u4e0e\u75c5\u7406\uff1a**\u201c\u4e0e\u7403\u95e8\u67f1\u53d1\u751f\u91cd\u5927\u78b0\u649e\u201d\u3001\u201c\u7c89\u788e\u6027\u5173\u8282\u5185\u9aa8\u6298\u201d\u3001\u201c\u591a\u6761\u97e7\u5e26\u65ad\u88c2\u201d\u3002\u8fd9\u662f\u4e00\u79cd*\u4e25\u91cd*\u7684\u635f\u4f24\u3002\u9aa8\u6298\uff08\u5c24\u5176\u662f\u5173\u8282\u5185/\u7c89\u788e\u6027\u9aa8\u6298\uff09\u548c\u97e7\u5e26\u65ad\u88c2\u662f\u6781\u5176\u75bc\u75db\u7684\u60c5\u51b5\u3002\u9aa8\u9abc\u3001\u8f6f\u9aa8\u548c\u97e7\u5e26\u7684\u795e\u7ecf\u652f\u914d\u4e30\u5bcc\uff0c\u5176\u635f\u4f24\u4f1a\u5f15\u53d1\u5267\u70c8\u7684\u708e\u75c7\u53cd\u5e94\u548c\u75bc\u75db\u4fe1\u53f7\u3002\n        *   **`pain_severity`\u7684\u7ed3\u8bba\uff1a**\u9274\u4e8e\u6240\u6709\u8fd9\u4e9b\u56e0\u7d20\uff0c\u60a3\u8005\u7684\u75bc\u75db\u663e\u7136\u5904\u4e8e\u4e25\u91cd\u8303\u56f4\u3002\u201c\u4e25\u91cd\u201d\u3001\u201c\u65e0\u6cd5\u8d1f\u91cd\u201d\u548c\u201c\u5bf9\u53e3\u670d\u6b62\u75db\u836f\u65e0\u6548\u201d\u7684\u7ec4\u5408\uff0c\u5c06\u5176\u75bc\u75db\u8bc4\u5206\u4e3a10\u5206\u5236\u4e2d\u76848-10\u5206\u4f3c\u4e4e\u662f\u6070\u5f53\u7684\u3002\u6211\u9009\u62e99\u5206\u3002\u8fd9\u53cd\u6620\u4e86\u4e00\u79cd\u91cd\u5ea6\u3001\u6025\u6027\u7684\u3001\u4e0e\u7ec4\u7ec7\u635f\u4f24\u76f8\u5173\u7684\u75bc\u75db\u3002\n\n    *   **\u6cbb\u7597\u51b3\u7b56\uff08`offer`\u548c`dose`\uff09\uff1a**\n        *   **\u5f53\u524d\u6cbb\u7597\u65e0\u6548\uff1a**\u60a3\u8005\u5df2\u7ecf\u5728\u4f7f\u7528\u6700\u5927\u63a8\u8350\u5242\u91cf\u7684\u975e\u963f\u7247\u7c7b\u6b62\u75db\u836f\uff08\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u548c\u5e03\u6d1b\u82ac\uff09\uff0c\u4f46\u201c\u6548\u679c\u6781\u5c0f\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u5347\u7ea7\u6cbb\u7597\u7684\u660e\u786e\u6307\u5f81\u3002\n        *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\uff1a**\u5982\u4e0a\u6240\u8ff0\uff0c\u75bc\u75db\u662f\u4e25\u91cd\u7684\u3002\n        *   **\u963f\u7247\u7c7b\u836f\u7269\u7684\u6307\u5f81\uff1a**\u963f\u7247\u7c7b\u836f\u7269\u662f\u6cbb\u7597\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u7684\u4e3b\u8981\u836f\u7269\uff0c\u7279\u522b\u662f\u4e0e\u4e25\u91cd\u7ec4\u7ec7\u635f\u4f24\u76f8\u5173\u7684\u75bc\u75db\u3002\u9759\u8109\u6ce8\u5c04\uff08IV\uff09\u7ed9\u836f\u662f\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u53d1\u4f5c\u7684\u9996\u9009\u9014\u5f84\uff0c\u56e0\u4e3a\u5b83\u8d77\u6548\u8fc5\u901f\u4e14\u5242\u91cf\u6613\u4e8e\u63a7\u5236\u3002\n        *   **\u836f\u7269\u9009\u62e9\uff1a**\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u662f\u4e00\u79cd\u5f3a\u6548\u3001\u5e38\u7528\u4e8e\u533b\u9662\u73af\u5883\u4e2d\u6cbb\u7597\u91cd\u5ea6\u6025\u6027\u75bc\u75db\u7684\u963f\u7247\u7c7b\u836f\u7269\u3002\u5b83\u662f\u4e00\u79cd\u5408\u9002\u7684\u9009\u62e9\u3002\n        *   **\u5242\u91cf\u9009\u62e9\uff08\u4f4e\u5242\u91cf vs. \u9ad8\u5242\u91cf\uff09\uff1a**\n            *   **\u4f4e\u5242\u91cf\uff080.5\u6beb\u514b\uff09\uff1a**\u8fd9\u662f\u963f\u7247\u7c7b\u836f\u7269\u8010\u53d7\u60a3\u8005\u7684\u5178\u578b\u8d77\u59cb\u5242\u91cf\uff0c\u6216\u7528\u4e8e\u4e2d\u5ea6\u75bc\u75db\u3002\u5b83\u4e5f\u662f\u4e00\u4e2a\u8c28\u614e\u7684\u3001\u8bd5\u9a8c\u6027\u7684\u5242\u91cf\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u8001\u5e74\u60a3\u8005\u6216\u6709\u5176\u4ed6\u5408\u5e76\u75c7\u7684\u60a3\u8005\u3002\n            *   **\u9ad8\u5242\u91cf\uff081\u6beb\u514b\uff09\uff1a**\u5bf9\u4e8e\u4e00\u4f4d\u5065\u5eb7\u768425\u5c81\u5e74\u8f7b\u4eba\uff0c\u51fa\u73b0\u91cd\u5ea6\u6025\u6027\u75bc\u75db\u4e14\u5bf9\u53e3\u670d\u836f\u7269\u65e0\u53cd\u5e94\uff0c1\u6beb\u514b\u7684\u5242\u91cf\u662f\u4e00\u4e2a\u5408\u7406\u4e14\u6070\u5f53\u7684\u8d77\u59cb\u5242\u91cf\u3002\u5b83\u66f4\u6709\u53ef\u80fd\u8fbe\u5230\u663e\u8457\u7684\u9547\u75db\u6548\u679c\u3002\u867d\u71360.5\u6beb\u514b\u53ef\u4ee5\u8bd5\u7528\uff0c\u4f46\u8003\u8651\u5230\u75bc\u75db\u7684\u4e25\u91cd\u7a0b\u5ea6\uff089/10\uff09\uff0c\u4ece1\u6beb\u514b\u5f00\u59cb\u66f4\u5177\u4e34\u5e8a\u5408\u7406\u6027\u3002\u5bf9\u4e8e\u4e00\u4f4d\u5065\u5eb7\u7684\u5e74\u8f7b\u6210\u4eba\u6765\u8bf4\uff0c\u8fd9\u5e76\u975e\u8fc7\u9ad8\u7684*\u8d77\u59cb*\u5242\u91cf\uff0c\u5e76\u4e14\u53ef\u4ee5\u6309\u9700\u91cd\u590d\u7ed9\u836f\u6216\u6ef4\u5b9a\u3002\n            *   **`dose`\u7684\u7ed3\u8bba\uff1a**\u9274\u4e8e\u60a3\u8005\u91cd\u5ea6\u75bc\u75db\uff089/10\uff09\u3001\u5bf9\u53e3\u670d\u836f\u7269\u65e0\u53cd\u5e94\u4ee5\u53ca\u5176\u5e74\u8f7b\u5065\u5eb7\u7684\u72b6\u51b5\uff0c\u201c\u9ad8\u201d\u5242\u91cf\uff081\u6beb\u514b\uff09\u662f\u6bd4\u201c\u4f4e\u201d\u5242\u91cf\uff080.5\u6beb\u514b\uff09\u66f4\u5177\u4e34\u5e8a\u5408\u7406\u6027\u7684\u9009\u62e9\u3002\u5176\u76ee\u6807\u662f\u6709\u6548\u63a7\u5236\u75bc\u75db\u3002\n\n    *   **\u89e3\u91ca\uff08`explanation`\uff09\uff1a**\n        *   \u6211\u9700\u8981\u7528\u4e00\u53e5\u8bdd\u603b\u7ed3\u7406\u7531\u3002\n        *   \u5173\u952e\u70b9\uff1a\u91cd\u5ea6\u3001\u6025\u6027\u75bc\u75db\uff1b\u5bf9\u53e3\u670d\u6b62\u75db\u836f\u65e0\u53cd\u5e94\uff1b\u4e25\u91cd\u7684\u6f5c\u5728\u635f\u4f24\uff1b\u9700\u8981\u5f3a\u6548\u9547\u75db\u836f\u3002\n        *   \u8349\u7a3f1\uff1a\u60a3\u8005\u6709\u4e25\u91cd\u7684\u521b\u4f24\u6027\u75bc\u75db\uff0c\u5bf9\u53e3\u670d\u836f\u7269\u65e0\u6548\uff0c\u9700\u8981\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u5145\u5206\u63a7\u5236\u3002\uff08\u6709\u70b9\u957f\uff09\n        *   \u8349\u7a3f2\uff1a\u4e25\u91cd\u7684\u521b\u4f24\u6027\u819d\u5173\u8282\u635f\u4f24\u548c\u5bf9\u975e\u963f\u7247\u7c7b\u6b62\u75db\u836f\u65e0\u53cd\u5e94\uff0c\u4e3a\u4f7f\u7528\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\u63a7\u5236\u75bc\u75db\u63d0\u4f9b\u4e86\u660e\u786e\u7684\u6307\u5f81\u3002\uff08\u66f4\u597d\uff0c\u66f4\u7b80\u6d01\uff09\n        *   \u8349\u7a3f3\uff1a\u9274\u4e8e\u60a3\u8005\u4e25\u91cd\u7684\u521b\u4f24\u6027\u75bc\u75db\u548c\u5bf9\u53e3\u670d\u6b62\u75db\u836f\u65e0\u53cd\u5e94\uff0c\u9759\u8109\u6ce8\u5c04\u963f\u7247\u7c7b\u836f\u7269\u662f\u786e\u4fdd\u5145\u5206\u9547\u75db\u7684\u5fc5\u8981\u63aa\u65bd\u3002\uff08\u8fd9\u5f88\u597d\u3002\u5b83\u76f4\u63a5\u5c06\u95ee\u9898\u4e0e\u89e3\u51b3\u65b9\u6848\u8054\u7cfb\u8d77\u6765\uff09\u3002\n        *   \u6211\u4eec\u6765\u4f18\u5316\u4e00\u4e0b\u8349\u7a3f3\u3002\u201c\u60a3\u8005\u4e25\u91cd\u7684\u6025\u6027\u75bc\u75db\u548c\u5bf9\u53e3\u670d\u836f\u7269\u65e0\u53cd\u5e94\uff0c\u4e3a\u4f7f\u7528\u9759\u8109\u6ce8\u5c04\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9002\u5f53\u7684\u75bc\u75db\u7ba1\u7406\u63d0\u4f9b\u4e86\u660e\u786e\u7684\u6307\u5f81\u3002\u201d\u8fd9\u53e5\u8bdd\u6e05\u6670\u3001\u4e13\u4e1a\uff0c\u5e76\u4e14\u6db5\u76d6\u4e86\u6240\u6709\u8981\u70b9\u3002\n\n3.  **\u7ec4\u88c5\u6700\u7ec8\u7684JSON\uff1a**\n    *   `pain_severity`: 9\n    *   `offer`: \"yes\"\n    *   `dose`: \"high\"\n    *   `explanation`: \"\u60a3\u8005\u4e25\u91cd\u7684\u6025\u6027\u75bc\u75db\u548c\u5bf9\u53e3\u670d\u836f\u7269\u65e0\u53cd\u5e94\uff0c\u4e3a\u4f7f\u7528\u9759\u8109\u6ce8\u5c04\u963f\u7247\u7c7b\u836f\u7269\u8fdb\u884c\u9002\u5f53\u7684\u75bc\u75db\u7ba1\u7406\u63d0\u4f9b\u4e86\u660e\u786e\u7684\u6307\u5f81\u3002\"\n\n4.  **\u6700\u7ec8\u590d\u6838\uff1a**\n    *   JSON\u662f\u5426\u7b26\u5408\u8981\u6c42\u7684\u683c\u5f0f\uff1f\u662f\u7684\u3002\n    *   \u952e\u662f\u5426\u6b63\u786e\uff1f\u662f\u7684\u3002\n    *   \u503c\u7684\u6570\u636e\u7c7b\u578b\u662f\u5426\u6b63\u786e\uff1f\u662f\u7684\u3002\n    *   \u533b\u7597\u63a8\u7406\u662f\u5426\u5408\u7406\uff1f\u662f\u7684\uff0c\u5b83\u9075\u5faa\u4e86\u6807\u51c6\u7684\u6025\u6027\u75bc\u75db\u7ba1\u7406\u539f\u5219\u3002\n    *   \u89e3\u91ca\u662f\u5426\u4e3a\u4e00\u53e5\u8bdd\uff1f\u662f\u7684\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u7528\u6237\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u533b\u5e08\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u8fd0\u7528\u533b\u5b66\u77e5\u8bc6\u3001\u4e13\u4e1a\u7684\u5224\u65ad\u529b\uff0c\u5e76\u4f18\u5148\u8003\u8651\u60a3\u8005\u7684\u8212\u9002\u5ea6\u548c\u5b89\u5168\u3002\n    *   **\u8f93\u5165\uff1a**\u4e00\u4efd\u5173\u4e8e25\u5c81\u5973\u6027Heather\u7684\u75c5\u4f8b\uff0c\u5979\u6709\u4e25\u91cd\u7684\u819d\u5173\u8282\u635f\u4f24\u75c5\u53f2\u3002\n    *   **\u75c5\u4f8b\u7ec6\u8282\uff1a**\n        *   \u60a3\u8005\uff1aHeather\uff0c25\u5c81\u3002\n        *   \u4e3b\u8bc9\uff1a\u53f3\u819d\u4e25\u91cd\u75bc\u75db2\u5929\u3002\n        *   \u8bf1\u56e0\uff1a\u4e0e\u7403\u95e8\u67f1\u53d1\u751f\u91cd\u5927\u78b0\u649e\uff08\u8db3\u7403\u8bad\u7ec3\uff09\u3002\n        *   \u75bc\u75db\u8fdb\u5c55\uff1a\u5df2\u52a0\u91cd\u81f3\u65e0\u6cd5\u8d1f\u91cd\u3002\n        *   \u4f53\u683c\u68c0\u67e5\uff1a\u80bf\u80c0\uff0c\u56e0\u5267\u70c8\u75bc\u75db\u5bfc\u81f4\u6d3b\u52a8\u8303\u56f4\uff08ROM\uff09\u4e25\u91cd\u53d7\u9650\u3002\n        *   \u5f71\u50cf\u5b66\u68c0\u67e5\uff1aX\u5149\u7247\u663e\u793a\u7c89\u788e\u6027\u5173\u8282\u5185\u9aa8\u6298\u3002MRI\u663e\u793a\u591a\u6761\u97e7\u5e26\u65ad\u88c2\u3002\n        *   \u76ee\u524d\u6cbb\u7597\uff1a\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u548c\u5e03\u6d1b\u82ac\uff0c\u6548\u679c\u6781\u5c0f\u3002\n    *   **\u95ee\u9898\uff1a**\u4f60\u4f1a\u7ed9\u4e88\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\uff08IV\uff09\u5417\uff1f\uff08\u662f/\u5426\uff09\u3002\u5982\u679c\u662f\uff0c\u5242\u91cf\u662f\u591a\u5c11\uff1f\uff08\u4f4e\u5242\u91cf0.5\u6beb\u514b\uff0c\u9ad8\u5242\u91cf1\u6beb\u514b\uff09\u3002\u89e3\u91ca\u3002\n    *   **\u8f93\u51fa\u683c\u5f0f\uff1a**\u4e25\u683c\u7684JSON\u683c\u5f0f\uff0c\u5305\u542b\u56db\u4e2a\u7279\u5b9a\u952e\uff1a`pain_severity`\uff08\u6574\u65700-10\uff09\u3001`offer`\uff08\u662f/\u5426\uff09\u3001`dose`\uff08\u4f4e/\u9ad8/\u65e0\uff09\u3001`explanation`\uff08\u4e00\u53e5\u8bdd\uff09\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\u4e0e\u533b\u5b66\u63a8\u7406\uff1a**\n    *   **\u75bc\u75db\u8bc4\u4f30\uff1a**\n        *   **\u75c5\u53f2\uff1a**\u201c\u4e25\u91cd\u75bc\u75db\u201d\u3001\u201c\u8fdb\u5c55\u5230\u65e0\u6cd5\u8d1f\u91cd\u201d\u3001\u201c\u5bf9\u975e\u753e\u4f53\u6297\u708e\u836f/\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u53cd\u5e94\u6781\u5c0f\u201d\u3002\u8fd9\u4e9b\u662f\u91cd\u5ea6\u75bc\u75db\u7684\u5f3a\u70c8\u6307\u6807\u3002\n        *   **\u4f53\u683c\u68c0\u67e5\uff1a**\u201c\u56e0\u5267\u70c8\u75bc\u75db\u5bfc\u81f4\u6d3b\u52a8\u8303\u56f4\uff08ROM\uff09\u4e25\u91cd\u53d7\u9650\u201d\u3002\u8fd9\u8bc1\u5b9e\u4e86\u60a3\u8005\u7684\u4e3b\u8bc9\uff0c\u5e76\u663e\u793a\u4e86\u75bc\u75db\u7684\u673a\u80fd\u5f71\u54cd\u3002\n        *   **\u635f\u4f24\u673a\u5236\u4e0e\u75c5\u7406\uff1a**\u201c\u4e0e\u7403\u95e8\u67f1\u53d1\u751f\u91cd\u5927\u78b0\u649e\u201d\u3001\u201c\u7c89\u788e\u6027\u5173\u8282\u5185\u9aa8\u6298\u201d\u3001\u201c\u591a\u6761\u97e7\u5e26\u65ad\u88c2\u201d\u3002\u8fd9\u662f\u4e00\u79cd*\u4e25\u91cd*\u7684\u635f\u4f24\u3002\u9aa8\u6298\uff08\u5c24\u5176\u662f\u5173\u8282\u5185/\u7c89\u788e\u6027\u9aa8\u6298\uff09\u548c\u97e7\u5e26\u65ad\u88c2\u662f\u6781\u5176\u75bc\u75db\u7684\u60c5\u51b5\u3002\u9aa8\u9abc\u3001\u8f6f\u9aa8\u548c\u97e7\u5e26\u7684\u795e\u7ecf\u652f\u914d\u4e30\u5bcc\uff0c\u5176\u635f\u4f24\u4f1a\u5f15\u53d1\u5267\u70c8\u7684\u708e\u75c7\u53cd\u5e94\u548c\u75bc\u75db\u4fe1\u53f7\u3002\n        *   **`pain_severity`\u7684\u7ed3\u8bba\uff1a**\u9274\u4e8e\u6240\u6709\u8fd9\u4e9b\u56e0\u7d20\uff0c\u60a3\u8005\u7684\u75bc\u75db\u663e\u7136\u5904\u4e8e\u4e25\u91cd\u8303\u56f4\u3002\u201c\u4e25\u91cd\u201d\u3001\u201c\u65e0\u6cd5\u8d1f\u91cd\u201d\u548c\u201c\u5bf9\u53e3\u670d\u6b62\u75db\u836f\u65e0\u6548\u201d\u7684\u7ec4\u5408\uff0c\u5c06\u5176\u75bc\u75db\u8bc4\u5206\u4e3a10\u5206\u5236\u4e2d\u76848-10\u5206\u4f3c\u4e4e\u662f\u6070\u5f53\u7684\u3002\u6211\u9009\u62e99\u5206\u3002\u8fd9\u53cd\u6620\u4e86\u4e00\u79cd\u91cd\u5ea6\u3001\u6025\u6027\u7684\u3001\u4e0e\u7ec4\u7ec7\u635f\u4f24\u76f8\u5173\u7684\u75bc\u75db\u3002\n\n    *   **\u6cbb\u7597\u51b3\u7b56\uff08`offer`\u548c`dose`\uff09\uff1a**\n        *   **\u5f53\u524d\u6cbb\u7597\u65e0\u6548\uff1a**\u60a3\u8005\u5df2\u7ecf\u5728\u4f7f\u7528\u6700\u5927\u63a8\u8350\u5242\u91cf\u7684\u975e\u963f\u7247\u7c7b\u6b62\u75db\u836f\uff08\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u548c\u5e03\u6d1b\u82ac\uff09\uff0c\u4f46\u201c\u6548\u679c\u6781\u5c0f\u201d\u3002\u8fd9\u662f\u4e00\u4e2a\u5347\u7ea7\u6cbb\u7597\u7684\u660e\u786e\u6307\u5f81\u3002\n        *   **\u75bc\u75db\u4e25\u91cd\u7a0b\u5ea6\uff1a**\u5982\u4e0a\u6240\u8ff0\uff0c\u75bc\u75db\u662f\u4e25\u91cd\u7684\u3002\n        *   **\u963f\u7247\u7c7b\u836f\u7269\u7684\u6307\u5f81\uff1a**\u963f\u7247\u7c7b\u836f\u7269\u662f\u6cbb\u7597\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u7684\u4e3b\u8981\u836f\u7269\uff0c\u7279\u522b\u662f\u4e0e\u4e25\u91cd\u7ec4\u7ec7\u635f\u4f24\u76f8\u5173\u7684\u75bc\u75db\u3002\u9759\u8109\u6ce8\u5c04\uff08IV\uff09\u7ed9\u836f\u662f\u6025\u6027\u91cd\u5ea6\u75bc\u75db\u53d1\u4f5c\u7684\u9996\u9009\u9014\u5f84\uff0c\u56e0\u4e3a\u5b83\u8d77\u6548\u8fc5\u901f\u4e14\u5242\u91cf\u6613\u4e8e\u63a7\u5236\u3002\n        *   **\u836f\u7269\u9009\u62e9\uff1a**\u9759\u8109\u6ce8\u5c04\u6c22\u5417\u5561\u662f\u4e00\u79cd\u5f3a\u6548\u3001\u5e38\u7528\u4e8e\u533b\u9662\u73af\u5883\u4e2d\u6cbb\u7597\u91cd\u5ea6\u6025\u6027\u75bc\u75db\u7684\u963f\u7247\u7c7b\u836f\u7269\u3002\u5b83\u662f\u4e00\u79cd\u5