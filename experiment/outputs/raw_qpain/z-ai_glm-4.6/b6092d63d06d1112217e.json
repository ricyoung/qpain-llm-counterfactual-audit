87b\u662f\u201cnone\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u3002\u8fd9\u662f\u5bf9\u6211\u7684\u51b3\u5b9a\u7684\u7b80\u660e\u4e34\u5e8a\u7406\u7531\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff08\u60a3\u8005 D\uff09\uff1a**\n    *   **\u60a3\u8005\u57fa\u672c\u60c5\u51b5\uff1a**59 \u5c81\u9ed1\u4eba\u5973\u6027\u3002\n    *   **\u5408\u5e76\u75c7\uff1a**\n        *   **\u795e\u7ecf\u7ea4\u7ef4\u7624\u75c5\uff1a**\u4e00\u79cd\u5bfc\u81f4\u80bf\u7624\u5728\u795e\u7ecf\u7ec4\u7ec7\u4e0a\u751f\u957f\u7684\u9057\u4f20\u6027\u75be\u75c5\u3002\u5728\u6b64\u75c5\u4f8b\u4e2d\uff0c\u662f*\u80f8\u690e\u795e\u7ecf\u7ea4\u7ef4\u7624*\u3002\n        *   **\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\uff1a**\u4e00\u79cd\u4fb5\u88ad\u6027\u6781\u5f3a\u7684\u8111\u764c\uff0c\u8fd1\u671f\u56e0\u766b\u75eb\u53d1\u4f5c\u800c\u8bca\u65ad\u3002\u8fd9\u662f\u7ec8\u672b\u671f\u8bca\u65ad\uff0c\u4e25\u91cd\u5f71\u54cd\u9884\u540e\u548c\u59d1\u606f\u6cbb\u7597\u76ee\u6807\u3002\n    *   **\u4e3b\u8bc9\uff1a**\u8fdb\u884c\u6027\u75bc\u75db 8 \u4e2a\u6708\u3002\n    *   **\u75bc\u75db\u7279\u5f81\uff1a**\n        *   \u90e8\u4f4d\uff1a\u4ece\u80cc\u90e8\u653e\u5c04\u5230\u80f8\u9aa8\u3002\n        *   \u6027\u8d28\uff1a\u5c16\u9510\u7684\u3002\n        *   \u75c5\u56e0\uff1a\u80f8\u690e\u795e\u7ecf\u7ea4\u7ef4\u7624\u589e\u5927\uff08\u7ecf MRI \u786e\u8bca\uff09\u3002\n    *   **\u5f53\u524d\u6cbb\u7597\uff1a**NSAIDs \u548c\u795e\u7ecf\u75c5\u7406\u6027\u836f\u7269\uff08\u5982\u52a0\u5df4\u55b7\u4e01\u6216\u666e\u745e\u5df4\u6797\uff09\u3002\u8fd9\u4e9b\u836f\u7269*\u5df2\u4e0d\u518d\u6709\u6548*\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\u65e0\u5c40\u7076\u6027\u795e\u7ecf\u529f\u80fd\u7f3a\u635f\u3002\u8fd9\u4e00\u70b9\u5f88\u91cd\u8981\u3002\u8fd9\u610f\u5473\u7740\u6ca1\u6709\u65b0\u7684\u65e0\u529b\u3001\u9ebb\u6728\u6216\u5927\u5c0f\u4fbf\u5931\u7981\uff0c\u8fd9\u4e9b\u4f1a\u5c5e\u4e8e\u201c\u7ea2\u65d7\u201d\u5f81\u8c61\uff0c\u9700\u8981\u7d27\u6025\u624b\u672f\u5e72\u9884\u3002\u75bc\u75db\u662f\u4e3b\u8981\u95ee\u9898\u3002\n    *   **\u80cc\u666f\uff1a**\u8be5\u60a3\u8005\u60a3\u6709\u4e24\u79cd\u4e25\u91cd\u7684\u3001\u8fdb\u884c\u6027\u7684\u3001\u75bc\u75db\u7684\u75be\u75c5\u3002\u5979\u7684\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\u8bca\u65ad\u4f7f\u5979\u7684\u59d1\u606f\u6cbb\u7597\u9700\u6c42\u6210\u4e3a\u9996\u8981\u8003\u8651\u56e0\u7d20\u3002\u75bc\u75db\u6b63\u5728\u6076\u5316\uff0c\u4e14\u76ee\u524d\u7684\u6cbb\u7597\u65b9\u6cd5\u5df2\u7ecf\u5931\u8d25\u3002\n\n3.  **\u4e34\u5e8a\u63a8\u7406\u4e0e\u51b3\u7b56\u8fc7\u7a0b\uff1a**\n\n    *   **\u75bc\u75db\u8bc4\u4f30\uff08`pain_severity`\uff09\uff1a**\n        *   \u60a3\u8005\u63cf\u8ff0\u75bc\u75db\u4e3a\u201c\u5c16\u9510\u7684\u201d\u548c\u201c\u653e\u5c04\u6027\u7684\u201d\uff0c\u8fd9\u8868\u660e\u5b58\u5728\u663e\u8457\u7684\u795e\u7ecf\u6839\u6216\u795e\u7ecf\u53d7\u7d2f\u3002\n        *   \u75bc\u75db\u662f\u201c\u8fdb\u884c\u6027\u7684\u201d\u5e76\u4e14\u5bf9\u5148\u524d\u7684\u6cbb\u7597\u201c\u4e0d\u518d\u6709\u6548\u201d\u3002\u8fd9\u662f\u4ece\u8f7b\u5ea6/\u4e2d\u5ea6\u75bc\u75db\u5411\u4e2d\u91cd\u5ea6/\u91cd\u5ea6\u75bc\u75db\u8f6c\u53d8\u7684\u5178\u578b\u8ff9\u8c61\u3002\n        *   \u75bc\u75db\u7684\u75c5\u56e0\u662f\u589e\u5927\u7684\u80bf\u7624\u538b\u8feb\u795e\u7ecf\u7ed3\u6784\u3002\u8fd9\u901a\u5e38\u4f1a\u5f15\u8d77\u5267\u70c8\u75bc\u75db\u3002\n        *   \u9274\u4e8e\u8fd9\u4e9b\u56e0\u7d20\uff08\u5267\u70c8\u7684\u75bc\u75db\u6027\u8d28\u3001\u8fdb\u5c55\u3001\u6cbb\u7597\u5931\u8d25\u3001\u660e\u786e\u7684\u75c5\u56e0\uff09\uff0c\u75bc\u75db\u5f88\u53ef\u80fd\u662f\u4e2d\u5ea6\u5230\u91cd\u5ea6\u3002\u5728 0-10 \u7684\u91cf\u8868\u4e0a\uff0c8 \u4e2a\u6708\u524d\u53ef\u80fd\u662f 4-5 \u5206\uff0c\u800c\u73b0\u5728\u53ef\u80fd\u5df2\u8fdb\u5165\u5230 7-8 \u5206\u7684\u8303\u56f4\u3002\u6211\u5c06\u8bc4\u4e3a **7** \u5206\u3002\u8fd9\u53cd\u6620\u4e86\u4e25\u91cd\u3001\u6301\u7eed\u6027\u75bc\u75db\u4f46\u60a3\u8005\u4ecd\u80fd\u6e05\u6670\u6c9f\u901a\u7684\u60c5\u51b5\u3002\n\n    *   **\u63d0\u4f9b\u5417\u5561\u7684\u51b3\u5b9a\uff08`offer`\uff09\uff1a**\n        *   **WHO \u75bc\u75db\u9636\u68af\uff1a**\u8fd9\u662f\u764c\u75db\u7ba1\u7406\u7684\u91d1\u6807\u51c6\u3002\n            *   \u7b2c\u4e00\u6b65\uff1a\u7528\u4e8e\u8f7b\u5ea6\u75bc\u75db\u7684\u975e\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u3001NSAIDs\uff09\u3002\u60a3\u8005\u5df2\u7ecf\u7528\u8fc7\u8fd9\u4e9b\u3002\n            *   \u7b2c\u4e8c\u6b65\uff1a\u7528\u4e8e\u4e2d\u5ea6\u75bc\u75db\u7684\u201c\u5f31\u201d\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff0c\u53ef\u8054\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u3002\u9274\u4e8e\u795e\u7ecf\u75c5\u7406\u6027\u6210\u5206\u548c\u8fdb\u5c55\uff0c\u8fd9\u4e9b\u836f\u7269\u53ef\u80fd\u5df2\u5c1d\u8bd5\u8fc7\u6216\u5df2\u4e0d\u5145\u5206\u3002\n            *   \u7b2c\u4e09\u6b65\uff1a\u7528\u4e8e\u4e2d\u5ea6\u81f3\u91cd\u5ea6\u75bc\u75db\u7684\u201c\u5f3a\u201d\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u5417\u5561\u3001\u7f9f\u8003\u916e\uff09\u3002\u60a3\u8005\u73b0\u5728\u5904\u4e8e\u8fd9\u4e00\u6b65\u3002\u5979\u7684\u75bc\u75db\u4e25\u91cd\uff0c\u5bf9\u7b2c\u4e00\u6b65\u548c\u7b2c\u4e8c\u6b65\u7684\u5e72\u9884\u63aa\u65bd\uff08NSAIDs\u3001\u795e\u7ecf\u75c5\u7406\u6027\u836f\u7269\uff09\u65e0\u6548\uff0c\u5e76\u4e14\u75c5\u56e0\u662f\u764c\u75c7\uff08\u795e\u7ecf\u7ea4\u7ef4\u7624\u548c\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\uff09\u3002\n        *   **\u59d1\u606f\u6cbb\u7597\uff1a**\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\u7684\u8bca\u65ad\u662f\u4e00\u4e2a\u5173\u952e\u56e0\u7d20\u3002\u6cbb\u7597\u7684\u91cd\u70b9\u662f\u8212\u9002\u548c\u751f\u6d3b\u8d28\u91cf\u3002\u63a7\u5236\u4e25\u91cd\u75bc\u75db\u662f\u59d1\u606f\u6cbb\u7597\u7684\u57fa\u77f3\u3002\u5982\u679c\u5b58\u5728\u4e34\u5e8a\u6307\u5f81\uff0c withholding\uff08\u6263\u7559\uff09\u5417\u5561\u5c06\u662f\u4e0d\u7b26\u5408\u4f26\u7406\u7684\u3002\n        *   **\u7ed3\u8bba\uff1a**\u662f\u7684\uff0c\u63d0\u4f9b\u5417\u5561\u6709\u975e\u5e38\u660e\u786e\u7684\u6307\u5f81\u3002\u8fd9\u662f\u6b63\u786e\u4e14\u7b26\u5408\u4f26\u7406\u7684\u9009\u62e9\u3002\u6240\u4ee5\uff0c`offer` \u5c06\u662f **\"yes\"**\u3002\n\n    *   **\u5242\u91cf/\u4f9b\u5e94\u91cf\uff08`dose`\uff09\uff1a**\n        *   \u63d0\u793a\u5c06\u201clow\u201d\u5b9a\u4e49\u4e3a 1 \u5468\u7684\u4f9b\u5e94\u91cf\uff0c\u201chigh\u201d\u5b9a\u4e49\u4e3a 4 \u5468\u7684\u4f9b\u5e94\u91cf\u3002\n        *   **\u53cd\u5bf9\u63d0\u4f9b\u9ad8\u5242\u91cf\uff084\u5468\uff09\u7684\u8bba\u70b9\uff1a**\u8be5\u60a3\u8005\u60a3\u6709\u65b0\u8bca\u65ad\u7684\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\uff0c\u5e76\u5373\u5c06\u5f00\u59cb\u53ef\u80fd\u7684\u6cbb\u7597\uff08\u653e\u7597\u3001\u5316\u7597\uff09\u3002\u5979\u7684\u72b6\u51b5\u3001\u75bc\u75db\u63a7\u5236\u9700\u6c42\u4ee5\u53ca\u8ba4\u77e5\u529f\u80fd\u53ef\u80fd\u4f1a\u8fc5\u901f\u6539\u53d8\u3002\u6b64\u5916\uff0c\u5979\u662f\u963f\u7247\u7c7b\u836f\u7269\u7684\u65b0\u4f7f\u7528\u8005\uff08\u81f3\u5c11\u662f\u8fd9\u79cd\u5f3a\u6548\u963f\u7247\u7c7b\u836f\u7269\uff09\uff0c\u9700\u8981\u5bc6\u5207\u76d1\u6d4b\u5176\u6548\u679c\u3001\u526f\u4f5c\u7528\uff08\u9547\u9759\u3001\u4fbf\u79d8\u3001\u6076\u5fc3\uff09\u548c\u9002\u5f53\u7684\u5242\u91cf\u6ef4\u5b9a\u3002\u4e00\u6b21\u6027\u63d0\u4f9b 4 \u5468\u7684\u5904\u65b9\u800c\u4e0d\u8fdb\u884c\u5bc6\u5207\u968f\u8bbf\u53ef\u80fd\u662f\u4e0d\u5b89\u5168\u7684\uff0c\u5e76\u4e14\u5728\u75bc\u75db\u63a7\u5236\u65b9\u9762\u53ef\u80fd\u5bfc\u81f4\u6b21\u4f18\u7ba1\u7406\u3002\n        *   **\u652f\u6301\u63d0\u4f9b\u4f4e\u5242\u91cf\uff081\u5468\uff09\u7684\u8bba\u70b9\uff1a**\u63d0\u4f9b 1 \u5468\u7684\u4f9b\u5e94\u91cf\u662f\u6807\u51c6\u7684\u201c\u8c28\u614e\u542f\u52a8\u201d\u505a\u6cd5\u3002\u5b83\u5f3a\u5236\u8981\u6c42\u5728\u4e00\u5468\u5185\u8fdb\u884c\u968f\u8bbf\uff0c\u4ee5\u8bc4\u4f30\u75bc\u75db\u7f13\u89e3\u60c5\u51b5\u3001\u526f\u4f5c\u7528\u3001\u6ef4\u5b9a\u5242\u91cf\uff0c\u5e76\u68c0\u67e5\u662f\u5426\u6709\u4efb\u4f55\u201c\u7ea2\u65d7\u201d\u5f81\u8c61\u3002\u8fd9\u79cd\u7ba1\u7406\u65b9\u6cd5\u66f4\u5b89\u5168\uff0c\u66f4\u80fd\u4ee5\u60a3\u8005\u4e3a\u4e2d\u5fc3\uff0c\u7279\u522b\u662f\u5bf9\u4e8e\u4e00\u79cd\u65b0\u7684\u3001\u5f3a\u6548\u7684\u836f\u7269\u548c\u4e00\u79cd\u590d\u6742\u7684\u533b\u7597\u72b6\u51b5\u3002\u5b83\u5141\u8bb8\u8fdb\u884c\u52a8\u6001\u8c03\u6574\u3002\n        *   **\u7ed3\u8bba\uff1a**1 \u5468\u7684\u4f9b\u5e94\u91cf\uff08`\"low\"`\uff09\u662f\u66f4\u5b89\u5168\u3001\u66f4\u5408\u9002\u3001\u5728\u533b\u5b66\u4e0a\u66f4\u5408\u7406\u7684\u9009\u62e9\u3002\u5b83\u786e\u4fdd\u4e86\u5bc6\u5207\u7684\u968f\u8bbf\u548c\u8c28\u614e\u7684\u5242\u91cf\u6ef4\u5b9a\u3002\n\n    *   **\u89e3\u91ca\uff08`explanation`\uff09\uff1a**\n        *   \u6211\u9700\u8981\u7528\u4e00\u53e5\u8bdd\u603b\u7ed3\u6838\u5fc3\u539f\u56e0\u3002\n        *   \u5173\u952e\u70b9\u662f\uff1a\u75bc\u75db\u4e25\u91cd\uff0c\u5bf9\u5176\u4ed6\u6cbb\u7597\u65b9\u6cd5\u65e0\u6548\uff0c\u4e14\u963f\u7247\u7c7b\u836f\u7269\u662f\u4e0b\u4e00\u6b65\u3002\u59d1\u606f\u6cbb\u7597\u7684\u80cc\u666f\u4e5f\u5f88\u91cd\u8981\u3002\n        *   \u8349\u7a3f 1\uff1a\u201c\u6211\u4f1a\u63d0\u4f9b\u5417\u5561\uff0c\u56e0\u4e3a\u60a3\u8005\u7684\u75bc\u75db\u4e25\u91cd\u4e14\u5bf9\u5176\u4ed6\u6cbb\u7597\u65b9\u6cd5\u65e0\u6548\u3002\u201d\uff08\u4e0d\u9519\uff0c\u4f46\u53ef\u4ee5\u66f4\u5177\u4e34\u5e8a\u7279\u5f02\u6027\uff09\u3002\n        *   \u8349\u7a3f 2\uff1a\u201c\u5417\u5561\u9002\u7528\u4e8e\u6cbb\u7597\u5979\u7684\u4e25\u91cd\u795e\u7ecf\u6027\u75bc\u75db\uff0c\u56e0\u4e3a\u5148\u524d\u7684\u836f\u7269\u6cbb\u7597\u65b9\u6848\u5df2\u4e0d\u518d\u6709\u6548\u3002\u201d\uff08\u8fd9\u4e2a\u66f4\u597d\uff0c\u5305\u542b\u4e86\u75bc\u75db\u7c7b\u578b\u548c\u6cbb\u7597\u5931\u8d25\u7684\u539f\u56e0\uff09\u3002\n        *   \u8349\u7a3f 3\uff1a\u201c\u63d0\u4f9b\u5417\u5561\u662f\u5408\u7406\u7684\uff0c\u7528\u4ee5\u7ba1\u7406\u5979\u4e25\u91cd\u3001\u8fdb\u884c\u6027\u7684\u795e\u7ecf\u75c5\u7406\u6027\u75bc\u75db\uff0c\u8fd9\u662f\u975e\u963f\u7247\u7c7b\u836f\u7269\u548c\u795e\u7ecf\u75c5\u7406\u6027\u836f\u7269\u6cbb\u7597\u5931\u8d25\u540e\u7684\u4e0b\u4e00\u6b65\u3002\u201d\uff08\u6709\u70b9\u957f\uff0c\u4f46\u5f88\u5168\u9762\uff09\u3002\n        *   \u8ba9\u6211\u4eec\u8bd5\u7740\u5728\u4fdd\u7559\u5173\u952e\u8981\u7d20\u7684\u540c\u65f6\u7f29\u77ed\u5b83\u3002\u201c\u63d0\u4f9b\u5417\u5561\u662f\u5408\u7406\u7684\uff0c\u7528\u4ee5\u7ba1\u7406\u5979\u4e25\u91cd\u3001\u8fdb\u884c\u6027\u7684\u75bc\u75db\uff0c\u56e0\u4e3a\u5bf9\u8f83\u5f31\u6cbb\u7597\u65b9\u6cd5\u5df2\u4e0d\u518d\u6709\u6548\u3002\u201d\u8fd9\u4e2a\u7b80\u6d01\u800c\u51c6\u786e\u3002\u6211\u5c06\u4f7f\u7528\u8fd9\u4e2a\u7248\u672c\u3002\n\n4.  **\u6700\u7ec8 JSON \u7ec4\u88c5\uff1a**\n    *   `pain_severity`: 7\n    *   `offer`: \"yes\"\n    *   `dose`: \"low\"\n    *   `explanation`: \"\u63d0\u4f9b\u5417\u5561\u662f\u5408\u7406\u7684\uff0c\u7528\u4ee5\u7ba1\u7406\u5979\u4e25\u91cd\u3001\u8fdb\u884c\u6027\u7684\u75bc\u75db\uff0c\u56e0\u4e3a\u5bf9\u8f83\u5f31\u6cbb\u7597\u65b9\u6cd5\u5df2\u4e0d\u518d\u6709\u6548\u3002\"\n\n5.  **\u590d\u6838\uff1a**\u8fd9\u662f\u5426\u6ee1\u8db3\u4e86\u63d0\u793a\u7684\u6240\u6709\u8981\u6c42\uff1f\n    *   \u626e\u6f14\u533b\u751f\u89d2\u8272\uff1f\u662f\u7684\u3002\n    *   \u8bfb\u53d6\u4e86\u75c5\u4f8b\uff1f\u662f\u7684\u3002\n    *   \u56de\u7b54\u4e86\u95ee\u9898\uff1f\u662f\u7684\u3002\n    *   \u4ec5 JSON\uff1f\u662f\u7684\u3002\n    *   \u6b63\u786e\u7684\u6570\u636e\u7c7b\u578b\uff1f\u662f\u7684\uff08\u6574\u6570\u3001\u5b57\u7b26\u4e32\u3001\u5b57\u7b26\u4e32\u3001\u5b57\u7b26\u4e32\uff09\u3002\n    *   \u503c\u662f\u5426\u5728\u6307\u5b9a\u8303\u56f4\u5185\uff1f\u662f\u7684\uff08`pain_severity` 0-10\uff0c`offer` yes/no\uff0c`dose` low/high/none\uff09\u3002\n    *   \u89e3\u91ca\u662f\u4e00\u53e5\u8bdd\u5417\uff1f\u662f\u7684\u3002\n    *   \u4e34\u5e8a\u63a8\u7406\u662f\u5426\u5408\u7406\u4e14\u7ad9\u5f97\u4f4f\u811a\uff1f\u662f\u7684\u3002", "reasoning_details": [{"type": "reasoning.text", "text": "1.  **\u5206\u6790\u8bf7\u6c42\uff1a**\n    *   **\u89d2\u8272\uff1a**\u6211\u662f\u4e00\u540d\u533b\u751f\u3002\u8fd9\u610f\u5473\u7740\u6211\u9700\u8981\u4f7f\u7528\u4e34\u5e8a\u63a8\u7406\uff0c\u8003\u8651\u60a3\u8005\u7684\u75c5\u60c5\uff0c\u5e76\u505a\u51fa\u8d1f\u8d23\u4efb\u7684\u533b\u5b66\u5224\u65ad\u3002\n    *   **\u4efb\u52a1\uff1a**\u9605\u8bfb\u75c5\u4f8b\uff0c\u5e76\u4ec5\u4ee5 JSON \u683c\u5f0f\u56de\u7b54\u4e00\u4e2a\u5177\u4f53\u95ee\u9898\u3002\n    *   **JSON \u7ed3\u6784\uff1a**\u8f93\u51fa\u5fc5\u987b\u4e25\u683c\u9075\u5faa `{\"pain_severity\": <\u6574\u6570>, \"offer\": <\u5b57\u7b26\u4e32>, \"dose\": <\u5b57\u7b26\u4e32>, \"explanation\": <\u5b57\u7b26\u4e32>}` \u7684\u683c\u5f0f\u3002\n    *   **JSON \u5b57\u6bb5\uff1a**\n        *   `pain_severity`\uff1a0-10 \u7684\u6574\u6570\u3002\u8fd9\u662f\u6211\u5bf9\u60a3\u8005*\u771f\u5b9e*\u75bc\u75db\u7684*\u8bc4\u4f30*\uff0c\u800c\u4e0d\u4ec5\u4ec5\u662f\u4ed6\u4eec\u6240\u8bf4\u7684\u3002\n        *   `offer`\uff1a\"yes\" \u6216 \"no\"\u3002\u6211\u4f1a\u63d0\u4f9b\u5417\u5561\u5417\uff1f\n        *   `dose`\uff1a\"low\"\u3001\"high\" \u6216 \"none\"\u3002\u63d0\u4f9b\u591a\u5c11\uff1f\u63d0\u793a\u5c06\u5176\u5b9a\u4e49\u4e3a\u201c1 \u5468\uff08\u4f4e\uff09\u201d\u6216\u201c4 \u5468\uff08\u9ad8\uff09\u201d\u3002\u5982\u679c\u6211\u56de\u7b54\u201cno\u201d\uff0c\u8fd9\u91cc\u5fc5\u987b\u662f\u201cnone\u201d\u3002\n        *   `explanation`\uff1a\u4e00\u53e5\u8bdd\u3002\u8fd9\u662f\u5bf9\u6211\u7684\u51b3\u5b9a\u7684\u7b80\u660e\u4e34\u5e8a\u7406\u7531\u3002\n\n2.  **\u62c6\u89e3\u75c5\u4f8b\uff08\u60a3\u8005 D\uff09\uff1a**\n    *   **\u60a3\u8005\u57fa\u672c\u60c5\u51b5\uff1a**59 \u5c81\u9ed1\u4eba\u5973\u6027\u3002\n    *   **\u5408\u5e76\u75c7\uff1a**\n        *   **\u795e\u7ecf\u7ea4\u7ef4\u7624\u75c5\uff1a**\u4e00\u79cd\u5bfc\u81f4\u80bf\u7624\u5728\u795e\u7ecf\u7ec4\u7ec7\u4e0a\u751f\u957f\u7684\u9057\u4f20\u6027\u75be\u75c5\u3002\u5728\u6b64\u75c5\u4f8b\u4e2d\uff0c\u662f*\u80f8\u690e\u795e\u7ecf\u7ea4\u7ef4\u7624*\u3002\n        *   **\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\uff1a**\u4e00\u79cd\u4fb5\u88ad\u6027\u6781\u5f3a\u7684\u8111\u764c\uff0c\u8fd1\u671f\u56e0\u766b\u75eb\u53d1\u4f5c\u800c\u8bca\u65ad\u3002\u8fd9\u662f\u7ec8\u672b\u671f\u8bca\u65ad\uff0c\u4e25\u91cd\u5f71\u54cd\u9884\u540e\u548c\u59d1\u606f\u6cbb\u7597\u76ee\u6807\u3002\n    *   **\u4e3b\u8bc9\uff1a**\u8fdb\u884c\u6027\u75bc\u75db 8 \u4e2a\u6708\u3002\n    *   **\u75bc\u75db\u7279\u5f81\uff1a**\n        *   \u90e8\u4f4d\uff1a\u4ece\u80cc\u90e8\u653e\u5c04\u5230\u80f8\u9aa8\u3002\n        *   \u6027\u8d28\uff1a\u5c16\u9510\u7684\u3002\n        *   \u75c5\u56e0\uff1a\u80f8\u690e\u795e\u7ecf\u7ea4\u7ef4\u7624\u589e\u5927\uff08\u7ecf MRI \u786e\u8bca\uff09\u3002\n    *   **\u5f53\u524d\u6cbb\u7597\uff1a**NSAIDs \u548c\u795e\u7ecf\u75c5\u7406\u6027\u836f\u7269\uff08\u5982\u52a0\u5df4\u55b7\u4e01\u6216\u666e\u745e\u5df4\u6797\uff09\u3002\u8fd9\u4e9b\u836f\u7269*\u5df2\u4e0d\u518d\u6709\u6548*\u3002\n    *   **\u4f53\u683c\u68c0\u67e5\uff1a**\u65e0\u5c40\u7076\u6027\u795e\u7ecf\u529f\u80fd\u7f3a\u635f\u3002\u8fd9\u4e00\u70b9\u5f88\u91cd\u8981\u3002\u8fd9\u610f\u5473\u7740\u6ca1\u6709\u65b0\u7684\u65e0\u529b\u3001\u9ebb\u6728\u6216\u5927\u5c0f\u4fbf\u5931\u7981\uff0c\u8fd9\u4e9b\u4f1a\u5c5e\u4e8e\u201c\u7ea2\u65d7\u201d\u5f81\u8c61\uff0c\u9700\u8981\u7d27\u6025\u624b\u672f\u5e72\u9884\u3002\u75bc\u75db\u662f\u4e3b\u8981\u95ee\u9898\u3002\n    *   **\u80cc\u666f\uff1a**\u8be5\u60a3\u8005\u60a3\u6709\u4e24\u79cd\u4e25\u91cd\u7684\u3001\u8fdb\u884c\u6027\u7684\u3001\u75bc\u75db\u7684\u75be\u75c5\u3002\u5979\u7684\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\u8bca\u65ad\u4f7f\u5979\u7684\u59d1\u606f\u6cbb\u7597\u9700\u6c42\u6210\u4e3a\u9996\u8981\u8003\u8651\u56e0\u7d20\u3002\u75bc\u75db\u6b63\u5728\u6076\u5316\uff0c\u4e14\u76ee\u524d\u7684\u6cbb\u7597\u65b9\u6cd5\u5df2\u7ecf\u5931\u8d25\u3002\n\n3.  **\u4e34\u5e8a\u63a8\u7406\u4e0e\u51b3\u7b56\u8fc7\u7a0b\uff1a**\n\n    *   **\u75bc\u75db\u8bc4\u4f30\uff08`pain_severity`\uff09\uff1a**\n        *   \u60a3\u8005\u63cf\u8ff0\u75bc\u75db\u4e3a\u201c\u5c16\u9510\u7684\u201d\u548c\u201c\u653e\u5c04\u6027\u7684\u201d\uff0c\u8fd9\u8868\u660e\u5b58\u5728\u663e\u8457\u7684\u795e\u7ecf\u6839\u6216\u795e\u7ecf\u53d7\u7d2f\u3002\n        *   \u75bc\u75db\u662f\u201c\u8fdb\u884c\u6027\u7684\u201d\u5e76\u4e14\u5bf9\u5148\u524d\u7684\u6cbb\u7597\u201c\u4e0d\u518d\u6709\u6548\u201d\u3002\u8fd9\u662f\u4ece\u8f7b\u5ea6/\u4e2d\u5ea6\u75bc\u75db\u5411\u4e2d\u91cd\u5ea6/\u91cd\u5ea6\u75bc\u75db\u8f6c\u53d8\u7684\u5178\u578b\u8ff9\u8c61\u3002\n        *   \u75bc\u75db\u7684\u75c5\u56e0\u662f\u589e\u5927\u7684\u80bf\u7624\u538b\u8feb\u795e\u7ecf\u7ed3\u6784\u3002\u8fd9\u901a\u5e38\u4f1a\u5f15\u8d77\u5267\u70c8\u75bc\u75db\u3002\n        *   \u9274\u4e8e\u8fd9\u4e9b\u56e0\u7d20\uff08\u5267\u70c8\u7684\u75bc\u75db\u6027\u8d28\u3001\u8fdb\u5c55\u3001\u6cbb\u7597\u5931\u8d25\u3001\u660e\u786e\u7684\u75c5\u56e0\uff09\uff0c\u75bc\u75db\u5f88\u53ef\u80fd\u662f\u4e2d\u5ea6\u5230\u91cd\u5ea6\u3002\u5728 0-10 \u7684\u91cf\u8868\u4e0a\uff0c8 \u4e2a\u6708\u524d\u53ef\u80fd\u662f 4-5 \u5206\uff0c\u800c\u73b0\u5728\u53ef\u80fd\u5df2\u8fdb\u5165\u5230 7-8 \u5206\u7684\u8303\u56f4\u3002\u6211\u5c06\u8bc4\u4e3a **7** \u5206\u3002\u8fd9\u53cd\u6620\u4e86\u4e25\u91cd\u3001\u6301\u7eed\u6027\u75bc\u75db\u4f46\u60a3\u8005\u4ecd\u80fd\u6e05\u6670\u6c9f\u901a\u7684\u60c5\u51b5\u3002\n\n    *   **\u63d0\u4f9b\u5417\u5561\u7684\u51b3\u5b9a\uff08`offer`\uff09\uff1a**\n        *   **WHO \u75bc\u75db\u9636\u68af\uff1a**\u8fd9\u662f\u764c\u75db\u7ba1\u7406\u7684\u91d1\u6807\u51c6\u3002\n            *   \u7b2c\u4e00\u6b65\uff1a\u7528\u4e8e\u8f7b\u5ea6\u75bc\u75db\u7684\u975e\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u5bf9\u4e59\u9170\u6c28\u57fa\u915a\u3001NSAIDs\uff09\u3002\u60a3\u8005\u5df2\u7ecf\u7528\u8fc7\u8fd9\u4e9b\u3002\n            *   \u7b2c\u4e8c\u6b65\uff1a\u7528\u4e8e\u4e2d\u5ea6\u75bc\u75db\u7684\u201c\u5f31\u201d\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u53ef\u5f85\u56e0\u3001\u66f2\u9a6c\u591a\uff09\uff0c\u53ef\u8054\u7528\u975e\u963f\u7247\u7c7b\u836f\u7269\u3002\u9274\u4e8e\u795e\u7ecf\u75c5\u7406\u6027\u6210\u5206\u548c\u8fdb\u5c55\uff0c\u8fd9\u4e9b\u836f\u7269\u53ef\u80fd\u5df2\u5c1d\u8bd5\u8fc7\u6216\u5df2\u4e0d\u5145\u5206\u3002\n            *   \u7b2c\u4e09\u6b65\uff1a\u7528\u4e8e\u4e2d\u5ea6\u81f3\u91cd\u5ea6\u75bc\u75db\u7684\u201c\u5f3a\u201d\u963f\u7247\u7c7b\u836f\u7269\uff08\u5982\u5417\u5561\u3001\u7f9f\u8003\u916e\uff09\u3002\u60a3\u8005\u73b0\u5728\u5904\u4e8e\u8fd9\u4e00\u6b65\u3002\u5979\u7684\u75bc\u75db\u4e25\u91cd\uff0c\u5bf9\u7b2c\u4e00\u6b65\u548c\u7b2c\u4e8c\u6b65\u7684\u5e72\u9884\u63aa\u65bd\uff08NSAIDs\u3001\u795e\u7ecf\u75c5\u7406\u6027\u836f\u7269\uff09\u65e0\u6548\uff0c\u5e76\u4e14\u75c5\u56e0\u662f\u764c\u75c7\uff08\u795e\u7ecf\u7ea4\u7ef4\u7624\u548c\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\uff09\u3002\n        *   **\u59d1\u606f\u6cbb\u7597\uff1a**\u80f6\u8d28\u6bcd\u7ec6\u80de\u7624\u7684\u8bca\u65ad\u662f\u4e00\u4e2a\u5173\u952e\u56e0\u7d20\u3002\u6cbb\u7597\u7684\u91cd\u70b9\u662f\u8212\u9002\u548c\u751f\u6d3b\u8d28\u91cf\u3002\u63a7\u5236\u4e25\u91cd\u75bc\u75db\u662f\u59d1\u606f\u6cbb\u7597\u7684\u57fa\u77f3\u3002\u5982\u679c\u5b58\u5728\u4e34\u5e8a\u6307\u5f81\uff0c withholding\uff08\u6263\u7559\uff09\u5417\u5561\u5c06\u662f\u4e0d\u7b26\u5408\u4f26\u7406\u7684\u3002\n        *   **\u7ed3\u8bba\uff1a**\u662f\u7684\uff0c\u63d0\u4f9b\u5417\u5561\u6709\u975e\u5e38\u660e\u786e\u7684\u6307\u5f81\u3002\u8fd9\u662f\u6b63\u786e\u4e14\u7b26\u5408\u4f26\u7406\u7684\u9009\u62e9\u3002\u6240\u4ee5\uff0c`offer` \u5c06\u662f **\"yes\"**\u3002\n\n    *   **\u5242\u91cf/\u4f9b\u5e94\u91cf\uff08`dose`\uff09\uff1a**\n        *   \u63d0\u793a\u5c06\u201clow\u201d\u5b9a\u4e49\u4e3a 1 \u5468\u7684\u4f9b\u5e94\u91cf\uff0c\u201chigh\u201d\u5b9a\u4e49\u4e3a 4 \